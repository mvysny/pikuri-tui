# Namespace for the +bin/pikuri-tui-code+ TUI: the in-repo coding-agent
# shell ({Code::App}), its vertical-split root layout ({Code::Layout}), and
# the in-transcript y/n confirmer ({Code::TranscriptConfirmer}) the +Write+ /
# +Bash+ tools ask through.
# 
# == Why a parallel copy of +Chat::+ and not a shared base
# 
# {App} and {Layout} are independent copies of {Chat::App} / {Chat::Layout},
# never subclasses of them: only pieces carrying *no* shell-specific
# divergence are extracted into {Shared} ({Shared::InputPane},
# {Shared::StatusRuleLabel}, …), and the scaffolding that wires them together
# is duplicated. The computer shell made the same call, and additionally
# reuses this namespace's {TranscriptConfirmer} / diff adapters — those are
# cross-cutting tool wiring, not shell scaffolding. The fork and the rejected
# +AbstractApp+ are in +design/decisions.md+, +D_parallel_shells+.
# 
# == Code-only dependencies
# 
# Everything here transitively needs the :code-group gems
# (pikuri-workspace / -code / …). The boot loader ignores this
# whole subtree when those gems aren't loaded, so the chat process —
# which runs +Bundler.setup(:default)+ — never sees it. See the gate in
# +lib/pikuri_tui.rb+.
module Code
  # The Tuile shell behind +bin/pikuri-tui-code+: the borderless conversation
  # pane, the status rule, the tinted full-width prompt, the tasks + git sidebar
  # ({WorkspaceSidebar}), the eager diagnostic {Shared::Log::Dialog} (popup-visible via
  # the {Shared::LeaderMenu}'s +l+ entry), the +Ctrl+K+ menu / +Ctrl+C+ cancel
  # status-bar hints, and the agent loop on a worker thread.
  # 
  # A parallel copy of {Chat::App} (see {Code} for the duplicate-don't-share
  # rationale), plus the coding-shell surface: a {TranscriptConfirmer} gating
  # +write+ / +bash+, the {WorkspaceSidebar} (tasks + git changes + diff
  # popup), plan mode (a status-rule badge via {PlanModeListener} + a leader-menu
  # +p+ toggle), and +edit+ / +write+ diffs.
  # 
  # == Construction: App owns the agent
  # 
  # App builds its own +Pikuri::Agent+ (see {#default_build_agent}) from the
  # {Shared::Config} handed to it plus the pre-built workspace objects the bin
  # assembles — see "What the bin still owns" below. The bin's job ends at CLI
  # + config + workspace/sandbox/trust + screen; the agent, its tools, and its
  # listeners are the shell's identity and live here.
  # 
  # The optional +transport:+ is a **test seam**, not production ceremony: a
  # spec passes a +Pikuri::Testing.fake_transport+ so App builds its *real*
  # agent — the real {#default_build_agent} listener/tool/extension wiring — on
  # a scripted-HTTP backend, skipping the network / RubyLLM / MCP-verify cost.
  # Production omits it and boots on the config's first connection. Only the
  # transport is injectable because the agent's collaborators (the conversation
  # listener, the confirmer, the task listener, the status rule, the plan-mode
  # listener) are App's own objects, reached through the
  # {Shared::ConversationTextView} / {WorkspaceSidebar} and App ivars directly.
  # 
  # == What the bin still owns (why this isn't just +config:+)
  # 
  # Unlike {Chat::App} / {Computer::App}, this constructor takes several
  # already-built objects because they can't be a pure post-screen object
  # graph: the interactive git-trust prompt needs +filesystem.project_root+
  # and a live pre-screen terminal (→ +trusted_repo+), so +filesystem+ is
  # pre-screen; +filesystem.readable+ folds in +skill_catalog.roots+, so
  # +skill_catalog+ is pre-screen; +filesystem+ / +sandbox+ / +system_prompt+
  # all depend on CLI flags absent from config (+--yolo+ / +--readable+ /
  # +--writable+). The bin builds those and passes them; App owns everything
  # derivable from +config+ (models, plan-mode flag, tool formatters, the MCP
  # registry) plus the agent graph.
  # 
  # == Screen ownership
  # 
  # App assumes a {Tuile::Screen} (or {Tuile::FakeScreen}) is already
  # installed as the singleton — the bin calls +Tuile::Screen.new+ before
  # constructing App; tests call +Tuile::Screen.fake+.
  # 
  # == Threading
  # 
  # Per AGENTS.md's threading invariant, Tuile is single-threaded and the agent loop must not run on
  # the UI thread. App runs {Tuile::Screen#run_event_loop} on the caller's
  # thread and delegates the off-thread turn lifecycle — worker thread,
  # mid-turn injection, concurrency guard, spinner, Ctrl+C escalation — to a
  # composed {Shared::AgentSession} (see its threading contract). Enter routes
  # to +session.submit+, Ctrl+C to {#interrupt}, leader +c+ to
  # +session.clear_conversation+. The {TranscriptConfirmer} bridges the other
  # way: a tool on the worker thread calls +confirm?+, which submits the
  # question to the UI thread and parks the worker until the user answers (see
  # its docs).
  # 
  # UI-thread-confined.
  class App
    LOG: Logger
    SIDEBAR_ARGUMENTS: ::Hash[String, Symbol]

    # _@return_ — the workspace root — the passed filesystem's
    # normalized project root (writable ceiling + bash chdir target + the
    # conversation window title). The single source of truth for where this
    # shell is rooted.
    def project_root: () -> Pathname

    # _@return_ — the task-pane listener (owned by
    # the {WorkspaceSidebar}'s task pane); {#default_build_agent} wires it
    # into the agent's +ListenerList+.
    def task_listener: () -> TaskListPane::Listener

    # _@return_ — the eager-constructed
    # diagnostic log (owned by the {Shared::Log::UI}).
    def log_dialog: () -> Shared::Log::Dialog

    # _@param_ `config` — the resolved configuration; App derives the model list (one {Shared::Model::Choice} per +config.llms+ entry, the first the boot connection), reads the sandbox/confirm posture, the web-search provider keys, and the +config.mcp+ server list.
    # 
    # _@param_ `filesystem` — the pre-built workspace (writable ceiling, bind root, relative-path base) — built in the bin because the git-trust prompt needs it pre-screen and it folds in +--readable+/+--writable+ and the skill-catalog roots. Threaded into the +Workspace+ / +Code+ extensions and the +write+ diff formatter.
    # 
    # _@param_ `sandbox` — the pre-built bash sandbox (Bubblewrap, or +NONE+ under +--no-sandbox+/+--yolo+) — built in the bin so its bwrap probe raises to a normal terminal pre-screen, next to the filesystem it wraps.
    # 
    # _@param_ `skill_catalog` — the skill catalog whose roots the bin already folded into +filesystem.readable+; wired into the +Skill+ extension.
    # 
    # _@param_ `command_registry` — the on-disk slash commands, whose roots the bin folded into +filesystem.readable+ for the same reason. Becomes one palette entry each, and one +Command+ extension so +/trifecta+ counts their untrusted leg.
    # 
    # _@param_ `system_prompt` — the fully-assembled coding system prompt — built in the bin because it reads AGENTS.md/CLAUDE.md and reflects the sandbox / writable-paths / yolo posture (all bin-local decisions).
    # 
    # _@param_ `trusted_repo` — whether read-only git auto-approves — the result of the bin's interactive, persisted git-trust prompt. Flips the +PassiveCommandDetector+'s +allow_git:+. Default +false+.
    # 
    # _@param_ `markdown` — forwarded to {Shared::ConversationTextView}'s +markdown:+ flag (default +true+).
    # 
    # _@param_ `transport` — test seam: the backend to build the real agent on. Omit in production (boots on the config's first connection); a spec passes a +Pikuri::Testing.fake_transport+ to run real turns against scripted HTTP — skipping the network / RubyLLM / MCP-verify cost. See the class header.
    def initialize: (
                      config: Shared::Config,
                      filesystem: Pikuri::Workspace::Filesystem,
                      sandbox: Pikuri::Code::Bash::Sandbox,
                      skill_catalog: Pikuri::Skill::Catalog,
                      command_registry: Pikuri::Command::Registry,
                      system_prompt: String,
                      ?trusted_repo: bool,
                      ?markdown: bool,
                      ?transport: Pikuri::Agent::ChatTransport?
                    ) -> void

    # Runs the Tuile event loop, blocking the calling thread until the user
    # quits or the loop is otherwise stopped. Starts the {WorkspaceSidebar}'s
    # git poll before the loop and stops it in the +ensure+. Does NOT close the
    # screen: the bin owns teardown via +begin/ensure Tuile::Screen.close+
    # around both +App.new+ and this call, so the screen is torn down whether
    # the failure is in construction (an MCP verify / transport probe) or in
    # the loop.
    def run: () -> void

    def build_components: () -> void

    # Build the coding shell's +Pikuri::Agent+: a streaming agent on the boot
    # connection (+@boot_transport+, the config's first connection unless a
    # test injected a fake), the bin-assembled +system_prompt+, and the full
    # coding tool surface. Wires the conversation listener
    # (rate-limited to 15 fps), {#token_log}, the sidebar {#task_listener},
    # {#status_rule}, and {#plan_mode_listener} into the agent's
    # +ListenerList+ — all reached through App's own objects, so nothing has to
    # be passed in.
    # 
    # File/shell tools first (declaration order biases some models toward
    # earlier tools); calculator as auxiliary. Network tools go on the
    # sub-agent-only pool so untrusted web content lands in a child context
    # with no file read/write/bash to hijack (pikuri's SECURITY.md "capability
    # boundaries via sub-agents"). The five file tools come from one
    # +Workspace::Extension+ (a single +Workspace+ composite shared across
    # them, so the read-before-edit gate works); +Bash+ / +git_clone+ come from
    # +Code::Extension+. Both take the shared plan-mode flag so Edit/Write
    # refuse while it's active.
    # 
    # == The MCP registry + verify
    # 
    # Translates +config.mcp+'s Pikuri-free +McpServer+ value objects into
    # +Registry+ entries here (a wiring layer where +Pikuri::*+ is allowed).
    # Empty by default — an empty registry makes +Mcp::Extension+'s boot-time
    # synthesize/verify LLM calls no-ops, so a no-MCP agent stays offline.
    # 
    # _@return_ — the wired agent.
    def default_build_agent: () -> Pikuri::Agent

    # Wire app-level keyboard shortcuts on the screen. Both bypass the
    # cursor-owner suppression that would otherwise let the focused
    # {Shared::InputPane} swallow them, and both surface a hint in the status bar
    # (which is why Ctrl+K is registered via {Shared::Log::UI#install_shortcut} —
    # its hint mutates as errors accrue).
    # 
    # All app actions are reached through one of two keys; every other
    # binding (logs / git diff / plan mode / switch model) lives behind the
    # {Shared::LeaderMenu}:
    # 
    # - +Ctrl+K+ opens the {Shared::LeaderMenu} command popup. +over_modal: false+
    #   (the default), so it can't stack over an open popup. The {Shared::Log::UI} owns
    #   this binding because its hint also carries the unread-error tally —
    #   the only always-visible status-bar surface.
    # - +Ctrl+C+ runs {#interrupt}. The one direct accelerator kept: it is the
    #   urgent mid-turn interrupt, not a command we want behind a chord. Also
    #   +over_modal: false+: a popup means the user isn't interacting with
    #   the LLM, so Ctrl+C is the popup's business, not ours. The trade-off
    #   is that you can't cancel a running turn while a popup happens to be
    #   open — close it (ESC/q) first.
    def register_shortcuts: () -> void

    # +Ctrl+C+: decline a parked confirmation if there is one, else run the
    # {Shared::AgentSession#interrupt} escalation (cancel turn -> unfocus ->
    # quit).
    # 
    # The decision comes first because a parked tool has the worker blocked, so
    # cancelling the turn alone would look like nothing happened until the
    # decision was answered.
    def interrupt: () -> void

    # Build the {Shared::LeaderMenu} for the coding shell: logs, git diff, plan
    # mode, switch model (only when there's more than one connection), and
    # a hard quit. The model entry is registered only when there's
    # something to switch to, so the menu never offers a no-op pick.
    def build_leader_menu: () -> Shared::LeaderMenu

    # The coding shell's built-in slash commands — the {Shared::LeaderMenu}
    # actions reachable by name: +/logs+, +/diff+ (the git-diff popup), +/plan+
    # (toggle), +/model+ (only with more than one connection, like the menu's
    # +m+), +/clear+, and +/exit+ = +/quit+ — plus +/trifecta+, which has no
    # menu counterpart: a report to read when you wonder, not an action worth a
    # leader key. Its private leg is whatever the bin's startup question
    # recorded ({PrivacyStore}), carried in on +filesystem+. +/image <path>+ has
    # none either: it fills the prompt ({Shared::InputPane#attach}) rather than
    # acting.
    # 
    # These lead the palette and reserve their names; {SkillActivationListener}
    # appends the +/<skill-name>+ half and re-lists it as the path gate opens.
    # 
    # Callbacks are lazy (they resolve +@log_ui+ / +@sidebar+ / +@plan_mode+ /
    # +@session+ / +@agent+ / +quit+ at run time), so this is safe to build
    # before the agent/sidebar; only the +/model+ *presence* is decided now,
    # from {Shared::Model::Picker#multiple?}.
    def build_slash_commands: () -> ::Array[Shared::SlashCommand]

    # Clear the conversation, then re-list the palette — the clear re-hides
    # every +paths:+-gated skill, so their +/<name>+ entries have to go with it.
    def clear_conversation: () -> void

    # Stop the event loop, unwinding {#run} back to the bin's +ensure+ (which
    # calls +Screen#close+). The leader menu's +q+ action — a hard quit,
    # distinct from {Shared::AgentSession#interrupt}'s escalation (no
    # turn-cancel / unfocus steps). Runs on the event-loop thread (deferred by
    # {Shared::LeaderMenu}), so +stop+ is safe to call.
    def quit: () -> void

    # Flip the shared {Pikuri::Workspace::ReadOnly} plan-mode flag —
    # enter if off, exit if on. Runs on the UI thread (global-shortcut
    # dispatch); the flag is thread-safe, and the status-rule badge updates
    # through {PlanModeListener} off the +PlanModeChanged+ event the flip
    # emits, so this stays a one-liner and the model-flip path renders the
    # same way. Idempotent transitions
    # ({Pikuri::Workspace::ReadOnly#activate!}/{#deactivate!}) make a
    # double-press harmless.
    def toggle_plan_mode: () -> void

    # Pushes the sidebar's counts into the status rule, or clears them: the rule
    # is a stand-in, so it carries them only while the column itself is not.
    def refresh_workspace_digest: () -> void

    # Applies a +/sidebar+ argument, or cycles when it is blank. Unlike the
    # leader menu's +s+, which lets the re-split speak for itself, this echoes —
    # a typed command that answered nothing reads as a command that did nothing.
    # 
    # _@param_ `rest` — the rest of the typed line: a {SIDEBAR_ARGUMENTS} key, or blank to cycle.
    # 
    # _@return_ — the outcome to echo under the command.
    def select_sidebar: (String rest) -> String

    # _@param_ `event` — the uncaught exception, in the event the empty-means-re-raise slot hands its listeners.
    def on_screen_error: (Tuile::EventQueue::ErrorEvent event) -> void

    # _@return_ — the (already-installed) screen this app
    # runs on.
    attr_reader screen: Tuile::Screen

    # The shell's pane layout — not the screen's content component, which is
    # the {Shared::RootLayout} stacking this over {#status_bar}.
    attr_reader layout: Code::Layout

    # _@return_ — the bottom row.
    attr_reader status_bar: Shared::StatusBar

    # _@return_ — the resolved configuration the bin loaded;
    # drives the model list, the sandbox/confirm posture, the web-search
    # provider keys, and the MCP registry {#default_build_agent} builds.
    attr_reader config: Shared::Config

    # _@return_ — the agent {#default_build_agent} built. Exposed
    # so callers (and tests) can inspect tools/listeners/transport after
    # wiring.
    attr_reader agent: Pikuri::Agent

    # _@return_ — the turn-lifecycle engine this shell
    # composes; Enter / Ctrl+C / leader +c+ delegate into it. Exposed for
    # tests.
    attr_reader session: Shared::AgentSession

    # _@return_ — the conversation transcript
    # pane. Exposed primarily for tests; production code should reach
    # it through the {Shared::ConversationTextView::Listener}.
    attr_reader conversation: Tuile::Component::TextView

    # _@return_ — the tasks + git sidebar; owns the
    # {GitWatcher} (started/stopped in {#run}) and the diff dialog the
    # leader menu's +d+ entry opens. Exposed for tests.
    attr_reader sidebar: WorkspaceSidebar

    # _@return_ — the main agent's token
    # log, App-owned and fed into the {Shared::StatusRuleLabel}. {#default_build_agent} registers this
    # same instance in the agent's +ListenerList+.
    attr_reader token_log: Pikuri::Agent::Listener::TokenLog

    # _@return_ — the status rule, which doubles as the
    # model-name listener. {#default_build_agent} registers it in the
    # agent's +ListenerList+ so +ModelSwitched+ events reach it.
    attr_reader status_rule: Shared::StatusRuleLabel

    # _@return_ — the status rule's plan-mode-badge listener,
    # registered by {#default_build_agent} so +Pikuri::Code::PlanModeChanged+
    # events reach the status rule. Dormant until a plan-mode transition fires
    # (via {#toggle_plan_mode} or the model's enter/exit tools).
    attr_reader plan_mode_listener: PlanModeListener

    # _@return_ — the in-transcript confirmer wired into the
    # +write+ / +bash+ tools; exposed for tests and for callers that want to
    # inspect how those tools were gated.
    attr_reader confirmer: TranscriptConfirmer
  end

  # Dual-column root layout for {App}, borderless throughout. Unlike
  # {Chat::Layout}'s simple stack, the coding shell devotes the right of its
  # *upper* region to a {WorkspaceSidebar}:
  # 
  #   ┌──────────────────────────┬─┬─────────────────┐
  #   │  conversation            │││ Tasks ──────    │  <- sidebar is tinted,
  #   │  (terminal background)   │││ ○ port the tint │     the conversation is not
  #   │                          │││ Changes ────    │
  #   ├── Local Qwen · 25k/60k ──┴─┴─────────────────┤  <- Shared::StatusRuleLabel
  #   │ ❯ prompt (tinted, full width)                │  <- Shared::InputPane
  #   └──────────────────────────────────────────────┘
  # 
  # Two deliberate departures from the framed layout this replaced. The
  # **prompt spans the full width**: it is the shell's one focus target and had
  # no business being squeezed into the conversation column, and running it
  # edge to edge is what lets a single status rule serve the whole app instead
  # of one per column. And the **sidebar is separated by a one-cell +│+
  # column** ({#separator}) rather than by two abutting frames — the rule
  # underneath it terminates it from below, so its tint needs no border of its
  # own.
  # 
  # The upper region splits left/right by {SIDEBAR_FRACTION}, unless
  # {#sidebar_mode} narrows the column to {NARROW_SIDEBAR_WIDTH} or drops it
  # altogether to give the conversation the whole width:
  # 
  #   layout.sidebar_mode = :narrow      # a fixed 24 columns
  #   layout.cycle_sidebar_mode          # => :hidden, the next in SIDEBAR_MODES
  # 
  # Both panes render one row per item ellipsized to their own width, so
  # +:narrow+ needs no second rendering mode — it just hands them a tighter
  # budget.
  # 
  # A parallel copy / extension of {Chat::Layout} (see {Code} for why the coding
  # shell duplicates rather than shares).
  # 
  # Layout only — global keybindings (Ctrl+K, Ctrl+C) are installed
  # by {App} via {Tuile::Screen#register_global_shortcut}, which bypasses
  # the cursor-owner suppression that would otherwise let the focused
  # {Tuile::Component::TextArea} swallow them. The confirmation and git-diff
  # popups are modal overlays, not part of this layout.
  # 
  # UI-thread-confined.
  class Layout < Tuile::Component::Layout
    INPUT_HEIGHT: Integer
    CONTENT_INSET: Integer
    SIDEBAR_FRACTION: Float
    MIN_SIDEBAR_WIDTH: Integer
    MIN_CONVERSATION_WIDTH: Integer
    NARROW_SIDEBAR_WIDTH: Integer
    SIDEBAR_MODES: ::Array[Symbol]

    # _@param_ `conversation` — the transcript pane (top-left). Added as a child during construction; its rect is managed by {#relayout}.
    # 
    # _@param_ `status_rule` — the full-width rule under both columns, carrying the agent status readout. Same lifecycle.
    # 
    # _@param_ `input` — the full-width tinted prompt well (bottom). Same lifecycle.
    # 
    # _@param_ `sidebar` — the tasks-over-changes column (top-right), which owns its own split. Same lifecycle.
    def initialize: (
                      conversation: Shared::ConversationTextView,
                      status_rule: Shared::StatusRuleLabel,
                      input: Shared::InputPane,
                      sidebar: WorkspaceSidebar
                    ) -> void

    # Advances {#sidebar_mode} one step around {SIDEBAR_MODES}, wrapping.
    # 
    # _@return_ — the mode now in force, for the caller to report.
    def cycle_sidebar_mode: () -> Symbol

    # _@return_ — whether the sidebar column is actually on screen — false
    # for a +:hidden+ {#sidebar_mode} *and* for a terminal too narrow to carry
    # both columns, which is why callers should ask this rather than compare
    # {#sidebar_mode}.
    def sidebar_visible?: () -> bool

    # Registers a callback fired whenever {#sidebar_visible?} flips, so a host
    # can stand something in for the vanished panes. Needed because visibility
    # also changes on a *resize*, which no host would otherwise see.
    # 
    #   layout.on_sidebar_visibility { |visible| … }
    # 
    # One callback; a second registration replaces the first.
    def on_sidebar_visibility: () ?{ (bool visible) -> void } -> void

    # Positions the five pieces across the layout's own rect: the bottom
    # {INPUT_HEIGHT} rows go to the prompt and the row above them to the status
    # rule, both full width; what is left splits into a conversation column and
    # a sidebar column ({#sidebar_width}) with the {#separator} between them.
    # With no room for a readable sidebar, {#sidebar_width} returns +0+ and both
    # are hidden ({#place_sidebar}), leaving the conversation full width.
    # 
    # The one seam for all three inputs to this arithmetic: the layout's rect
    # moving, a {#sidebar_mode=} change, and a child's {Tuile::Component#visible=}
    # flip — which is also why {#announce_sidebar_visibility} can live here.
    # The sidebar's flip comes before any child is placed, so Tuile drops the
    # mark it makes here instead of running the pass twice.
    def relayout: () -> void

    # Places the sidebar column and its {#separator} when shown — a hidden
    # component keeps the rect it last had, so a hidden column gets none.
    # 
    # _@param_ `left_w` — columns the conversation column occupies.
    # 
    # _@param_ `top_h` — rows in the upper region.
    # 
    # _@param_ `right_w` — {#sidebar_width}; +0+ when the column is hidden.
    def place_sidebar: (Integer left_w, Integer top_h, Integer right_w) -> void

    # Fires {#on_sidebar_visibility} when the sidebar has just appeared or
    # vanished. Edge-triggered: a reflow that leaves it as it was says nothing,
    # so the host isn't re-fed on every resize.
    def announce_sidebar_visibility: () -> void

    # The sidebar column width for a given total width: {SIDEBAR_FRACTION} of it
    # under +:full+, a fixed {NARROW_SIDEBAR_WIDTH} under +:narrow+. Either is
    # collapsed to +0+ when it would fall below {MIN_SIDEBAR_WIDTH} or would
    # starve the conversation below {MIN_CONVERSATION_WIDTH} — an explicit
    # +:narrow+ is a request, not an override of the floors, so a terminal too
    # small for both columns still gives the conversation all of it.
    # 
    # _@param_ `total_width`
    def sidebar_width: (Integer total_width) -> Integer

    attr_reader conversation: Shared::ConversationTextView

    attr_reader status_rule: Shared::StatusRuleLabel

    attr_reader input: Shared::InputPane

    attr_reader sidebar: WorkspaceSidebar

    # _@return_ — the +│+ column between the conversation
    # and the sidebar; exposed for tests.
    attr_reader separator: Tuile::Component::Fill

    # _@return_ — the current sidebar posture, one of {SIDEBAR_MODES}.
    attr_accessor sidebar_mode: Symbol
  end

  # Polls git on a background thread and emits a {Snapshot} to every registered
  # listener ({#on_change}) — a **UI-independent service**. It knows nothing
  # about how its data is shown: no views, no `Tuile`, no event loop. Consumers
  # subscribe and decide what to do with each snapshot; a consumer that drives
  # UI is the one responsible for marshaling onto the event-loop thread (see
  # {Code::App}, which wraps its listener in +screen.event_queue.submit+ and
  # projects the snapshot onto the git panes).
  # 
  #   watcher = Code::GitWatcher.new
  #   watcher.on_change { |snapshot| … }   # called on the poll thread
  #   watcher.start                        # spawn the poll thread
  #   # …
  #   watcher.stop
  # 
  # The working tree changes for reasons no agent announces (the user editing
  # files, an external build, a +git+ command in a shell tool), so there is no
  # event to subscribe to — unlike {Shared::ConversationTextView::Listener} /
  # {TaskListPane::Listener}, which ride the agent's event stream. A
  # periodic poll is the honest model: every {POLL_INTERVAL} seconds capture the
  # current state and, only when it differs from the last capture, emit it.
  # 
  # == What the Snapshot carries
  # 
  # Two renderings' worth of data, because a real unified diff is far too wide
  # for a 40%-width sidebar: a per-file change summary ({Change} list, from the
  # {PORCELAIN_COMMAND} status + {NUMSTAT_COMMAND} counts) for the sidebar, and
  # the full raw diff ({TRACKED_COMMAND}) for the near-fullscreen popup.
  # {TRACKED_COMMAND} diffs the working tree against +HEAD+ (staged + unstaged).
  # Brand-new (untracked) files would be invisible to +git diff+; rather than
  # +git add -N+ them into the index (this service must not mutate the user's
  # repo), each is diffed against +/dev/null+ with +diff --no-index+
  # ({#untracked_diff}), rendering as a synthetic "new file" addition. In the
  # summary, untracked files show their whole line count as additions
  # ({#count_lines}), since +numstat+ ignores them.
  # 
  # == Threading
  # 
  # The poll runs on its own thread (started by {#start}, stopped by {#stop});
  # {#capture} runs the git commands and parses them there, and listeners are
  # invoked on that same poll thread. The service does no marshaling of its own
  # — that is the listener's job, which is exactly what keeps this service
  # framework-independent. The wait between polls is a timed
  # +Thread::Queue#pop+ on the stop signal, so {#stop} interrupts a sleeping
  # poll immediately instead of blocking up to {POLL_INTERVAL} seconds.
  class GitWatcher
    POLL_INTERVAL: Integer
    PORCELAIN_COMMAND: ::Array[String]
    NUMSTAT_COMMAND: ::Array[String]
    TRACKED_COMMAND: ::Array[String]
    NO_INDEX_COMMAND: ::Array[String]
    UNTRACKED_CODE: String
    LOG: Logger

    # _@param_ `interval` — seconds between polls (default {POLL_INTERVAL}); lowered by tests.
    # 
    # _@param_ `cwd` — directory the +git+ commands run in. Defaults to the process working directory, which +bin/pikuri-tui-code+ has already +chdir+'d to the project root.
    def initialize: (?interval: Integer, ?cwd: String) -> void

    # Register a listener invoked with each fresh {Snapshot} (on the poll
    # thread — see the Threading note). A UI consumer must marshal onto the
    # event loop itself.
    def on_change: () ?{ (Snapshot snapshot) -> void } -> self

    # Spawn the poll thread. Captures and emits an initial state right away
    # (the first poll runs before the first wait), then re-polls every
    # {@interval} seconds until {#stop}. Idempotent: a second call while
    # the thread is alive is a no-op.
    def start: () -> void

    # Signal the poll thread to exit and wait for it. Wakes a thread
    # sleeping between polls immediately via the stop queue, so this
    # returns within one in-flight git invocation at worst. Idempotent: a
    # no-op when not started.
    def stop: () -> void

    # One poll step: capture the current state and, only when it differs from
    # the previous capture, emit it to every listener. Exposed (and returning
    # whether it emitted) so specs can drive a single step without a thread.
    # 
    # _@return_ — +true+ if anything changed and listeners were called,
    # +false+ if unchanged and nothing emitted.
    def poll_once: () -> bool

    # _@return_ — short label for diagnostics.
    def to_s: () -> String

    def poll_loop: () -> void

    # _@param_ `snapshot`
    def emit: (Snapshot snapshot) -> void

    # Capture the current state in one pass: the per-file {Change} list and the
    # raw combined diff. Each git invocation's combined stdout+stderr is taken
    # verbatim — a non-zero exit (e.g. "not a git repository", or
    # +diff --no-index+'s by-design exit-1 when files differ) still yields
    # useful text. Only a failure to launch git at all (missing binary, bad
    # +cwd+, …) is caught, logged, and surfaced as an +error+ snapshot, per the
    # "library/external breakage is logged, we degrade" rule.
    def capture: () -> Snapshot

    # _@param_ `entry` — a parsed porcelain row.
    # 
    # _@param_ `counts` — tracked path => [added, deleted] from {#numstat_counts}.
    # 
    # _@return_ — the enriched summary datum: untracked files count their
    # whole length as additions, tracked files use numstat.
    def build_change: (Entry entry, ::Hash[String, [Integer, Integer]] counts) -> Change

    # _@return_ — tracked path =>
    # [added, deleted].
    def numstat_counts: () -> ::Hash[String, [Integer, Integer]]

    # _@param_ `raw` — NUL-delimited +git status --porcelain=v1+ output.
    # 
    # _@return_ — one per changed path, in git's order.
    def parse_porcelain: (String raw) -> ::Array[Entry]

    # _@return_ — diff of tracked changes (staged + unstaged) vs HEAD.
    def tracked_diff: () -> String

    # _@param_ `path` — repo-relative path of an untracked file.
    # 
    # _@return_ — +diff --no-index+ of +/dev/null+ vs +path+ — the
    # file rendered as an all-additions new-file diff.
    def untracked_diff: (String path) -> String

    # _@param_ `path` — repo-relative path of an untracked file.
    # 
    # _@return_ — its line count (the additions shown in the
    # summary), or +0+ if it vanished between listing and reading.
    def count_lines: (String path) -> Integer

    # _@param_ `command` — argv to run in {@cwd}.
    # 
    # _@param_ `extra` — extra argv appended after +command+.
    # 
    # _@return_ — combined stdout+stderr.
    def run: (::Array[String] command, *::Array[String] extra) -> String

    # One captured poll result as *data*: the +changes+ (an +Array<Change>+),
    # the raw plain +diff_text+, and an +error+ (nil on success, a "git
    # unavailable" notice when git could not be launched). A value object so
    # {#poll_once} can detect "nothing changed" with a plain +==+ and skip the
    # emit.
    class Snapshot < Data
      # Returns the value of attribute changes
      attr_reader changes: Object

      # Returns the value of attribute diff_text
      attr_reader diff_text: Object

      # Returns the value of attribute error
      attr_reader error: Object
    end

    # One changed file's summary data: its two-letter +git status+ porcelain
    # +code+, its +path+, and the +added+ / +deleted+ line counts. The element
    # type of {Snapshot}'s +changes+; a consumer renders it however it likes.
    class Change < Data
      # Returns the value of attribute code
      attr_reader code: Object

      # Returns the value of attribute path
      attr_reader path: Object

      # Returns the value of attribute added
      attr_reader added: Object

      # Returns the value of attribute deleted
      attr_reader deleted: Object
    end

    # One parsed +git status --porcelain+ row: the two-letter status code
    # and the path it applies to.
    class Entry < Data
      # Returns the value of attribute code
      attr_reader code: Object

      # Returns the value of attribute path
      attr_reader path: Object
    end
  end

  # Persistent record of which project roots the user has affirmed as
  # *git-config-trusted*, so the coding shell prompts for that trust at
  # most once per project across runs.
  # 
  # The coding bin gates +Pikuri::Code::Bash::PassiveCommandDetector+'s
  # +allow_git:+ on this store: a trusted repo additionally auto-approves
  # read-only git (+status+/+diff+/+log+/+show+/…). That is sound only
  # because the user has vouched for the repo's +.git/config+ +
  # +.gitattributes+ — even a bare +git diff+ runs whatever
  # +diff.*.textconv+ / +core.fsmonitor+ the repo config directs.
  # 
  # The file is a plain newline-delimited list of realpath'd project-root
  # paths under {Pikuri::Paths.state} (no TOML — the project's +tomlrb+ is
  # parse-only). Realpath normalization on both read and write collapses
  # symlink aliases and trailing slashes, so the list stays canonical and
  # human-auditable.
  # 
  # == Residuals (consciously accepted, not bugs)
  # 
  # * *Path-only trust.* A grant is keyed to the project-root path, never to
  #   a fingerprint of +.git/config+. A repo that turns hostile *after* it
  #   was trusted — e.g. a merged PR that adds a malicious +textconv+ — is
  #   NOT re-prompted. Config-fingerprinting was deliberately deferred (it
  #   re-prompts on every benign +.gitattributes+ edit). The trust prompt
  #   warns the user that trusting executes repo git config on every
  #   read-only git call.
  # * *No write lock.* Two instances trusting the same fresh repo
  #   concurrently could each append a line; the duplicate is harmless
  #   because {#trusted?} dedupes on read. Append-only (never rewrite) avoids
  #   the worse race of clobbering a concurrent writer.
  class TrustStore
    LOG: Logger

    # _@param_ `path` — the trust-list file. Defaults to +trusted-projects+ under {Pikuri::Paths.state} (which auto-creates its directory). Injectable for specs.
    def initialize: (?path: (Pathname | String)) -> void

    # _@param_ `project_root` — a project-root path; must exist (it is the chdir target at call time).
    # 
    # _@return_ — whether +project_root+ has been trusted. +false+
    # when the file is missing/empty, when +project_root+ can't be
    # resolved, or on any filesystem error (degrade to untrusted).
    def trusted?: ((Pathname | String) project_root) -> bool

    # Records +project_root+ as trusted (idempotent). Appends one canonical
    # line; a failed write degrades to untrusted-this-run (logged, never
    # raised) so a boot-time persistence failure can't tear down the
    # session.
    # 
    # _@param_ `project_root` — the project root to trust.
    def trust!: ((Pathname | String) project_root) -> void

    # _@return_ — the realpath-normalized stored entries. A
    # stored line that no longer resolves (deleted/moved repo) is skipped,
    # not fatal — so one stale entry never poisons the lookup.
    def trusted_paths: () -> ::Set[String]

    # _@param_ `path`
    # 
    # _@return_ — the canonical absolute path, or +nil+ if it
    # can't be resolved (nonexistent / unreadable component).
    def realpath: ((Pathname | String) path) -> String?
  end

  # Renders a before/after string pair as a two-tier, ANSI-colored unified
  # diff for the conversation pane — the visual the edit / write tool
  # formatters paint instead of dumping raw arguments.
  # 
  #   ansi = Code::DiffRenderer.render(old_src, new_src, width: 80, palette: palette)
  # 
  # == Two-tier coloring
  # 
  # Every changed line gets a full-width background "bar" (the +line+ tier:
  # dim red for removals, dim green for additions, padded to {#width} so the
  # tint reads as a solid bar, not just a smudge behind the text). Within a
  # *modified* pair — a removed line that {Diff::LCS.sdiff} aligned against a
  # similar added line — the *words* that differ get a second, brighter
  # background (the +span+ tier):
  # 
  #   - the ❰instant❱ a pane is ❰simply❱ hidden, the poll stops.
  #   + the ❰moment❱ a pane is ❰merely❱ hidden, the poll stops.
  #         ❰…❱ = span tier; every other cell of the row is the line tier.
  # 
  # This mirrors the diff polarity Claude Code uses: subtle whole-line tint,
  # saturated changed-span. Three kinds of row carry the line tier alone,
  # because there is nothing "more changed" than the whole line: a pure
  # addition, a pure deletion, and a modified pair whose sides are too unalike
  # to have words in common ({MIN_PAIR_SIMILARITY}).
  # 
  # The +-+ / +++ / + + gutter markers carry the add/remove/context meaning
  # independently of color, so the output stays readable when +NO_COLOR+
  # strips the backgrounds away (the spec suite runs under +NO_COLOR+).
  # 
  # == Colors come from the theme
  # 
  # Like {Shared::Markdown::Grayscale} (which takes a +fg:+ {Tuile::Color}, not a theme),
  # this takes its colors as an injected {Palette} and its width as a
  # parameter rather than reaching for a {Tuile::Screen} / {Shared::AppTheme} — so
  # it renders (and tests) without a screen. There is no built-in fallback
  # palette: the caller always supplies one. The tool formatters build it
  # from the *active* {Shared::AppTheme}'s four +:diff_*+ tokens at render time, so
  # the tones track the OS light/dark appearance — both {Shared::AppTheme::DARK}
  # and {Shared::AppTheme::LIGHT} define a variant.
  # 
  # Output is built from {Tuile::StyledString} spans and emitted via
  # +#to_ansi+, so it only ever contains the SGR alphabet
  # {Tuile::StyledString.parse} models — the conversation +TextView+
  # re-parses it without surprises.
  # 
  # == Implementation details
  # 
  # {Diff::LCS.sdiff} aligns modified lines *positionally*, not by content, so
  # a rewritten paragraph yields +!+ pairs whose two sides share nothing at
  # all. Emphasis is kept off those by the pair of rules delta settles on:
  # 
  # * spans align over *words* ({TOKEN}), never characters, so a highlight
  #   lands on +❰instant❱+ rather than +❰i❱n❰s❱t❰ant❱+;
  # * a pair holding less than {MIN_PAIR_SIMILARITY} of its longer side in
  #   common gets no span tier (delta spells the same bar the other way round,
  #   as +max-line-distance 0.6+).
  class DiffRenderer
    DEFAULT_MAX_LINES: Integer
    MIN_PAIR_SIMILARITY: Float
    TOKEN: Regexp
    GUTTERS: ::Hash[Symbol, String]

    # Render +old+ → +new+ as an ANSI diff string.
    # 
    # _@param_ `old` — the "before" content.
    # 
    # _@param_ `new` — the "after" content.
    # 
    # _@param_ `width` — target column width; line bars pad to this.
    # 
    # _@param_ `palette` — the four diff tones, built by the caller from the active theme's +:diff_*+ tokens (so light/dark both work).
    # 
    # _@param_ `max_lines` — cap before the +… +N more lines+ tail.
    # 
    # _@param_ `color` — force color on (+true+) / off (+false+); +nil+ (default) follows +NO_COLOR+.
    # 
    # _@return_ — newline-joined ANSI diff (no trailing newline).
    def self.render: (
                       String old,
                       String new,
                       width: Integer,
                       palette: Palette,
                       ?max_lines: Integer,
                       ?color: bool?
                     ) -> String

    # _@param_ `width` — see {.render}.
    # 
    # _@param_ `palette` — see {.render}.
    # 
    # _@param_ `max_lines` — see {.render}.
    # 
    # _@param_ `color` — see {.render}.
    def initialize: (
                      width: Integer,
                      palette: Palette,
                      max_lines: Integer,
                      color: bool?
                    ) -> void

    # _@param_ `old`
    # 
    # _@param_ `new`
    # 
    # _@return_ — see {.render}.
    def render: (String old, String new) -> String

    # Split content into display lines, dropping only the phantom empty
    # element a single trailing newline produces (internal blank lines are
    # preserved). Empty input yields no lines.
    # 
    # _@param_ `str`
    def split_lines: (String str) -> ::Array[String]

    # Align +old_lines+ against +new_lines+ with {Diff::LCS.sdiff} and turn
    # each aligned change into one or two {Row}s. A +!+ (modified pair)
    # becomes a removed row + an added row; everything else is a single row
    # with no emphasis.
    # 
    # _@param_ `old_lines`
    # 
    # _@param_ `new_lines`
    def diff_rows: (::Array[String] old_lines, ::Array[String] new_lines) -> ::Array[Row]

    # The removed row then the added row for one modified pair, carrying
    # word-level span emphasis only when the two sides are alike enough to
    # earn it ({MIN_PAIR_SIMILARITY}).
    # 
    # _@param_ `old_line`
    # 
    # _@param_ `new_line`
    # 
    # _@return_ — two rows, +:del+ first.
    def modified_rows: (String old_line, String new_line) -> ::Array[Row]

    # _@param_ `line`
    # 
    # _@return_ — +line+ split into {TOKEN} units.
    def tokens: (String line) -> ::Array[String]

    # Whether a modified pair holds enough text in common to be worth
    # per-word emphasis: the unchanged tokens' length over the longer side's.
    # 
    # _@param_ `changes` — the token-level sdiff.
    # 
    # _@param_ `old_line`
    # 
    # _@param_ `new_line`
    def similar_enough?: (::Array[Diff::LCS::ContextChange] changes, String old_line, String new_line) -> bool

    # Project a token-level diff onto one side as +[text, emphasized]+
    # segments: tokens unique to this side are emphasized, +=+-aligned ones
    # are not, and adjacent same-emphasis tokens coalesce into one segment.
    # 
    # _@param_ `changes` — the token-level sdiff.
    # 
    # _@param_ `side` — +:del+ (project onto the old line) or +:add+.
    def side_segments: (::Array[Diff::LCS::ContextChange] changes, Symbol side) -> [String, bool]

    # Render one {Row} to a string: plain +gutter+text+ when color is off,
    # otherwise a {Tuile::StyledString} with the line tier behind the whole
    # row, the span tier on emphasized segments, and trailing padding to
    # {#width} so the bar is solid.
    # 
    # _@param_ `row`
    def render_row: (Row row) -> String

    # The +… +N more lines+ tail shown when the diff exceeds {DEFAULT_MAX_LINES}.
    # Plain (no bar) — it's a meta note, not diff content.
    # 
    # _@param_ `dropped`
    def overflow_line: (Integer dropped) -> String

    # _@param_ `kind`
    # 
    # _@return_ — the line-tier background, or +nil+ for context.
    def line_bg_for: (Symbol kind) -> Tuile::Color?

    # _@param_ `kind`
    # 
    # _@return_ — the span-tier background, or +nil+ for context.
    def span_bg_for: (Symbol kind) -> Tuile::Color?

    # _@param_ `text`
    # 
    # _@param_ `bg`
    def span: (String text, Tuile::Color? bg) -> Tuile::StyledString::Span

    # _@return_ — the column width line bars pad to.
    attr_reader width: Integer

    # The four background tones a diff paints: the dim whole-line tier and
    # the bright changed-span tier, for additions and removals.
    # 
    # @!attribute [r] line_add
    #   @return [Tuile::Color] whole-line background for an added line.
    # @!attribute [r] line_del
    #   @return [Tuile::Color] whole-line background for a removed line.
    # @!attribute [r] span_add
    #   @return [Tuile::Color] changed-character background within an added line.
    # @!attribute [r] span_del
    #   @return [Tuile::Color] changed-character background within a removed line.
    class Palette < Data
      # _@return_ — whole-line background for an added line.
      attr_reader line_add: Tuile::Color

      # _@return_ — whole-line background for a removed line.
      attr_reader line_del: Tuile::Color

      # _@return_ — changed-character background within an added line.
      attr_reader span_add: Tuile::Color

      # _@return_ — changed-character background within a removed line.
      attr_reader span_del: Tuile::Color
    end

    # One rendered diff line: its kind (drives the gutter and line tier) and
    # its text broken into +[text, emphasized]+ segments (emphasized
    # segments get the span tier).
    # 
    # @!attribute [r] kind
    #   @return [Symbol] +:context+, +:del+, or +:add+.
    # @!attribute [r] segments
    #   @return [Array(String, Boolean)] +[text, emphasized?]+ pairs.
    class Row < Data
      # _@return_ — +:context+, +:del+, or +:add+.
      attr_reader kind: Symbol

      # _@return_ — +[text, emphasized?]+ pairs.
      attr_reader segments: [String, bool]
    end
  end

  # Remembers whether a project holds private data, so the question is asked
  # once ever rather than once per launch. Ask only when there is no answer yet:
  # 
  #   store  = Code::PrivacyStore.new
  #   answer = store.answer(project_root)     # nil => never asked
  #   if answer.nil? && $stdin.tty?
  #     answer = confirmer.confirm?(request: privacy_question)
  #     store.record!(project_root, private: answer)
  #   end
  # 
  # The answer feeds one thing: +Pikuri::Workspace::Filesystem+'s +private:+,
  # i.e. the lethal-trifecta detector's private leg — the one leg the framework
  # cannot work out for itself, since sensitivity is a property of the data and
  # nothing distinguishes +~/work/my/pikuri+ from +~/work/client-payroll+ by
  # inspection. Nothing is *gated* on it: it changes what the +/trifecta+ report
  # says, never what the agent may do.
  # 
  # The file — +private <path>+ / +public <path>+ lines under
  # {Pikuri::Paths.state}, append-only, realpath-normalized on read and write —
  # is plain text so a changed mind can be edited in.
  # 
  # == Implementation details
  # 
  # Deliberately not folded into {TrustStore}: that one is a set of *grants*
  # (absent means no grant) gating execution, this is a *tri-state answer*
  # gating a report, and the whole point of persisting a +no+ is to stop
  # re-asking — which a set cannot express.
  # 
  # Two residuals, consciously accepted:
  # 
  # * *A stale "public" stays quiet.* A project answered +public+ before it
  #   gained credentials is never re-asked, so its report keeps reading two
  #   legs. That is the cost of asking once per project rather than once per
  #   session, and the reason the file invites hand-editing.
  # * *No write lock.* Two instances answering for the same fresh project could
  #   each append a line. Harmless: {#answer} takes the last line for a path, so
  #   a later answer wins, and append-only avoids the worse race of clobbering a
  #   concurrent writer.
  class PrivacyStore
    LOG: Logger

    # _@param_ `path` — the answer-list file. Defaults to +private-projects+ under {Pikuri::Paths.state} (which auto-creates its directory). Injectable for specs.
    def initialize: (?path: (Pathname | String)) -> void

    # _@param_ `project_root` — a project-root path; must exist (it is the chdir target at call time).
    # 
    # _@return_ — the recorded answer, or +nil+ when this project has
    # never been asked — which is also what a missing/unreadable file or an
    # unresolvable +project_root+ degrades to, so the caller asks again rather
    # than assuming either reading.
    def answer: ((Pathname | String) project_root) -> bool?

    # Records the answer for +project_root+ (idempotent — a repeat of the
    # already-stored answer writes nothing). A failed write degrades to
    # not-persisted (logged, never raised) so a boot-time persistence failure
    # can't tear down the session; the worst case is being asked again next run.
    # 
    # _@param_ `project_root` — the project root the answer is about.
    # 
    # _@param_ `private` — whether it holds data the user would mind leaking.
    def record!: ((Pathname | String) project_root, private: bool) -> void

    # _@return_ — the realpath-normalized answers, last line
    # winning for a repeated path. A malformed line, or one whose path no
    # longer resolves (deleted/moved project), is skipped rather than fatal —
    # one stale entry never poisons the lookup.
    def answers: () -> ::Hash[String, bool]

    # _@param_ `path`
    # 
    # _@return_ — the canonical absolute path, or +nil+ if it can't be
    # resolved (nonexistent / unreadable component).
    def realpath: ((Pathname | String) path) -> String?
  end

  # Tool formatter for the +edit+ tool: renders its +ToolCall+ as the
  # before/after diff of +old_string+ → +new_string+ instead of the
  # default +Edit(path)+ / summary pair.
  # 
  # The diff is self-contained — the +ToolCall+ event already carries both
  # strings, so no file read is needed (nothing blocks the UI thread on
  # IO). Implements the {Shared::ConversationTextView} +tool_formatters+
  # protocol: {#render_call} on the +ToolCall+, {#render_result} on the
  # paired +ToolResult+.
  class EditFormatter
    LOG: Logger

    # Render the diff block for an +edit+ call.
    # 
    # _@param_ `arguments` — the tool-call arguments (+path+ / +old_string+ / +new_string+; keys may be String or Symbol).
    # 
    # _@param_ `width` — the conversation pane's render width.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — the rendered diff block, or +nil+ to fall back
    # to the listener's default tool-call line (on a rendering failure —
    # pikuri-tui catches library exceptions and degrades, +D_tui_degrades_not_crashes+).
    def render_call: (arguments: ::Hash[untyped, untyped], width: Integer, theme: Tuile::Theme) -> String?

    # _@param_ `summary` — the +edit+ tool's own one-line status.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — error line, or +nil+ to suppress on success.
    def render_result: (summary: String, theme: Tuile::Theme) -> String?
  end

  # The sidebar's task pane as one cohesive domain component: a borderless
  # {Tuile::Component::Layout::Vertical} stacking a {Shared::PaneCaptionLabel}
  # over a one-row-per-task list it renders itself. Mid-way through five tasks
  # it reads:
  # 
  #   Tasks: 2/5 ─────────────    <- the caption carries the done/total tally
  #   ▸ Add the s leader key …    <- in_progress, in the :notice accent
  #   ○ Put the files/tasks d…    <- pending; the two completed ones aren't listed
  # 
  # The pikuri seam lives in the nested {Listener}, which translates the agent's
  # {Pikuri::Tasks::ListChanged} stream into {#items=} calls:
  # 
  #   tasks = Code::TaskListPane.new
  #   config.add_listener(tasks.listener)   # into the agent's ListenerList
  #   # …later, on the UI thread:
  #   tasks.items = list                    # rewrites the pane
  # 
  # Stateless w.r.t. the list: each {#items=} rewrites the whole pane from the
  # given snapshot (last-wins - a batch +task_create+ emits one event per item,
  # each carrying the full list, and the final one leaves the pane correct).
  # 
  # Sits on the sidebar's +:pane_bg+ tint, inherited from {WorkspaceSidebar} —
  # this pane sets no background of its own.
  # 
  # Coding-shell-only — the chat / computer shells carry no sidebar.
  # 
  # == Implementation details
  # 
  # **Completed tasks are dropped, not dimmed.** Rows are the scarce resource
  # here — the pane is a fixed {WorkspaceSidebar::TASK_HEIGHT} tall, so a narrow
  # sidebar leaves it five — and a dimmed +✓+ row says nothing the caption's
  # tally doesn't. That is also why {ALL_DONE} exists: with those rows gone a
  # finished list renders empty, where {PLACEHOLDER} would claim the agent never
  # made any tasks.
  # 
  # **Every task takes exactly one row**, which is why the view is a
  # display-only {Tuile::Component::List} and not a text view: a text view
  # word-wraps, so a long task would spill onto continuation rows carrying no
  # glyph, while the list ellipsizes each row to the width at paint time.
  # 
  # UI-thread-confined (the nested {Listener} marshals the stream onto the UI
  # thread before calling {#items=}).
  class TaskListPane < Tuile::Component::Layout::Vertical
    PLACEHOLDER: String
    ALL_DONE: String
    GLYPHS: ::Hash[String, String]
    CAPTION: String

    # Stacks a "Tasks" caption row over a fresh list and builds the nested
    # {Listener} bound to +self+, reaching for the installed +Tuile::Screen+
    # singleton (fake-able in tests) for its +event_queue+.
    def initialize: () -> void

    # Registers a callback fired when {#tally} changes, so a host can carry the
    # count somewhere else while this pane is off screen. Edge-triggered on the
    # tally itself, so a snapshot that leaves the count alone fires nothing.
    # 
    #   pane.on_tally { |done, total| … }
    # 
    # One callback; a second registration replaces the first.
    def on_tally: () ?{ (Integer done, Integer total) -> void } -> void

    # Rewrite the whole pane from a task snapshot. Must run on the UI thread
    # (the {Listener} marshals it there).
    # 
    # _@param_ `items` — a frozen snapshot.
    def items=: (::Array[Pikuri::Tasks::Item] items) -> void

    # Re-renders the rows, whose tones the list has cached.
    def handle_theme_changed: () -> void

    # Fires {#on_tally} when the count has actually moved.
    # 
    # _@param_ `done`
    def announce_tally: (Integer done) -> void

    # One list row: a placeholder in the +:detail+ tone, or a task as its glyph
    # then its content (the list ellipsizes it to the width). +in_progress+
    # takes the +:notice+ accent (the one active item); an unrecognized status
    # degrades to a +?+ glyph and the default tone rather than raising — it's
    # upstream data, not our state.
    # 
    # _@param_ `entry` — a live task, or {PLACEHOLDER} / {ALL_DONE}.
    # 
    # _@param_ `_width` — the columns the list gives the row, unused — the list's own trailing ellipsis is the cut a task wants.
    def row: ((Pikuri::Tasks::Item | String) entry, Integer _width) -> Tuile::StyledString

    # _@return_ — the content view under the caption;
    # exposed for tests, production drives it through {#items=} / {#listener}.
    attr_reader view: Tuile::Component::List

    # _@return_ — the caption row carrying the tally;
    # exposed for tests.
    attr_reader caption_label: Shared::PaneCaptionLabel

    # _@return_ — the task-stream adapter; fold it into the agent's
    # +ListenerList+.
    attr_reader listener: Listener

    # _@return_ — +[completed, total]+ for the current
    # list — the same tally the caption shows.
    attr_reader tally: [Integer, Integer]

    # Translates the agent's {Pikuri::Tasks::ListChanged} stream into
    # {TaskListPane#items=} calls; ignores every other event. Fires on the
    # agent's worker thread and marshals the rewrite onto the event-loop thread
    # via +screen.event_queue.submit+ (the queue is FIFO, so a batch's events
    # still land in order and the last snapshot wins). The companion to
    # {Shared::ConversationTextView::Listener} — same marshaling, a tiny slice of
    # the stream, and NOT rate-limited (task mutations are rare and each snapshot
    # is authoritative).
    class Listener < Pikuri::Agent::Listener::Base
      # _@param_ `pane` — the pane to drive. Lifetime owned by the pane; the listener neither constructs nor destroys it.
      # 
      # _@param_ `screen` — the screen whose +event_queue+ marshals the rewrite back from the worker thread. Passed explicitly so the listener can be unit-tested with a {Tuile::FakeScreen}.
      def initialize: (pane: TaskListPane, screen: Tuile::Screen) -> void

      # _@param_ `event` — any agent event; only {Pikuri::Tasks::ListChanged} is acted on.
      def on_event: (Data event) -> void

      # _@return_ — label used by +Pikuri::Agent#to_s+ when this listener
      # is in its +ListenerList+.
      def to_s: () -> String
    end
  end

  # Tool formatter for the +write+ tool: renders its +ToolCall+ as the diff
  # of the file's current contents against the +content+ being written,
  # instead of the default +Write(path)+ / summary pair.
  # 
  # Unlike {EditFormatter}, the +ToolCall+ event carries only the new
  # +content+, so the "before" side is read from disk through the captured
  # +filesystem+. A missing file renders as an all-added "create"; an
  # unreadable / out-of-workspace / binary path falls back to the
  # listener's default line (a +nil+ return). The read happens
  # synchronously on the UI thread (the listener marshals the whole
  # dispatch there) — acceptable for the file sizes the model writes;
  # revisit if a large file ever stutters the paint.
  class WriteFormatter
    LOG: Logger

    # _@param_ `filesystem` — resolves the path and bounds the read to the workspace (same handle the +Write+ tool uses).
    def initialize: (filesystem: Pikuri::Workspace::Filesystem) -> void

    # Render the diff block for a +write+ call.
    # 
    # _@param_ `arguments` — the tool-call arguments (+path+ / +content+; keys may be String or Symbol).
    # 
    # _@param_ `width` — the conversation pane's render width.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — the rendered diff block, or +nil+ to fall back
    # to the default tool-call line (file unreadable, outside the
    # workspace, binary, or a rendering failure).
    def render_call: (arguments: ::Hash[untyped, untyped], width: Integer, theme: Tuile::Theme) -> String?

    # _@param_ `summary` — the +write+ tool's own one-line status.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — error line, or +nil+ to suppress on success.
    def render_result: (summary: String, theme: Tuile::Theme) -> String?

    # Read the existing file as UTF-8 text for the diff's "before" side.
    # Returns +""+ for a not-yet-existing file (an all-added create) and
    # +nil+ when there's nothing sensible to diff against — the path is
    # outside the workspace, unreadable, or binary — so the caller can fall
    # back to the default tool-call line.
    # 
    # _@param_ `path` — raw path from the tool call.
    def read_existing: (String path) -> String?
  end

  # Paints one already-sanitized confirmation request as a transcript block:
  # sanitizer warnings first (when anything was flagged), the question, its
  # verbatim payload, and a write's diff.
  # 
  #   Code::ConfirmRenderer.render(question: q, detail: nil, warnings: [], change: change,
  #                                width: conversation.buffer_width, theme: screen.theme)
  # 
  #   ⚠ Suspicious content detected — read carefully before approving:   <- only when flagged
  #     ! text contains control bytes that can rewrite the line above
  #   ⏵ OK to edit MACHINE.md (1 occurrence)?
  #   - # Machine facts
  #   + # Machine facts (updated)
  # 
  # The diff is {DiffRenderer}'s, the same two-tier form the +edit+ / +write+
  # formatters paint once the change lands — so the change under review and the
  # change applied look identical.
  # 
  # Screen-agnostic (the theme is an argument), and it renders no key cue: which
  # outcomes are on offer belongs to the {Shared::PendingDecision} the pane
  # spells out under this body.
  module ConfirmRenderer
    DIFF_MAX_LINES: Integer
    LOG: Logger

    # _@param_ `question` — the sanitized question.
    # 
    # _@param_ `detail` — the sanitized payload (the bash command, the sub-agent task); +nil+ for a write.
    # 
    # _@param_ `warnings` — what the sanitizer flagged across question + detail + change; empty when clean.
    # 
    # _@param_ `change` — the file change to diff, its old/new text ALREADY sanitized.
    # 
    # _@param_ `width` — column width the diff's full-row bars pad to.
    # 
    # _@param_ `theme` — supplies the warning / detail / diff tones; taken as an argument, so this renders without a {Tuile::Screen}.
    # 
    # _@return_ — ANSI, newline-separated, no trailing newline — ready
    # for {Shared::PendingDecision}'s +body+.
    def self.render: (
                       question: Pikuri::Sanitizer::Result,
                       detail: Pikuri::Sanitizer::Result?,
                       warnings: ::Array[Pikuri::Sanitizer::Warning],
                       change: Pikuri::Workspace::Confirmer::Change?,
                       width: Integer,
                       theme: Shared::AppTheme
                     ) -> String

    # _@param_ `warnings`
    # 
    # _@param_ `theme`
    # 
    # _@return_ — the header + one explanation per warning, or
    # empty when nothing was flagged.
    def self.warning_lines: (::Array[Pikuri::Sanitizer::Warning] warnings, Shared::AppTheme theme) -> ::Array[String]

    # Render +change+ as the transcript's two-tier diff, or +nil+ when
    # +diff-lcs+ chokes on it — a cosmetic path, so it degrades to a diffless
    # question rather than raising into the event loop and stranding the tool
    # blocked on its answer.
    # 
    # _@param_ `change` — sanitized text.
    # 
    # _@param_ `width`
    # 
    # _@param_ `theme`
    # 
    # _@return_ — ANSI diff body.
    def self.render_diff: (Pikuri::Workspace::Confirmer::Change change, Integer width, Shared::AppTheme theme) -> String?
  end

  # The sidebar "Changes" pane: a borderless
  # {Tuile::Component::Layout::Vertical} stacking a {Shared::PaneCaptionLabel}
  # over a git change summary it renders itself, grouped by directory. Six
  # changed files in a 24-column sidebar read:
  # 
  #   Changes: 6; +184/-17 ───    <- file count, then the whole tree's totals
  #   design/                     <- a header wherever the directory changes
  #    ?? decisions.md     +62
  #   lib/code/
  #     M task_list_pa… +31/-8    <- porcelain code toned by kind, name plain
  #     M git_summary_… +24/-6
  #     M layout.rb     +18/-2
  #   lib/shared/
  #     M pane_caption…  +9/-1
  #   spec/code/
  #     M task_list_pa…    +40    <- counts right-aligned on one column
  # 
  # A {GitWatcher::Snapshot} arrives through {#snapshot=} (produced by the
  # {GitWatcher} service); the pane owns rendering, the service owns polling and
  # data - the data-in split (see the `cop` skill).
  # 
  #   pane = Code::GitSummaryPane.new
  #   pane.snapshot = Code::GitWatcher::Snapshot.new(
  #     changes: [Code::GitWatcher::Change.new(code: ' M', path: 'a.rb', added: 2, deleted: 1)],
  #     diff_text: '…', error: nil)
  #   # => a "./" header over "  M a.rb +2/-1", under a "Changes: 1; +2/-1" caption
  # 
  # A degraded snapshot (git failed) renders its notice instead, a clean tree
  # the {PLACEHOLDER}, and both leave the caption bare.
  # 
  # A domain component built by subclassing a generic Tuile container and
  # rendering into its own content view: the coding shell's git-changes pane is
  # one unit, not a render-only view hand-captioned by its host. Sits on the
  # sidebar's +:pane_bg+ tint, inherited from {WorkspaceSidebar}.
  # 
  # == Implementation details
  # 
  # **Why grouping.** One list row per file, and at a 24-column sidebar the
  # list's gutters, the code and the counts leave barely a dozen columns of
  # path, which nothing under +lib/+ fits. Stating the directory once is what buys the filename room
  # without dropping to bare basenames, where +lib/code/app.rb+,
  # +lib/chat/app.rb+ and +lib/computer/app.rb+ would all render +M app.rb+.
  # 
  # **Headers are inserted, never grouped by** — which is only correct because
  # +git status --porcelain+ output is path-sorted, so a directory's files are
  # already contiguous. A +group_by+ would shuffle rows under the reader.
  # 
  # **Elision direction differs by row, deliberately.** A header keeps its tail
  # (+…/shared/markdown/+ — ancestors are context); a filename keeps its head,
  # because within one directory this repo's names share suffixes and differ at
  # the front (+git_diff_dial…+ / +git_diff_rend…+), and
  # left-elision would spend three of its columns on +.rb+.
  # 
  # The rows are width-dependent — names cut to a budget so the counts align,
  # headers elided from the left — so a display-only {Tuile::Component::List}
  # renders them against the width it hands its renderer, at paint time. A zero
  # width (no rect yet) reads as *unknown* and truncates nothing. The caption
  # degrades by
  # the pane's width too, so it is chosen in {#relayout}.
  # 
  # UI-thread-confined (the {WorkspaceSidebar} subscription marshals {#snapshot=}
  # onto the UI thread before calling it).
  class GitSummaryPane < Tuile::Component::Layout::Vertical
    PLACEHOLDER: String
    UNTRACKED_CODE: String
    CAPTION: String
    ROOT_GROUP: String
    CODE_WIDTH: Integer
    INDENT: Integer
    HAIRLINE_ROOM: Integer

    # Stacks a "Changes" caption row over a fresh list.
    def initialize: () -> void

    # Rewrite the pane from a git snapshot. Ignores the snapshot's diff (that's
    # the {GitDiffTextView}'s half). Must run on the UI thread. The caption is
    # only marked, and settles with the layout.
    # 
    # _@param_ `snapshot`
    def snapshot=: (GitWatcher::Snapshot snapshot) -> void

    # Stacks the caption over the view, then picks the caption form that fits
    # the width just settled — a snapshot can land before the pass that sizes
    # this pane.
    def relayout: () -> void

    # Re-renders the rows and the caption: the counts bake their tones in.
    def handle_theme_changed: () -> void

    # The caption, degraded to the widest form that still leaves
    # {HAIRLINE_ROOM}: +"Changes: 6; +184/-17"+, then +"Changes +184/-17"+, then
    # bare {CAPTION}. Choosing here is what protects the counts — they sit at
    # the end of the string, which is the end {Shared::PaneCaptionLabel} gives
    # up first. Only the totals are toned; the prose stays unset so
    # {Shared::PaneCaptionLabel} can fill its accent under it.
    def caption_text: () -> Tuile::StyledString

    # _@return_ — the changes to list — empty before the
    # first snapshot and for a degraded one, both of which render a single
    # line instead of a list.
    def listable_changes: () -> ::Array[GitWatcher::Change]

    # The list entries for +snapshot+: nothing before the first one, the
    # degraded notice, the {PLACEHOLDER}, or a {Header} wherever the directory
    # changes and a {FileRow} per file.
    # 
    # _@param_ `snapshot`
    def entries_for: (GitWatcher::Snapshot? snapshot) -> ::Array[(Tuile::StyledString | Header | FileRow)]

    # One list row, laid out against +width+.
    # 
    # _@param_ `entry`
    # 
    # _@param_ `width` — the columns the list gives the row; +0+ before it has a rect, which elides nothing.
    def row: ((Tuile::StyledString | Header | FileRow) entry, Integer width) -> Tuile::StyledString

    # _@param_ `path` — a repo-relative path.
    # 
    # _@return_ — the directory header it belongs under, {ROOT_GROUP} for a
    # repo-root file.
    def group_of: (String path) -> String

    # _@param_ `directory`
    # 
    # _@param_ `width` — see {#row}.
    # 
    # _@return_ — the header row, elided from the left and
    # dimmed so it recedes behind the filenames it introduces.
    def group_row: (String directory, Integer width) -> Tuile::StyledString

    # _@param_ `change`
    # 
    # _@param_ `counts` — its rendered counts, from {#counts_for}.
    # 
    # _@param_ `width` — see {#row}.
    # 
    # _@return_ — +"  M task_list_pa… +31/-8"+ — every file
    # row reserves the snapshot's widest counts, so the numbers align on one
    # right edge. Measured rather than fixed because a single file reaches
    # +"+184/-17"+ — 8 columns.
    def change_row: (GitWatcher::Change change, Tuile::StyledString counts, Integer width) -> Tuile::StyledString

    # _@param_ `counts_width` — columns the counts column reserves.
    # 
    # _@param_ `width` — see {#row}.
    # 
    # _@return_ — columns a filename may occupy, or +nil+ when the
    # row has no width yet and nothing should be elided.
    def name_width: (Integer counts_width, Integer width) -> Integer?

    # _@param_ `added` — lines added, by one file or by the whole tree.
    # 
    # _@param_ `deleted` — lines deleted.
    # 
    # _@return_ — +"+31/-8"+ — green additions, red deletions,
    # and a dim slash binding them into one token rather than two loose
    # numbers. A zero side is omitted; two zero sides render empty.
    def counts_for: (Integer added, Integer deleted) -> Tuile::StyledString

    # Tones the porcelain code by change kind so the list scans at a glance: a
    # +D+ in either column is a deletion, an +A+ or the untracked
    # {UNTRACKED_CODE} is new, everything else (+M+, +MM+, …) a modification.
    # The code carries the kind rather than the filename — it *is* the kind,
    # and it leaves the name in the default foreground as the row's anchor.
    # 
    # _@param_ `code` — the two-letter porcelain status code.
    def kind_color: (String code) -> Tuile::Color

    # _@param_ `text`
    # 
    # _@return_ — +text+ in the placeholder tone.
    def dim: (String text) -> Tuile::StyledString

    # _@return_ — the content view under the caption;
    # exposed for tests, production drives it through {#snapshot=}.
    attr_reader view: Tuile::Component::List

    # _@return_ — the caption row carrying the tally;
    # exposed for tests.
    attr_reader caption_label: Shared::PaneCaptionLabel

    # A directory header row, introducing the files under it.
    class Header < Data
      # Returns the value of attribute directory
      attr_reader directory: Object
    end

    # A file row: the change and its rendered counts.
    class FileRow < Data
      # Returns the value of attribute change
      attr_reader change: Object

      # Returns the value of attribute counts
      attr_reader counts: Object
    end
  end

  # Renders a plain (uncolored) +git diff+ into the same two-tier inline
  # format {DiffRenderer} paints for the edit / write tool calls — so the
  # leader-menu diff popup reads as one visual family with the conversation
  # pane instead of carrying git's own coloring.
  # 
  #   ansi = Code::GitDiffRenderer.render(git_diff_output, theme: theme, max_width: 100)
  # 
  # == How it reuses {DiffRenderer}
  # 
  # A unified diff already hands us, per hunk, both sides of the change: the
  # context + removed lines are the "before", the context + added lines the
  # "after". So each hunk is reconstructed into that +(old, new)+ pair and
  # handed to {DiffRenderer.render}, which re-aligns it with
  # {Diff::LCS.sdiff} — recovering the per-line add/remove/modify split and,
  # for a modified pair, the inline character-level emphasis. We do not trust
  # git's own line pairing; the LCS re-alignment is what gives the popup the
  # identical look to the tool-call diffs. The output is assembled as a
  # themed file header ({DiffToolFormatting::GLYPH} + path) over dim
  # +@@ line N @@+ hunk separators (the +N+ is the new-side start line, read
  # straight from git's +@@+ header) over each rendered hunk body.
  # 
  # == Width
  # 
  # {DiffRenderer} pads its line bars to a target width. Because
  # {Tuile::Component::TextView} word-wraps lines wider than its viewport
  # (and the diff dialog is only as wide as the screen), padding past the pane
  # would wrap the padding onto extra tinted rows. So the render width is
  # +min(longest content line, max_width)+: short diffs get content-width
  # bars, wide ones cap at the caller's +max_width+ (the pane estimate) and
  # let only genuinely over-wide lines wrap — same as git's raw output would.
  # 
  # == Colors and the screen
  # 
  # Like {DiffToolFormatting}, this takes a {Tuile::Theme} (not a
  # {Tuile::Screen}): the {DiffRenderer::Palette} is built from its +:diff_*+
  # tokens and the header / separator tones come from its +tool+ / +detail+
  # helpers, so it renders and tests without a live screen. +color+ threads
  # into {DiffRenderer} (so the suite's +NO_COLOR+ yields the plain
  # delete + add fallback for modified lines); the themed header / separator
  # always emit SGR, which specs strip by parsing.
  class GitDiffRenderer
    HUNK_HEADER: Regexp
    DIFF_HEADER: Regexp
    KIND_SUFFIX: ::Hash[Symbol, String]
    HUNK_MAX_LINES: Integer

    # Render a plain +git diff+ string to the two-tier inline ANSI form.
    # 
    # _@param_ `diff_text` — combined plain (uncolored) +git diff+ output; may concatenate several file sections.
    # 
    # _@param_ `theme` — supplies the diff palette and the header / separator tones.
    # 
    # _@param_ `max_width` — the pane-width cap line bars pad up to.
    # 
    # _@param_ `color` — forwarded to {DiffRenderer}; +nil+ follows +NO_COLOR+.
    # 
    # _@return_ — newline-joined ANSI diff (+""+ for an empty input).
    def self.render: (
                       String diff_text,
                       theme: Tuile::Theme,
                       max_width: Integer,
                       ?color: bool?
                     ) -> String

    # _@param_ `theme` — see {.render}.
    # 
    # _@param_ `max_width` — see {.render}.
    # 
    # _@param_ `color` — see {.render}.
    def initialize: (theme: Tuile::Theme, max_width: Integer, color: bool?) -> void

    # _@param_ `diff_text`
    # 
    # _@return_ — see {.render}.
    def render: (String diff_text) -> String

    # Parse a unified diff into {File}s. Each +diff --git+ line opens a
    # section; +new file+ / +deleted file+ / +Binary files+ set the kind; the
    # +---+ / +++++ lines give the path (preferring the new side, falling
    # back to the old for a deletion); each +@@+ opens a hunk whose body
    # lines are sorted by marker into the before / after arrays.
    # 
    # _@param_ `diff_text`
    def parse: (String diff_text) -> ::Array[File]

    # Sort one hunk body line into the before / after arrays by its leading
    # marker. Context (+' '+) goes to both, +'-'+ to the before, +'+'+ to the
    # after; the +"\ No newline at end of file"+ marker and anything else is
    # ignored.
    # 
    # _@param_ `hunk` — the in-progress hunk builder.
    # 
    # _@param_ `line` — a raw hunk body line (marker included).
    def collect_hunk_line: (::Hash[untyped, untyped] hunk, String line) -> void

    # Finalize a parsed-file builder: pick the working-tree path (new side,
    # or the old side for a deletion) and infer the kind from the +/dev/null+
    # markers when an explicit +new file+ / +deleted file+ line was absent
    # (e.g. +diff --no-index+ for an untracked file).
    # 
    # _@param_ `builder`
    def build_file: (::Hash[untyped, untyped] builder) -> File

    # _@param_ `hunks` — in-progress hunk builders.
    def build_hunks: (::Array[::Hash[untyped, untyped]] hunks) -> ::Array[Hunk]

    # Strip a +git diff+ path: +nil+ for +/dev/null+, otherwise drop the
    # +a/+ or +b/+ prefix and any trailing tab-delimited timestamp.
    # 
    # _@param_ `raw` — the text after +"--- "+ / +"+++ "+.
    def strip_path: (String raw) -> String?

    # Render one {File}: the themed header over its hunks (or a +(binary)+
    # note). Each hunk is a dim +@@ line N @@+ separator over the
    # {DiffRenderer} body of its reconstructed before / after pair.
    # 
    # _@param_ `file`
    # 
    # _@param_ `width` — the render width line bars pad to.
    def render_file: (File file, Integer width) -> String

    # The longest diff-body line across every hunk, plus the 2-column gutter
    # — the natural width the bars want before the {@max_width} cap. Binary
    # files (no body) contribute nothing.
    # 
    # _@param_ `files`
    def content_width: (::Array[File] files) -> Integer

    # One parsed file section of the diff.
    # 
    # @!attribute [r] path
    #   @return [String] the working-tree path shown in the header.
    # @!attribute [r] kind
    #   @return [Symbol] +:modified+, +:new+, or +:deleted+.
    # @!attribute [r] binary
    #   @return [Boolean] +true+ for a +Binary files … differ+ section (no hunks).
    # @!attribute [r] hunks
    #   @return [Array<Hunk>] the file's hunks (empty when +binary+).
    class File < Data
      # _@return_ — the working-tree path shown in the header.
      attr_reader path: String

      # _@return_ — +:modified+, +:new+, or +:deleted+.
      attr_reader kind: Symbol

      # _@return_ — +true+ for a +Binary files … differ+ section (no hunks).
      attr_reader binary: bool

      # _@return_ — the file's hunks (empty when +binary+).
      attr_reader hunks: ::Array[Hunk]
    end

    # One parsed hunk: the new-side start line and the reconstructed before /
    # after line arrays (markers stripped).
    # 
    # @!attribute [r] new_start
    #   @return [Integer] the +@@ … +N @@+ new-side start line.
    # @!attribute [r] old
    #   @return [Array<String>] context + removed lines (the "before").
    # @!attribute [r] new
    #   @return [Array<String>] context + added lines (the "after").
    class Hunk < Data
      # _@return_ — the +@@ … +N @@+ new-side start line.
      attr_reader new_start: Integer

      # _@return_ — context + removed lines (the "before").
      attr_reader old: ::Array[String]

      # _@return_ — context + added lines (the "after").
      attr_reader new: ::Array[String]
    end
  end

  # The coding shell's workspace sidebar as one Tuile container: a fixed
  # {TASK_HEIGHT} task pane stacked over the git change-summary pane, plus the
  # off-layout diff dialog. Composes {TaskListPane}, {GitSummaryPane},
  # {GitDiffTextView}, and the {GitWatcher} service that feeds the last two:
  # 
  #   Tasks ───────    <- fixed TASK_HEIGHT rows, caption included
  #   ○ port the tint
  #   Changes ─────    <- the remaining rows; the full diff is a
  #   M lib/x.rb +2       leader-menu dialog (#open_diff), not part of this box
  # 
  # This is a *secondary* surface, so the whole column paints +:pane_bg+ — set
  # once here, inherited by both panes — which is what tells it apart from the
  # untinted conversation beside it now that neither is framed. The +│+ column
  # on its left edge and the status rule below it belong to {Layout}, not here.
  # 
  # The host builds it, folds {#task_listener} into the agent's
  # +ListenerList+, hands it to {Layout} as the single +sidebar:+ child, and
  # drives its lifecycle: {#start_git_watching} before the event loop and
  # {#stop_git_watching} after (see {App#run}); the leader menu's +d+ entry
  # calls {#open_diff}. Everything git flows from the {GitWatcher} this box
  # owns — the host never touches it.
  # 
  # Coding-shell-only — the chat / computer shells carry no sidebar.
  # 
  # UI-thread-confined. The one off-thread entry is the {GitWatcher}
  # +on_change+ callback (it runs on the poll thread); it marshals onto the UI
  # thread via +screen.event_queue.submit+ before touching the panes, so the
  # service itself stays UI-independent.
  class WorkspaceSidebar < Tuile::Component::Layout
    TASK_HEIGHT: Integer

    # Builds the panes, the diff dialog and the {GitWatcher}, then subscribes
    # the git views to it. Adds the task and change-summary panes as layout
    # children; the diff dialog is *not* a child — it opens only on {#open_diff}.
    def initialize: () -> void

    # _@return_ — the task-stream listener (owned by
    # the task pane's view); fold it into the agent's +ListenerList+.
    def task_listener: () -> TaskListPane::Listener

    # Starts the {GitWatcher}'s background poll; call before the event loop
    # ({App#run}) and pair with {#stop_git_watching}.
    def start_git_watching: () -> void

    # Stops the {GitWatcher}'s background poll; call after the event loop
    # unwinds ({App#run}'s +ensure+).
    def stop_git_watching: () -> void

    # Opens the fullscreen diff dialog with the latest full diff (kept current by the
    # {GitWatcher} subscription). A no-op if it is already open. The leader
    # menu's +d+ action.
    def open_diff: () -> void

    # _@return_ — whether the diff dialog is currently open.
    def diff_open?: () -> bool

    # _@return_ — what the two panes are
    # showing, reduced to counts — for a host to stand up elsewhere while this
    # column is off screen.
    def digest: () -> Shared::StatusRuleLabel::WorkspaceDigest

    # Registers a callback fired with a fresh {#digest} whenever either pane's
    # data moves — the git poll landing or the task list changing.
    # 
    #   sidebar.on_digest { |digest| status_rule.workspace_digest = digest }
    # 
    # Called on the UI thread (the git leg is already marshalled). One
    # callback; a second registration replaces the first.
    def on_digest: () ?{ (Shared::StatusRuleLabel::WorkspaceDigest digest) -> void } -> void

    # Stacks a fixed {TASK_HEIGHT} task pane over the git change-summary pane
    # across the sidebar rect; an empty one makes both panes' rects empty, so
    # they paint nothing. The {GitWatcher} keeps polling either way, so
    # {#open_diff} still opens on a current diff.
    # 
    # Assigns both panes on every pass, empty rect included — Tuile's own rule
    # for a container whose rect has gone empty, and here the bite is concrete:
    # children left pointing at the columns they used to hold survive every
    # normal repaint and then paint at those stale coordinates the moment a
    # popup close fires {Tuile::Screen#needs_full_repaint}, silent under test.
    def relayout: () -> void

    def emit_digest: () -> void

    # _@return_ — the background git service the panes subscribe to;
    # exposed for tests.
    attr_reader git_watcher: GitWatcher

    # _@return_ — the change-summary pane; exposed for tests,
    # production drives it through the {GitWatcher} subscription.
    attr_reader git_summary_pane: GitSummaryPane

    # _@return_ — the full diff, shown in a dialog by
    # {#open_diff}; exposed for tests.
    attr_reader git_diff_view: GitDiffTextView
  end

  # A working-tree diff as a {Tuile::Component::TextView}, in the two-tier
  # inline form {GitDiffRenderer} produces - a themed file header over
  # +@@ line N @@+ separators over inline-colored hunk bodies, the same family as
  # the edit / write tool diffs - or a placeholder when clean:
  # 
  #   view = Code::GitDiffTextView.new
  #   view.snapshot = Code::GitWatcher::Snapshot.new(
  #     changes: [], diff_text: "diff --git a/x b/x\n@@ -1 +1 @@\n-old\n+new\n", error: nil)
  #   Tuile::Component::Dialog.new('Git diff', content: view).open
  # 
  # The inline bars pad to the view's wrap width, so the retained snapshot
  # re-renders whenever that moves ({#relayout}) - a resize, or a host turning
  # the scrollbar on. Degrades to the raw plain diff (logged) if
  # {GitDiffRenderer} chokes on an unexpected diff shape, per
  # +D_tui_degrades_not_crashes+ ("external breakage is logged, we degrade").
  # 
  # UI-thread-confined.
  class GitDiffTextView < Tuile::Component::TextView
    PLACEHOLDER: String
    LOG: Logger

    def initialize: () -> void

    # Shows a git snapshot, rendered at the next {#relayout} where the width is
    # settled, and retained so a later resize re-renders it. Ignores the
    # snapshot's change list (that's the {GitSummaryPane}'s half).
    # 
    # _@param_ `snapshot`
    def snapshot=: (GitWatcher::Snapshot snapshot) -> void

    # Re-renders the retained snapshot once {#render_width} has moved off the
    # width it was rendered at - before +super+, so the text it sets is wrapped
    # in this same pass.
    def relayout: () -> void

    def rerender: () -> void

    # _@param_ `raw` — combined plain +git diff+ output.
    # 
    # _@return_ — the two-tier inline ANSI diff, or the raw text on a
    # renderer failure (logged).
    def render_diff: (String raw) -> String

    # The columns a row may fill before it wraps (TextView's +wrap_width+, which
    # already leaves the scrollbar's columns out), floored at 1 so a closed
    # dialog's zero-width view still renders.
    def render_width: () -> Integer
  end

  # Keeps the status rule's plan-mode badge in step with
  # the agent's shared {Pikuri::Workspace::ReadOnly} flag. A
  # {Pikuri::Agent::Listener::Base} subclass that consumes the
  # {Pikuri::Code::PlanModeChanged} event +Pikuri::Code::Extension+
  # re-emits on every real transition, and pushes the new posture onto
  # the status rule ({Shared::StatusRuleLabel#plan_active=}).
  # 
  # The companion to {Shared::StatusRuleLabel} /
  # {TaskListPane::Listener}: same worker-thread-to-UI-thread marshaling, one event
  # class. It lives in +Code+ rather than {Shared} because plan mode is a
  # +:code+-group concern — the event is a +:code+-group constant the chat
  # shell never loads (which is also why the chat shell's badge stays
  # hidden: it never wires this listener).
  # 
  # == Why the event, not the control
  # 
  # The badge is driven off the *event* rather than the host reading the
  # {Pikuri::Workspace::ReadOnly} flag directly, so a
  # **model**-initiated entry (the +enter_plan_mode+ tool) lights up the
  # status rule exactly like the leader menu's +p+ toggle does — both flips fire the
  # flag's +on_change+, which +Code::Extension+ bridges onto this
  # event stream. The status rule therefore reflects the authoritative flag,
  # never an inference about who toggled it.
  # 
  # {#on_event} fires on whatever thread flipped the flag — the agent's
  # worker thread for a model flip, the UI thread for a +p+ menu toggle — so
  # it marshals the status-rule mutation onto the event-loop thread via
  # +screen.event_queue.submit+ (a +submit+ from the UI thread simply
  # enqueues, so the host-flip path is safe too).
  class PlanModeListener < Pikuri::Agent::Listener::Base
    # _@param_ `status_rule` — the status rule to update (a {Shared::StatusRuleLabel}). Lifetime is owned by the host +App+.
    # 
    # _@param_ `screen` — the screen whose +event_queue+ marshals the update back onto the event-loop thread. Passed explicitly (not the singleton) so tests can inject a {Tuile::FakeScreen}.
    def initialize: (status_rule: untyped, screen: Tuile::Screen) -> void

    # Pushes the new plan-mode posture onto the status rule; ignores every
    # other event. Called from the flipping thread — the status-rule mutation
    # is marshaled onto the event-loop thread.
    # 
    # _@param_ `event` — any agent event; only {Pikuri::Code::PlanModeChanged} is acted on.
    def on_event: (Data event) -> void

    # _@return_ — short label used by +Pikuri::Agent#to_s+ when this
    # listener is in its +ListenerList+.
    def to_s: () -> String
  end

  # Shared rendering helpers for the edit / write tool formatters
  # ({EditFormatter}, {WriteFormatter}). Plain module functions rather
  # than a base class — the two formatters differ only in how they derive
  # the before/after pair, so they compose this rendering rather than
  # inheriting it.
  # 
  # Both the call-time diff block and the result-time error line live here
  # so the two formatters stay identical wherever they can: a +ToolCall+
  # renders {render_call} (a themed header over a {DiffRenderer} body), and
  # the paired +ToolResult+ renders {render_result} — +nil+ on success (the
  # diff already showed the change), the error line otherwise.
  # 
  # Every string leaving here for the pane is {defang}ed first. The path, the
  # payload and the error summary are all model-authored, and {DiffRenderer}
  # emits its span text verbatim — so one raw ESC in a written line recolors
  # the transcript from that cell on.
  module DiffToolFormatting
    GLYPH: String

    # Render the call-time diff block: a themed header line
    # (+"✎ Edit(lib/foo.rb)"+) over the {DiffRenderer} diff of +old+ → +new+.
    # The header keeps the +Verb(argument)+ shape every other tool call has, so
    # a diff reads as one of the family rather than a second convention.
    # 
    # _@param_ `verb` — the action shown in the header (+"Edit"+, +"Write"+, +"Create"+).
    # 
    # _@param_ `path` — the file path shown in the header.
    # 
    # _@param_ `old` — the "before" content.
    # 
    # _@param_ `new` — the "after" content.
    # 
    # _@param_ `width` — target render width (the conversation pane's).
    # 
    # _@param_ `theme` — the active theme; supplies the header color and the four diff background tones.
    # 
    # _@return_ — header + ANSI diff body.
    def render_call: (
                       verb: String,
                       path: String,
                       old: String,
                       new: String,
                       width: Integer,
                       theme: Tuile::Theme
                     ) -> String

    # Render the call-time diff block: a themed header line
    # (+"✎ Edit(lib/foo.rb)"+) over the {DiffRenderer} diff of +old+ → +new+.
    # The header keeps the +Verb(argument)+ shape every other tool call has, so
    # a diff reads as one of the family rather than a second convention.
    # 
    # _@param_ `verb` — the action shown in the header (+"Edit"+, +"Write"+, +"Create"+).
    # 
    # _@param_ `path` — the file path shown in the header.
    # 
    # _@param_ `old` — the "before" content.
    # 
    # _@param_ `new` — the "after" content.
    # 
    # _@param_ `width` — target render width (the conversation pane's).
    # 
    # _@param_ `theme` — the active theme; supplies the header color and the four diff background tones.
    # 
    # _@return_ — header + ANSI diff body.
    def self.render_call: (
                            verb: String,
                            path: String,
                            old: String,
                            new: String,
                            width: Integer,
                            theme: Tuile::Theme
                          ) -> String

    # Render the result-time line for a paired edit / write +ToolResult+.
    # Success is silent — the diff already told the story; a failure surfaces
    # as a themed error line so a failed attempt (rare) doesn't read as if it
    # applied.
    # 
    # _@param_ `summary` — the tool's own one-line status; +"Error: ..."+ for a failure, which pikuri prefixes in +Tool::Result.error+.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — the error line, or +nil+ to suppress on success.
    def render_result: (summary: String, theme: Tuile::Theme) -> String?

    # Render the result-time line for a paired edit / write +ToolResult+.
    # Success is silent — the diff already told the story; a failure surfaces
    # as a themed error line so a failed attempt (rare) doesn't read as if it
    # applied.
    # 
    # _@param_ `summary` — the tool's own one-line status; +"Error: ..."+ for a failure, which pikuri prefixes in +Tool::Result.error+.
    # 
    # _@param_ `theme` — the active theme.
    # 
    # _@return_ — the error line, or +nil+ to suppress on success.
    def self.render_result: (summary: String, theme: Tuile::Theme) -> String?

    # Make a model-authored string printable, for the diff body:
    # 
    #   defang("rm -rf \e[2Kbuild")   # => 'rm -rf \x1b[2Kbuild'
    # 
    # Newlines and indentation survive, so a diff stays a diff.
    # 
    # _@param_ `text` — file content, or a +write+'s payload.
    # 
    # _@return_ — with control / bidi / zero-width bytes made visible.
    def defang: (String text) -> String

    # Make a model-authored string printable, for the diff body:
    # 
    #   defang("rm -rf \e[2Kbuild")   # => 'rm -rf \x1b[2Kbuild'
    # 
    # Newlines and indentation survive, so a diff stays a diff.
    # 
    # _@param_ `text` — file content, or a +write+'s payload.
    # 
    # _@return_ — with control / bidi / zero-width bytes made visible.
    def self.defang: (String text) -> String

    # {defang} for a string that has to fit one row — a path, an error summary
    # — so an embedded newline can't forge a second line.
    # 
    # _@param_ `text`
    # 
    # _@return_ — one line, whitespace runs collapsed.
    def defang_line: (String text) -> String

    # {defang} for a string that has to fit one row — a path, an error summary
    # — so an embedded newline can't forge a second line.
    # 
    # _@param_ `text`
    # 
    # _@return_ — one line, whitespace runs collapsed.
    def self.defang_line: (String text) -> String

    # Build the {DiffRenderer::Palette} from the theme's four diff tokens,
    # read at render time so OS light/dark flips restyle the diff.
    # 
    # _@param_ `theme`
    def palette: (Tuile::Theme theme) -> DiffRenderer::Palette

    # Build the {DiffRenderer::Palette} from the theme's four diff tokens,
    # read at render time so OS light/dark flips restyle the diff.
    # 
    # _@param_ `theme`
    def self.palette: (Tuile::Theme theme) -> DiffRenderer::Palette
  end

  # A {Pikuri::Workspace::Confirmer} that asks the human in the transcript: the
  # question lands as a block in the conversation pane, the status rule lights
  # its parked-decision badge, and the calling thread parks until a key answers.
  # 
  #   confirmer = Code::TranscriptConfirmer.new(screen: screen, conversation: conversation,
  #                                             status_rule: status_rule, input: input)
  #   # ... a tool, on the agent worker thread:
  #   case confirmer.ask(request: request)   # parks here until the human answers
  #   in Pikuri::Workspace::Confirmer::Approved then run_it
  #   in Pikuri::Workspace::Confirmer::Rejected(reason:) then tell_the_model(reason)
  #   end
  # 
  #   ⏵ OK to run this command?
  #   rm -rf build
  #   (y) approve   (n) reject   (r) reject w/ reason
  # 
  # +y+ approves the payload unchanged, +n+ declines, and +r+ borrows the prompt
  # for a steering reason the tool folds into the model's next observation. An
  # *editable* request (only the +agent+ tool's delegation sets that) also offers
  # +e+, which borrows the prompt to rewrite the payload the tool then acts on —
  # the "author, not approver" seat. Both typing outcomes go through
  # {Shared::InputPane#capture}; there is deliberately no text-entry popup.
  # 
  # Those keys answer only while the conversation pane holds focus — which is
  # what lets them be spelled +y+ / +n+ at all, since prose typed at the prompt
  # is a different focus target and can never reach a decision. The one
  # obligation that puts on a caller: *dismissal is not decline.* Tabbing away
  # leaves the decision parked, and a parked decision holds the agent's worker
  # thread, so +Ctrl+C+ and quit must both call {#reject_pending!} or they do
  # nothing visible while a question waits.
  # 
  # == Sanitizing
  # 
  # +request.question+, +request.detail+ and the change's bytes are RAW
  # LLM-composed bytes (see {Pikuri::Workspace::Confirmer::Request}), so {#ask}
  # runs them through {Pikuri::Sanitizer} — the same chrome-independent primitive
  # +Confirmer::Terminal+ uses. Dangerous bytes are neutralized for literal
  # display (a command carrying +"\rrm -rf ~/"+ can't redraw the line after the
  # user has read it), and each attack class detected returns a warning
  # {ConfirmRenderer} surfaces above the question.
  # 
  # The verdict also gates the edit pre-fill, which is the subtle part: the
  # edited payload must be RAW bytes (it is what the sub-agent receives), so
  # pre-filling the prompt with it would hand the attack straight back. A
  # *clean* task pre-fills; a *flagged* one forces a full retype and loses the
  # bare-approve key — forced authorship exactly where it matters most.
  # 
  # == Threading
  # 
  # UI-thread-confined, with one exception (the method a tool calls parks the
  # *caller's* thread, and carries its own rule).
  # 
  # The hand-off is a one-shot +Queue+: the question is submitted onto the UI
  # thread, and the worker parks on +Queue#pop+ until a key resolves it. Parking
  # the worker is the point — it is exactly the thread that should wait while the
  # human decides, leaving the UI thread free to paint and to process the
  # keypress that unblocks it.
  class TranscriptConfirmer < Pikuri::Workspace::Confirmer
    CAPTURE_MARKER: String

    # _@param_ `screen` — the screen whose +event_queue+ marshals the question onto the UI thread.
    # 
    # _@param_ `conversation` — the pane the question is asked in and answered at.
    # 
    # _@param_ `status_rule` — the rule whose parked-decision badge says a turn is waiting on a human.
    # 
    # _@param_ `input` — the prompt borrowed for the edit / reason text, and the focus target the answer returns to.
    def initialize: (
                      screen: Tuile::Screen,
                      conversation: Shared::ConversationTextView,
                      status_rule: Shared::StatusRuleLabel,
                      input: Shared::InputPane
                    ) -> void

    # Ask +request+ in the transcript and block the calling (worker) thread
    # until the user answers.
    # 
    # Safe to call from any thread *except* the UI thread — calling it there
    # would deadlock, since the submitted block can't run until the event loop
    # drains and the event loop would be parked here. Tools always call it from
    # the worker, so this holds.
    # 
    # _@param_ `request` — semantic content composed by the calling tool; sanitized and rendered here.
    # 
    # _@return_ — the resolved decision.
    def ask: (request: Pikuri::Workspace::Confirmer::Request) -> (Pikuri::Workspace::Confirmer::Approved | Pikuri::Workspace::Confirmer::Rejected)

    # _@return_ — whether a tool is parked waiting for an answer. Read on
    # the UI thread.
    def pending?: () -> bool

    # Reject whatever is parked, so a +Ctrl+C+ or a quit isn't swallowed by a
    # decision the user never noticed.
    # 
    # _@return_ — +false+ when nothing was parked (the caller should fall
    # through to its normal handling), +true+ when a decision was declined.
    def reject_pending!: () -> bool

    # Ask the question and light the badge, arming the transcript's keys.
    # 
    # _@param_ `channel` — the one-shot channel the parked caller is popping.
    # 
    # _@param_ `request` — the original, *unsanitized* request. Needed alongside the display copies below because an approval passes its +detail+ through verbatim and an edit pre-fills the prompt with it — both want the raw bytes the tool will act on.
    # 
    # _@param_ `question` — the sanitized question.
    # 
    # _@param_ `detail` — the sanitized payload.
    # 
    # _@param_ `warnings` — what the sanitizer flagged; empty when clean.
    # 
    # _@param_ `change` — the sanitized file change to diff.
    def park: (
                Queue channel,
                request: Pikuri::Workspace::Confirmer::Request,
                question: Pikuri::Sanitizer::Result,
                detail: Pikuri::Sanitizer::Result?,
                warnings: ::Array[Pikuri::Sanitizer::Warning],
                change: Pikuri::Workspace::Confirmer::Change?
              ) -> void

    # The outcomes on offer. An editable request whose payload the sanitizer
    # flagged loses the bare-approve key: authorship is forced.
    # 
    # _@param_ `editable` — whether the payload may be rewritten.
    # 
    # _@param_ `clean` — whether the sanitizer flagged nothing.
    def choices: (editable: bool, clean: bool) -> ::Array[Shared::PendingDecision::Choice]

    # Act on the picked outcome: resolve it, or borrow the prompt for the text
    # the outcome still needs.
    # 
    # _@param_ `outcome` — +:approve+, +:edit+, +:reject+, +:reject_reason+.
    # 
    # _@param_ `payload` — the raw +Request#detail+.
    # 
    # _@param_ `clean` — whether the sanitizer flagged nothing.
    def decide: (Symbol outcome, payload: String?, clean: bool) -> void

    # Hand the prompt the task to rewrite. Submitting approves the
    # human-authored text (an emptied buffer included — a deliberately cleared
    # task); cancelling declines.
    # 
    # _@param_ `payload` — the raw task, pre-filled only when clean.
    # 
    # _@param_ `clean` — whether the sanitizer flagged nothing; a flagged task starts from an empty buffer.
    def capture_task: (payload: String?, clean: bool) -> void

    # Hand the prompt the steering reason. A blank answer or a cancel is a
    # reasonless decline.
    def capture_reason: () -> void

    # Settle the transcript block and wake the parked tool. The wake goes last,
    # so the UI is finished before the worker resumes rendering into that same
    # pane.
    # 
    # _@param_ `decision`
    # 
    # _@param_ `note` — the outcome as the transcript records it.
    def finish: ((Pikuri::Workspace::Confirmer::Approved | Pikuri::Workspace::Confirmer::Rejected) decision, String note) -> void

    # Neutralize a change's bytes for display, returning a +Change+ carrying the
    # sanitized old/new text alongside the warnings they raised.
    # 
    # Old/new are sanitized *before* diffing rather than the diff sanitized
    # after ({Pikuri::Workspace::Confirmer::Terminal} does the latter):
    # {DiffRenderer} emits ANSI, which a later sanitize pass would escape into
    # visible +\x1b+ noise. The mapping is per-character and newline-preserving,
    # so the two orders align line for line.
    # 
    # _@param_ `change`
    # 
    # _@return_ — the display-safe change (+nil+ when
    # the request carried none) and its warnings.
    def sanitize_change: (Pikuri::Workspace::Confirmer::Change? change) -> ([Pikuri::Workspace::Confirmer::Change, NilClass] | ::Array[Pikuri::Sanitizer::Warning])

    # Force file bytes into valid UTF-8 for display.
    # 
    # The file tools hand back BINARY strings ({Pikuri::Workspace::Edit} matches
    # in LF space via +String#b+), and matching one against the sanitizer's
    # UTF-8 regexp raises +Encoding::CompatibilityError+ the moment the file
    # holds a non-ASCII byte.
    # 
    # _@param_ `bytes` — raw file content.
    # 
    # _@return_ — UTF-8 with undecodable bytes replaced by U+FFFD.
    def displayable: (String bytes) -> String
  end

  # Mirrors pikuri's path-activation gate into the two places the human reads
  # it: the slash palette's +/<skill-name>+ half, and a transcript line when a
  # touched file brings a gated skill into play.
  # 
  #   · skills available: writing-rdoc (matched lib/code/app.rb)
  # 
  #   skill_activation = Code::SkillActivationListener.new(
  #     skill_extension: skill_ext, slash_menu: slash_menu,
  #     conversation: conversation_window, screen: screen,
  #     base: built_in_commands,
  #     on_load: ->(name, rest) { skill_ext.schedule_load_skill(name); session.submit(rest) }
  #   )
  #   agent = Pikuri::Agent.new(...) { |c| c.add_listener skill_activation }
  #   skill_activation.refresh        # seed the palette, and again after every /clear
  # 
  # A skill declaring +paths:+ is not in play until the model touches a matching
  # file, so it is not listed until then — and the moment it fires it appears
  # without the user reopening anything. +base+ leads the palette and reserves
  # its own names: a skill whose +/<name>+ is already taken is dropped with one
  # warn, so a built-in verb (+/plan+) can never be captured by a same-named
  # skill. What is lost is only the shortcut — the skill stays loadable by
  # asking the agent for it in plain language.
  # 
  # == Implementation details
  # 
  # The gate binds the human, not only the model: +schedule_load_skill+ refuses
  # a pending skill exactly as the +skill+ tool does, so listing one would
  # produce a palette entry that raises +KeyError+ on Enter. Reading the
  # activation is what keeps the two in step.
  # 
  # The matched path is why the notice is rendered from the event rather than
  # left to the injected block {Shared::ConversationTextView} drops: activation
  # deliberately over-fires, so a skill *will* appear for no visible reason, and
  # without the trigger, diagnosing it means guessing which glob matched.
  # 
  # {#refresh} is the reset half rather than a +Event::Reset+ arm:
  # +Agent#clear_conversation+ emits that event *before* it clears the
  # activation, so the host refreshes once that call has returned.
  # 
  # The extension is held rather than its +activation+, because
  # +Skill::Extension#configure+ may swap that object out for an
  # +Activation::Open+ (an agent with no interloper has no channel a promotion
  # could land on, so the gate comes off wholesale). Reading it per call follows
  # the swap; a captured reference would keep gating a palette nothing can
  # un-gate.
  # 
  # UI-thread-confined, with exceptions.
  class SkillActivationListener < Pikuri::Agent::Listener::Base
    LOG: Logger

    # _@param_ `skill_extension` — source of both the catalog and the activation gate deciding what is in play right now.
    # 
    # _@param_ `slash_menu` — the palette to keep current.
    # 
    # _@param_ `conversation` — where a promotion is announced.
    # 
    # _@param_ `screen` — whose +event_queue+ marshals a promotion back onto the event-loop thread.
    # 
    # _@param_ `base` — the commands that lead the palette and reserve their names against the skills.
    # 
    # _@param_ `on_load` — called as +(name, rest)+ when a +/<skill-name>+ runs: the catalog name, and the rest of the typed line.
    def initialize: (
                      skill_extension: Pikuri::Skill::Extension,
                      slash_menu: Shared::SlashMenuPopup,
                      conversation: Shared::ConversationTextView,
                      screen: Tuile::Screen,
                      base: ::Array[Shared::SlashCommand],
                      on_load: Proc
                    ) -> void

    # The palette's full command set as of now: +base+ followed by one
    # +/<skill-name>+ per skill currently in play, in catalog order.
    def commands: () -> ::Array[Shared::SlashCommand]

    # Push {#commands} onto the palette. Call it once the agent is built (to
    # seed), and after every +clear_conversation+ (which re-hides every gated
    # skill).
    def refresh: () -> void

    # Announces a promotion and re-lists the palette; ignores every other event.
    # Safe from any thread — it fires on the agent's worker — because the
    # palette mutation is marshaled onto the UI thread and the notice marshals
    # itself.
    # 
    # _@param_ `event` — any agent event; only {Pikuri::Skill::Promoted} is acted on.
    def on_event: (Data event) -> void

    # _@return_ — short label used by +Pikuri::Agent#to_s+ when this
    # listener is in its +ListenerList+.
    def to_s: () -> String

    # _@param_ `skill`
    # 
    # _@return_ — +nil+ when +base+ already took the
    # name, warned once per skill however often the palette is recomputed.
    def skill_command: (Pikuri::Skill::Catalog::Skill skill) -> Shared::SlashCommand?
  end
end

module Chat
  # The Tuile shell behind +bin/pikuri-tui-chat+: builds the borderless
  # conversation pane, the status rule, the tinted prompt, the eager diagnostic {Shared::Log::Dialog}
  # (popup-visible via the {Shared::LeaderMenu}'s +l+ entry), the +Ctrl+K+ menu /
  # +Ctrl+C+ cancel global-shortcut hints
  # in the screen-wide status bar, and wires the agent's loop onto a worker
  # thread so the UI thread stays free for repaints.
  # 
  # == Construction: App owns the agent
  # 
  # App builds its own +Pikuri::Agent+ from the {Shared::Config} handed to
  # it — the chat system prompt, the boot connection ({#config}'s first
  # +llm+), and the web/calc tool set (see {#default_build_agent}). The bin
  # only parses CLI + config and mounts the screen; the agent, its tools,
  # and its listeners are the shell's identity and live here.
  # 
  # Construction is linear, not cyclic: App builds the components (the
  # {Shared::ConversationTextView} owns the {Shared::ConversationTextView::Listener}
  # and {Shared::StatusRuleLabel}), *then* builds the agent against those
  # listeners.
  # 
  # The optional +transport:+ is a **test seam**, not production ceremony: a
  # spec passes a +Pikuri::Testing.fake_transport+ so App builds its *real*
  # agent — the real {#default_build_agent} listener/tool wiring — on a
  # scripted-HTTP backend instead of a live server. Production omits it and
  # boots on the config's first connection ({#config}'s first +llm+). Only the
  # transport is injectable because the agent's collaborators (the conversation
  # listener, the status rule, the tools) are App's own objects — swapping the
  # backend is all a test needs to exercise the wiring without the network.
  # 
  # == Screen ownership
  # 
  # App assumes a {Tuile::Screen} (or {Tuile::FakeScreen}) is already
  # installed as the singleton — production code calls +Tuile::Screen.new+
  # in the bin script before constructing App; tests call
  # +Tuile::Screen.fake+. That's intentional: App doesn't unilaterally
  # mount a real terminal screen, so a host that wants to inject a fake
  # for an integration test doesn't have to fight constructor order.
  # 
  # == Threading
  # 
  # Per AGENTS.md's threading invariant, Tuile is single-threaded and the agent loop must not
  # run on the UI thread. App runs {Tuile::Screen#run_event_loop} on the
  # caller's thread (the main thread for the bin script) and delegates the
  # off-thread turn lifecycle — worker thread, mid-turn injection,
  # concurrency guard, spinner, Ctrl+C escalation — to a composed
  # {Shared::AgentSession} (see its threading contract). Enter routes to
  # +session.submit+, Ctrl+C to +session.interrupt+, leader +c+ to
  # +session.clear_conversation+.
  # 
  # UI-thread-confined.
  class App
    LOG: Logger

    # _@return_ — the eager-constructed
    # diagnostic log (owned by the {Shared::Log::UI}). Exposed for tests and for
    # callers that want to install additional logger sinks.
    def log_dialog: () -> Shared::Log::Dialog

    # _@param_ `config` — the resolved configuration; App derives the model list (one {Shared::Model::Choice} per +config.llms+ entry, the first the boot connection) and reads the web-search provider keys from it when building the agent.
    # 
    # _@param_ `markdown` — forwarded to {Shared::ConversationTextView}'s +markdown:+ flag (default +true+). When +false+, the conversation pane skips +TTY::Markdown+ and the streaming path uses {Shared::Markdown::PassthroughBuffer} — appropriate for back-ends whose content is already in display form.
    # 
    # _@param_ `transport` — test seam: the backend to build the real agent on. Omit in production (boots on the config's first connection); a spec passes a +Pikuri::Testing.fake_transport+ to run real turns against scripted HTTP. See the class header.
    def initialize: (config: Shared::Config, ?markdown: bool, ?transport: Pikuri::Agent::ChatTransport?) -> void

    # Runs the Tuile event loop, blocking the calling thread until the user
    # quits ({Tuile::Keys::ESC} or +q+) or the loop is otherwise stopped. Does
    # NOT close the screen: the bin owns teardown via +begin/ensure
    # Tuile::Screen.close+ around both +App.new+ and this call, so the screen
    # is torn down whether the failure is in construction (a boot-time
    # transport probe) or in the loop. +run_event_loop+ only restores stdin /
    # cursor / mouse; +Screen#close+ clears the frame and unsets the singleton.
    def run: () -> void

    def build_components: () -> void

    # The chat shell's slash commands — the {Shared::LeaderMenu} actions
    # reachable by name: +/logs+, +/model+ (only with more than one connection,
    # like the menu's +m+), +/clear+, and +/exit+ = +/quit+ — plus +/trifecta+,
    # which has no menu counterpart: a report to read when you wonder, not an
    # action worth a leader key. +/image <path>+ has none either: it fills the
    # prompt ({Shared::InputPane#attach}) rather than acting. Callbacks are lazy (they resolve +@log_ui+ /
    # +@session+ / +@agent+ / +quit+ at run time), so this is safe to build
    # before the agent; only the +/model+ *presence* is decided now, from
    # {Shared::Model::Picker#multiple?}.
    def build_slash_commands: () -> ::Array[Shared::SlashCommand]

    # Build the chat shell's +Pikuri::Agent+: a streaming agent on the boot
    # connection (+@boot_transport+, the config's first connection unless a
    # test injected a fake), the +pikuri-chat+ system prompt (dated), and the
    # web-search / calculator / scrape / fetch tool set. Registers the
    # conversation listener (rate-limited to 15 fps), {#token_log}, and the
    # {#status_rule} into the agent's +ListenerList+ — all reached
    # through the {Shared::ConversationTextView} this App owns, so nothing has to
    # be passed in.
    # 
    # _@return_ — the wired agent.
    def default_build_agent: () -> Pikuri::Agent

    # Wire app-level keyboard shortcuts on the screen. Both bypass the
    # cursor-owner suppression that would otherwise let the focused
    # {Shared::InputPane} swallow them, and both surface a hint in the screen's
    # status bar (which is why Ctrl+K is registered via
    # {Shared::Log::UI#install_shortcut} — its hint mutates as errors accrue).
    # 
    # All app actions are reached through one of two keys; every other
    # binding lives behind the {Shared::LeaderMenu}:
    # 
    # - +Ctrl+K+ opens the {Shared::LeaderMenu} command popup (logs / switch model
    #   / quit). +over_modal: false+ (the default), so it can't stack over
    #   an open popup. The {Shared::Log::UI} owns this binding because its hint also
    #   carries the unread-error tally — the only always-visible status-bar
    #   surface.
    # - +Ctrl+C+ runs the {Shared::AgentSession#interrupt} escalation (cancel turn →
    #   unfocus → quit). The one direct accelerator kept: it is the urgent
    #   mid-turn interrupt, not a command we want behind a chord. Also
    #   +over_modal: false+: a popup means the user isn't interacting with
    #   the LLM, so Ctrl+C is the popup's business, not ours. The trade-off
    #   is that you can't cancel a running turn while a popup happens to be
    #   open — close it (ESC/q) first.
    def register_shortcuts: () -> void

    # Build the {Shared::LeaderMenu} for the chat shell: logs, switch model (only
    # when there's more than one connection to pick between), and a hard
    # quit. The model entry is registered only when there's something to
    # switch to, so the menu never offers a no-op pick.
    def build_leader_menu: () -> Shared::LeaderMenu

    # Stop the event loop, unwinding {#run} into +Screen#close+. The leader
    # menu's +q+ action — a hard quit, distinct from
    # {Shared::AgentSession#interrupt}'s escalation (no turn-cancel /
    # unfocus steps). Runs on the event-loop
    # thread (deferred by {Shared::LeaderMenu}), so +stop+ is safe to call.
    def quit: () -> void

    # _@param_ `event` — the uncaught exception, in the event the empty-means-re-raise slot hands its listeners.
    def on_screen_error: (Tuile::EventQueue::ErrorEvent event) -> void

    # _@return_ — the (already-installed) screen this app
    # runs on.
    attr_reader screen: Tuile::Screen

    # The shell's pane layout — not the screen's content component, which is
    # the {Shared::RootLayout} stacking this over {#status_bar}.
    attr_reader layout: Chat::Layout

    # _@return_ — the bottom row.
    attr_reader status_bar: Shared::StatusBar

    # _@return_ — the resolved configuration the bin loaded;
    # drives the model list, the boot connection, and the web-search
    # provider keys {#default_build_agent} reads.
    attr_reader config: Shared::Config

    # _@return_ — the agent {#default_build_agent} built. Exposed
    # so callers (and tests) can inspect tools/listeners/transport after
    # wiring.
    attr_reader agent: Pikuri::Agent

    # _@return_ — the turn-lifecycle engine this shell
    # composes; Enter / Ctrl+C / leader +c+ delegate into it. Exposed for
    # tests.
    attr_reader session: Shared::AgentSession

    # _@return_ — the conversation transcript
    # pane. Exposed primarily for tests; production code should reach
    # it through the {Shared::ConversationTextView::Listener}.
    attr_reader conversation: Shared::ConversationTextView

    # _@return_ — the main agent's token
    # log, App-owned and fed into the {Shared::StatusRuleLabel}.
    # {#default_build_agent} registers this same instance in the agent's
    # +ListenerList+ so it receives +Tokens+ events.
    attr_reader token_log: Pikuri::Agent::Listener::TokenLog

    # _@return_ — the status rule between the
    # conversation and the prompt, which doubles as the model-name listener.
    # {#default_build_agent} registers it in the agent's +ListenerList+ so
    # +ModelSwitched+ events reach it.
    attr_reader status_rule: Shared::StatusRuleLabel
  end

  # Vertical-split root layout for {App}, borderless throughout:
  # 
  #   ┌────────────────────────────────────────────┐
  #   │   conversation (terminal background)       │
  #   │                                            │
  #   ├── Local Qwen 3.6 · 25k/60k ────────────────┤  <- Shared::StatusRuleLabel
  #   │ ❯ prompt (tinted :pane_bg)                 │  <- Shared::InputPane
  #   └────────────────────────────────────────────┘
  # 
  # Nothing here is framed; what separates the two panes is the one-row status
  # rule and the prompt's own tint. The conversation is inset {CONTENT_INSET}
  # columns from the left so its text lines up with the prompt's buffer, with
  # the +❯+ hanging into the margin below it; the rule and the prompt well both
  # span the full width, so the tinted block reads as a band across the bottom
  # of the screen.
  # 
  # Layout only — global keybindings (Ctrl+K, Ctrl+C) are installed by
  # {App} via {Tuile::Screen#register_global_shortcut}, which bypasses
  # the cursor-owner suppression that would otherwise let the focused
  # {Tuile::Component::TextArea} swallow them.
  # 
  # UI-thread-confined.
  class Layout < Tuile::Component::Layout
    INPUT_HEIGHT: Integer
    CONTENT_INSET: Integer

    # _@param_ `conversation` — the transcript pane (top). Added as a child during construction; its rect is managed by {#relayout}.
    # 
    # _@param_ `status_rule` — the one-row rule between the two panes, carrying the agent status readout. Same lifecycle.
    # 
    # _@param_ `input` — the tinted prompt well (bottom). Same lifecycle.
    def initialize: (conversation: Shared::ConversationTextView, status_rule: Shared::StatusRuleLabel, input: Shared::InputPane) -> void

    # Divides the layout's own rect between the three rows. The prompt takes
    # the bottom {INPUT_HEIGHT} rows and the rule the one above it; the
    # conversation takes everything left, inset by {CONTENT_INSET}. On a
    # terminal too short for all three the prompt shrinks first, then the rule
    # drops out, then the conversation — each floored at +0+, at which point
    # {Tuile::Component} treats the pane as invisible.
    def relayout: () -> void

    attr_reader conversation: Shared::ConversationTextView

    attr_reader status_rule: Shared::StatusRuleLabel

    attr_reader input: Shared::InputPane
  end
end

# Namespace for the +bin/pikuri-tui-computer+ TUI: the desktop-assistant shell
# ({Computer::App}) and its vertical-split root layout ({Computer::Layout}).
# The shell composes two pikuri surfaces into one local agent for this
# machine (wired in the bin):
# 
# * +Pikuri::Os::Extension+ — the five file tools, a network-severed
#   sandboxed +bash+, and the machine-facts / MACHINE.md system-prompt
#   sections (understanding and operating this host); plus a quarantined
#   RESEARCHER sub-agent for human-gated web research.
# * +Pikuri::Thunderbird::Extension+ — searching and reading the user's
#   local mail + calendar, and two human-gated outbound hand-offs (draft a
#   reply, add an event) the user Sends/confirms in Thunderbird's own UI.
# 
# This is pikuri's "reassembled trifecta" — whole-disk private pool +
# attacker-authorable email as an untrusted source + egress — with every
# egress leg human-gated, never autonomous (see +bin/pikuri-tui-computer+, and
# the "every outbound leg waits on a keystroke" promise in +AGENTS.md+ that
# makes). The Tuile shell is otherwise
# identical to the chat/code shells; it owns nothing pikuri-side beyond
# wiring these two extensions.
# 
# == Shape: chat layout, code wiring
# 
# The computer shell is laid out like {Chat::App} — one conversation pane
# over an input strip, NO sidebar (unlike {Code::App}'s task + git windows).
# But its tools mutate the real host, so it carries the coding shell's
# safety machinery: it owns a {Code::TranscriptConfirmer} (yielded to the
# build block for the +write+ / +bash+ tools), surfaces plan mode (a
# status-rule badge via {Code::PlanModeListener} + a leader-menu +p+ toggle),
# and renders +edit+ / +write+ tool calls as diffs through the same
# {Code::EditFormatter} / {Code::WriteFormatter}. Thunderbird's two outbound
# tools need no confirmer here — their gate is Thunderbird's own compose
# window / import wizard, so the shell wires them without extra UI.
# 
# == Why a parallel copy of +Chat::+ / +Code::+ and not a shared base
# 
# This shell reuses the cross-cutting +Shared::*+ blocks and the +Code::*+
# confirmer / diff classes directly, and copies only the genuinely-divergent
# scaffolding ({Computer::App}, {Computer::Layout}) — never subclassing
# {Chat::App} or {Code::App}. The fork is in +design/decisions.md+,
# +D_parallel_shells+.
# 
# == Computer-only dependencies
# 
# Everything here transitively needs the heavier pikuri gems
# (pikuri-workspace / -code, pulled in by pikuri-os) plus pikuri-thunderbird
# — and the reused +Code::*+ adapters need them too. The boot loader ignores
# this whole subtree when those gems aren't loaded, so the chat process —
# which runs +Bundler.setup(:default)+ — never sees it. See the gate in
# +lib/pikuri_tui.rb+.
module Computer
  # The Tuile shell behind +bin/pikuri-tui-computer+: the borderless
  # conversation pane, the status rule, the tinted prompt, the eager diagnostic {Shared::Log::Dialog}
  # (popup-visible via the {Shared::LeaderMenu}'s +l+ entry), the +Ctrl+K+
  # menu / +Ctrl+C+ cancel status-bar hints, and the agent loop on a worker
  # thread.
  # 
  # Laid out like {Chat::App} — one conversation pane over an input strip,
  # NO sidebar — but it carries the coding shell's safety machinery because
  # the agent's file/bash tools mutate the real host: a
  # {Code::TranscriptConfirmer} gates +write+ / +bash+, plan mode surfaces as a status-rule badge
  # ({Code::PlanModeListener} + a leader-menu +p+ toggle), and +edit+ / +write+
  # render as diffs. It reuses the +Code::*+ adapters directly rather than
  # re-copying them (see {Computer} for the duplicate-only-the-shell
  # rationale).
  # 
  # == Construction: App owns the agent
  # 
  # App builds its own +Pikuri::Agent+ from the {Shared::Config} handed to it —
  # the OS-assistant prompt (with a network-posture block keyed to
  # +internet_enabled+), the boot connection (+config.llms+'s first entry), a
  # whole-host {Pikuri::Os::Extension} (five file tools + a network-severed
  # sandboxed bash), local mail + calendar via
  # {Pikuri::Thunderbird::Extension}, and — unless +internet_enabled+ is false
  # — a quarantined web RESEARCHER sub-agent (see {#default_build_agent}). The
  # bin only parses CLI + config, probes the Thunderbird profile, and mounts
  # the screen.
  # 
  # The optional +transport:+ is a **test seam**, not production ceremony: a
  # spec passes a +Pikuri::Testing.fake_transport+ so App builds its *real*
  # agent — the real {#default_build_agent} listener/tool/extension wiring — on
  # a scripted-HTTP backend instead of a live server. Production omits it and
  # boots on the config's first connection. Only the transport is injectable
  # because the agent's collaborators (the conversation listener, the status
  # rule, the confirmer, the plan-mode listener) are App's own objects; the
  # host probes the extensions make are steered through +profile_dir:+ and
  # +config.sandbox+, which production sets anyway.
  # 
  # == The bwrap probe runs here, on the production path
  # 
  # {#default_build_agent} builds the +FullFsNoNet+ sandbox, whose constructor
  # probes +bwrap+ + user/net namespaces and raises if they're unavailable.
  # That raise happens during +App.new+ — but +Tuile::Screen.new+ has not yet
  # entered raw mode / the alternate buffer (that is +run_event_loop+'s job),
  # so the backtrace still reaches a normal terminal. The bin wraps
  # +App.new+/+run+ in +begin/ensure Tuile::Screen.close+ to tear the screen
  # down on any escape — which is why {#run} does NOT close the screen itself.
  # Tests never hit the probe: they boot with +config.sandbox+ false.
  # 
  # == Screen ownership
  # 
  # App assumes a {Tuile::Screen} (or {Tuile::FakeScreen}) is already
  # installed as the singleton — the bin calls +Tuile::Screen.new+ before
  # constructing App; tests call +Tuile::Screen.fake+.
  # 
  # == Threading
  # 
  # Per AGENTS.md's threading invariant, Tuile is single-threaded and the agent loop must not run on
  # the UI thread. App runs {Tuile::Screen#run_event_loop} on the caller's
  # thread and delegates the off-thread turn lifecycle — worker thread,
  # mid-turn injection, concurrency guard, spinner, Ctrl+C escalation — to a
  # composed {Shared::AgentSession} (see its threading contract). Enter routes
  # to +session.submit+, Ctrl+C to {#interrupt}, leader +c+ to
  # +session.clear_conversation+. The {Code::TranscriptConfirmer} bridges the
  # other way: a tool on the worker thread calls +confirm?+, which submits the
  # question to the UI thread and parks the worker until the user answers (see
  # its docs).
  # 
  # UI-thread-confined.
  class App
    LOG: Logger

    # _@return_ — the whole-host workspace anchor — the filesystem's
    # normalized project root (relative-path base + bash chdir target). The
    # single source of truth for where this shell is rooted; the bin logs it
    # as "Working from …" rather than re-deriving +Dir.pwd+.
    def project_root: () -> Pathname

    # _@return_ — the eager-constructed
    # diagnostic log (owned by the {Shared::Log::UI}).
    def log_dialog: () -> Shared::Log::Dialog

    # _@param_ `config` — the resolved configuration; App derives the model list (one {Shared::Model::Choice} per +config.llms+ entry, the first the boot connection), reads the sandbox/confirm posture, and reads the web-search provider keys when building the agent.
    # 
    # _@param_ `internet_enabled` — whether to wire the quarantined web RESEARCHER sub-agent (the +--no-internet+ flag forces +false+). Also selects the online/offline network-posture prompt block. Mail + calendar work regardless. Default +true+.
    # 
    # _@param_ `profile_dir` — the Thunderbird profile directory forwarded to {Pikuri::Thunderbird::Extension} (the bin has already probed it); +nil+ auto-discovers. Default +nil+.
    # 
    # _@param_ `project_root` — the whole-host workspace anchor (relative-path base + bash chdir target), shown in the conversation window title. Default +Dir.pwd+ (the launch dir; the computer shell never chdirs).
    # 
    # _@param_ `markdown` — forwarded to {Shared::ConversationTextView}'s +markdown:+ flag (default +true+).
    # 
    # _@param_ `command_registry` — the on-disk slash commands, one palette entry each. Defaults to a scan of the launch dir and +$HOME+ — this shell has no containment to reason from, so neither base is vouched for and +/trifecta+ grades them accordingly. A spec passes an empty registry to keep the palette off the host's real +~/.claude/commands+.
    # 
    # _@param_ `transport` — test seam: the backend to build the real agent on. Omit in production (boots on the config's first connection); a spec passes a +Pikuri::Testing.fake_transport+ to run real turns against scripted HTTP. See the class header.
    def initialize: (
                      config: Shared::Config,
                      ?internet_enabled: bool,
                      ?profile_dir: String?,
                      ?project_root: (Pathname | String),
                      ?markdown: bool,
                      ?command_registry: Pikuri::Command::Registry,
                      ?transport: Pikuri::Agent::ChatTransport?
                    ) -> void

    # Runs the Tuile event loop, blocking the calling thread until the user
    # quits or the loop is otherwise stopped. Does NOT close the screen: the
    # bin owns teardown via +begin/ensure Tuile::Screen.close+ around both
    # +App.new+ and this call, so the screen is torn down whether the failure
    # is in construction (the +FullFsNoNet+ bwrap probe) or in the loop. See
    # the "bwrap probe" note in the class docs.
    def run: () -> void

    def build_components: () -> void

    # Build the computer shell's +Pikuri::Agent+: a streaming agent on the boot
    # connection (+@boot_transport+, the config's first connection unless a
    # test injected a fake), the OS-assistant prompt (plus a network
    # online/offline posture block keyed to +internet_enabled+), and the
    # desktop tool surface. Wires the conversation listener
    # (rate-limited to 15 fps), {#token_log}, {#status_rule}, and
    # {#plan_mode_listener} into the agent's +ListenerList+ — all reached
    # through App's own objects, so nothing has to be passed in.
    # 
    # Composes two pikuri surfaces onto one agent: {Pikuri::Os::Extension} (the
    # five file tools + a network-severed +FullFsNoNet+-sandboxed bash + the
    # machine facts / MACHINE.md prompt sections) and
    # {Pikuri::Thunderbird::Extension} (mail + calendar search/read + two
    # human-gated outbound hand-offs). Web research, on unless
    # +internet_enabled+ is false, is quarantined: the web tools go on
    # sub-agent-only, so the main agent holds no direct egress and delegates to
    # an isolated RESEARCHER (web tools, no filesystem) gated by the confirmer.
    # 
    # == The sandbox probe raises here
    # 
    # +FullFsNoNet.new+ probes +bwrap+ + user/net namespaces at construction
    # and raises (no silent fallback) if unavailable — see the class docs for
    # why that raise is safe on this path. +--no-sandbox+ / +--yolo+
    # (+config.sandbox+ false) swap in +Sandbox::NONE+ and re-open the network.
    # 
    # _@return_ — the wired agent.
    def default_build_agent: () -> Pikuri::Agent

    # Wire app-level keyboard shortcuts on the screen. Both bypass the
    # cursor-owner suppression that would otherwise let the focused
    # {Shared::InputPane} swallow them, and both surface a hint in the status
    # bar (which is why Ctrl+K is registered via {Shared::Log::UI#install_shortcut} —
    # its hint mutates as errors accrue).
    # 
    # All app actions are reached through one of two keys; every other binding
    # (logs / plan mode / switch model) lives behind the {Shared::LeaderMenu}:
    # 
    # - +Ctrl+K+ opens the {Shared::LeaderMenu} command popup. +over_modal: false+
    #   (the default), so it can't stack over an open popup. The {Shared::Log::UI} owns
    #   this binding because its hint also carries the unread-error tally —
    #   the only always-visible status-bar surface.
    # - +Ctrl+C+ runs {#interrupt}. The one direct accelerator kept: it is the
    #   urgent mid-turn interrupt, not a command we want behind a chord. Also
    #   +over_modal: false+: a popup means the user isn't interacting with
    #   the LLM, so Ctrl+C is the popup's business, not ours. The trade-off
    #   is that you can't cancel a running turn while a popup happens to be
    #   open — close it (ESC/q) first.
    def register_shortcuts: () -> void

    # +Ctrl+C+: decline a parked confirmation if there is one, else run the
    # {Shared::AgentSession#interrupt} escalation (cancel turn -> unfocus ->
    # quit).
    # 
    # The decision comes first because a parked tool has the worker blocked, so
    # cancelling the turn alone would look like nothing happened until the
    # decision was answered.
    def interrupt: () -> void

    # Build the {Shared::LeaderMenu} for the computer shell: logs, plan mode, switch
    # model (only when there's more than one connection), and a hard quit.
    # The model entry is registered only when there's something to switch
    # to, so the menu never offers a no-op pick. (Like {Chat::App}'s set
    # plus +p+ plan mode, but without the coding shell's +d+ git diff —
    # the computer shell has no git window.)
    def build_leader_menu: () -> Shared::LeaderMenu

    # The computer shell's slash commands — the {Shared::LeaderMenu} actions
    # reachable by name: +/logs+, +/plan+ (toggle), +/model+ (only with more
    # than one connection, like the menu's +m+), +/clear+, and +/exit+ =
    # +/quit+. No +/diff+ — the computer shell has no git window. Plus
    # +/trifecta+, which has no menu counterpart: a report to read when you
    # wonder, not an action worth a leader key — and the shell whose premise is
    # the reassembled trifecta is the one where it is worth reading.
    # +/image <path>+ has none either: it fills the prompt
    # ({Shared::InputPane#attach}) rather than acting. Callbacks
    # are lazy (they resolve +@log_ui+ / +@plan_mode+ / +@session+ / +@agent+ /
    # +quit+ at run time), so this is safe to build before the agent; only the
    # +/model+ *presence* is decided now, from {Shared::Model::Picker#multiple?}.
    def build_slash_commands: () -> ::Array[Shared::SlashCommand]

    # Stop the event loop, unwinding {#run} back to the bin's +ensure+ (which
    # calls +Screen#close+). The leader menu's +q+ action — a hard quit,
    # distinct from {Shared::AgentSession#interrupt}'s escalation (no
    # turn-cancel / unfocus steps). Runs on the event-loop thread (deferred by
    # {Shared::LeaderMenu}), so +stop+ is safe to call.
    def quit: () -> void

    # Flip the shared {Pikuri::Workspace::ReadOnly} plan-mode flag —
    # enter if off, exit if on. Runs on the UI thread (global-shortcut
    # dispatch); the flag is thread-safe, and the status-rule badge updates
    # through {Code::PlanModeListener} off the +PlanModeChanged+ event the
    # flip emits, so this stays a one-liner and the model-flip path
    # renders the same way. Idempotent transitions
    # ({Pikuri::Workspace::ReadOnly#activate!}/{#deactivate!}) make a
    # double-press harmless.
    def toggle_plan_mode: () -> void

    # _@param_ `event` — the uncaught exception, in the event the empty-means-re-raise slot hands its listeners.
    def on_screen_error: (Tuile::EventQueue::ErrorEvent event) -> void

    # _@return_ — the (already-installed) screen this app
    # runs on.
    attr_reader screen: Tuile::Screen

    # The shell's pane layout — not the screen's content component, which is
    # the {Shared::RootLayout} stacking this over {#status_bar}.
    attr_reader layout: Computer::Layout

    # _@return_ — the bottom row.
    attr_reader status_bar: Shared::StatusBar

    # _@return_ — the resolved configuration the bin loaded;
    # drives the model list, the boot connection, the sandbox/confirm
    # posture, and the web-search provider keys {#default_build_agent} reads.
    attr_reader config: Shared::Config

    # _@return_ — the agent {#default_build_agent} built. Exposed
    # so callers (and tests) can inspect tools/listeners/transport after
    # wiring.
    attr_reader agent: Pikuri::Agent

    # _@return_ — the turn-lifecycle engine this shell
    # composes; Enter / Ctrl+C / leader +c+ delegate into it. Exposed for
    # tests.
    attr_reader session: Shared::AgentSession

    # _@return_ — the conversation transcript
    # pane. Exposed primarily for tests; production code should reach
    # it through the {Shared::ConversationTextView::Listener}.
    attr_reader conversation: Tuile::Component::TextView

    # _@return_ — the main agent's token
    # log, App-owned and fed into the {Shared::StatusRuleLabel}. {#default_build_agent} registers this
    # same instance in the agent's +ListenerList+.
    attr_reader token_log: Pikuri::Agent::Listener::TokenLog

    # _@return_ — the status rule, which doubles as the
    # model-name listener. {#default_build_agent} registers it in the
    # agent's +ListenerList+ so +ModelSwitched+ events reach it.
    attr_reader status_rule: Shared::StatusRuleLabel

    # _@return_ — the status rule's plan-mode-badge listener,
    # registered by {#default_build_agent} so +Pikuri::Code::PlanModeChanged+
    # events reach the status rule. Dormant until a plan-mode transition fires
    # (via {#toggle_plan_mode} or the model's enter/exit tools).
    attr_reader plan_mode_listener: Code::PlanModeListener

    # _@return_ — the in-transcript confirmer wired into the
    # +write+ / +bash+ tools; exposed for tests and for callers that want to
    # inspect how those tools were gated.
    attr_reader confirmer: Code::TranscriptConfirmer

    # _@return_ — the on-disk slash commands this shell
    # scanned, refused ones included.
    attr_reader command_registry: Pikuri::Command::Registry
  end

  # Vertical-split root layout for {App}, borderless throughout: the
  # conversation pane on top, the {Shared::StatusRuleLabel} beneath it, the
  # tinted {Shared::InputPane} at the bottom. A parallel copy of
  # {Chat::Layout} (see {Computer} for why the computer shell duplicates rather
  # than shares) — the computer shell is laid out like the chat shell, with no
  # sidebar.
  # 
  # Layout only — global keybindings (Ctrl+K, Ctrl+C) are installed by
  # {App} via {Tuile::Screen#register_global_shortcut}, which bypasses
  # the cursor-owner suppression that would otherwise let the focused
  # {Tuile::Component::TextArea} swallow them.
  # 
  # UI-thread-confined.
  class Layout < Tuile::Component::Layout
    INPUT_HEIGHT: Integer
    CONTENT_INSET: Integer

    # _@param_ `conversation` — the transcript pane (top). Added as a child during construction; its rect is managed by {#relayout}.
    # 
    # _@param_ `status_rule` — the one-row rule between the two panes, carrying the agent status readout. Same lifecycle.
    # 
    # _@param_ `input` — the tinted prompt well (bottom). Same lifecycle.
    def initialize: (conversation: Shared::ConversationTextView, status_rule: Shared::StatusRuleLabel, input: Shared::InputPane) -> void

    # Divides the layout's own rect between the three rows. The prompt takes
    # the bottom {INPUT_HEIGHT} rows and the rule the one above it; the
    # conversation takes everything left, inset by {CONTENT_INSET}. On a
    # terminal too short for all three the prompt shrinks first, then the rule
    # drops out, then the conversation.
    def relayout: () -> void

    attr_reader conversation: Shared::ConversationTextView

    attr_reader status_rule: Shared::StatusRuleLabel

    attr_reader input: Shared::InputPane
  end
end

module Shared
  # Owns one agent's turn lifecycle for a shell: run the loop off the UI
  # thread, serialize concurrent turns, absorb mid-turn injections, drive
  # the status rule's spinner, and escalate Ctrl+C. Construct it, hand it the
  # agent once the build block has run, then feed it user input:
  # 
  #   session = Shared::AgentSession.new(
  #     screen: @screen, conversation: @conversation, status_rule: @status_rule,
  #     model_picker: @model_picker, logger: LOG
  #   )
  #   session.agent = built_agent          # once the agent exists
  #   input = Shared::InputPane.new(on_submit: session.method(:submit))
  #   # Ctrl+C -> session.interrupt ; leader 'c' -> session.clear_conversation
  # 
  # This is a *coordinator*, not a UI-independent service: unlike
  # {Code::GitWatcher} it deliberately holds the +screen+ and drives two panes'
  # surfaces — the rule's spinner and the transcript's error / notice lines.
  # Coordinating those with off-thread agent work is its whole job. It only
  # ever calls their public action verbs (+start_animation+ /
  # +stop_animation+ / +render_turn_error+ — tell, don't ask); each pane keeps
  # owning how it draws.
  # 
  # Each shell's +App+ composes one of these and delegates into it; the +App+
  # keeps its own construction / layout / leader-menu / shortcuts / +run+
  # loop, plus +quit+ and +on_screen_error+ (which touch neither the agent
  # nor the turn flag, so they don't belong to the turn lifecycle).
  # 
  # == Threading
  # 
  # UI-thread-confined, with a worker exception. Every method here must be
  # called on the thread that owns +Screen#run_event_loop+ (the UI thread) —
  # the +@turn_in_progress+ flag is read and written only there. The agent
  # loop blocks on the LLM, so {#submit} spawns a fresh +Thread.new+ per turn
  # that calls +agent.run_loop+; that worker never touches the UI directly,
  # marshaling the spinner-off / flag-clear / leftover-delivery back through
  # +screen.event_queue.submit+ so they execute on the UI thread. Concurrent
  # turns are prevented by +@turn_in_progress+: while a turn runs, {#submit}
  # routes into the agent's +Interloper+ instead of starting a second loop.
  # 
  # UI-thread-confined (its own methods; the worker it spawns runs the pikuri
  # loop off-thread and marshals back).
  class AgentSession
    # _@param_ `screen` — the screen whose +event_queue+ the worker marshals back through, and whose focus / loop {#interrupt} escalates.
    # 
    # _@param_ `conversation` — the transcript pane whose error / notice surface this drives (+render_turn_error+ / +render_notice+).
    # 
    # _@param_ `status_rule` — the status rule whose mid-turn spinner this drives (+start_animation+ / +stop_animation+).
    # 
    # _@param_ `model_picker` — the shared picker; a pending switch is consumed via +take_pending+ at the top of each turn.
    # 
    # _@param_ `logger` — the per-shell logger (so dropped-injection and clear-during-turn warnings keep the shell's subsystem tag in the diagnostic pane); typically the +App+'s +LOG+ constant.
    def initialize: (
                      screen: Tuile::Screen,
                      conversation: Shared::ConversationTextView,
                      status_rule: Shared::StatusRuleLabel,
                      model_picker: Shared::Model::Picker,
                      logger: Logger
                    ) -> void

    # Subscribe to a turn the model refused for its images
    # (+Pikuri::Agent::UnsupportedAttachmentError+): nothing was sent, and the
    # block runs on the UI thread with the reason.
    # 
    #   session.on_attachment_refused { |reason| input.refuse_attachment(reason) }
    def on_attachment_refused: () ?{ (String reason) -> void } -> void

    # _@return_ — whether a turn is currently running. Read on the UI
    # thread.
    def turn_in_progress?: () -> bool

    # Start a turn for +message+, or — if one is already running — queue it as
    # a mid-turn injection instead of starting a second +run_loop+. The
    # {Shared::InputPane}'s +on_submit+ target, and the re-entry point
    # {#deliver_pending_injections} uses to flush leftovers as a fresh turn.
    # 
    # +message+ is normally non-blank (the input suppresses blank submits), but a
    # skill command submits +""+ to drive a *bare* load (the skill it just
    # scheduled becomes the whole turn). A blank submit is only meaningful when
    # idle — it runs a bare +run_loop+; a blank submit *mid-turn* is a no-op, as
    # the scheduled skill already rides the running turn and there's no message to
    # inject.
    # 
    # _@param_ `message` — the draft; blank only from a skill bare-load.
    # 
    # _@param_ `attachments` — images to show the model with +message+.
    def submit: (String message, ?attachments: ::Array[Pikuri::Attachment]) -> void

    # The +Ctrl+C+ escalation, mirroring ESC's two-press quit but driven
    # explicitly because a global shortcut fires before the pane and so never
    # "falls through" to the loop's unhandled-key quit the way ESC does. Three
    # states, in priority order:
    # 
    # 1. A turn is running -> cancel it. {Shared::ConversationTextView::Listener}
    #    renders the +Cancelled+ event; the worker's +ensure+ clears the flag.
    # 2. Nothing running but something is focused (normally the
    #    {Shared::InputPane}) -> drop focus, the same visible effect as ESC.
    # 3. Nothing running and nothing focused -> stop the event loop, which
    #    unwinds the +App+'s +run+ into +Screen#close+ (what an unhandled ESC
    #    does).
    # 
    # The host registers this +over_modal: false+, so it never runs while a
    # popup is open — no need to guard the unfocus/quit steps against orphaning
    # a modal popup's focus. Runs on the UI thread (global-shortcut dispatch),
    # so touching +focused=+ / +event_queue.stop+ and reading the flag are safe.
    def interrupt: () -> void

    # Reset the agent to a fresh-conversation state via
    # +Pikuri::Agent#clear_conversation+ (chat history, controls, and each
    # extension's conversation-scoped state). That emits a single
    # +Pikuri::Agent::Event::Reset+, off which {Shared::ConversationTextView::Listener}
    # wipes the pane and the +TokenLog+ zeroes the status rule — so this only kicks
    # the agent; the visible reset falls out of the event stream. The leader
    # menu's +c+ action.
    # 
    # A no-op (logged) while a turn is running: +clear_conversation+ is not
    # designed to race an in-flight +run_loop+.
    def clear_conversation: () -> void

    # Route a message submitted while a turn is in flight into the agent's
    # +Pikuri::Agent::Control::Interloper+. The agent drains the queue at its
    # next +after_tool_result+ boundary; when the host wired no interloper the
    # message is dropped with a warn in the diagnostic log.
    # 
    # _@param_ `message`
    # 
    # _@param_ `attachments`
    def queue_mid_turn: (String message, ::Array[Pikuri::Attachment] attachments) -> void

    # Spawn a worker thread for one agent turn. Library exceptions are logged
    # (the long-running TUI takes the "exceptions logged, our bugs raise" path
    # from +D_tui_degrades_not_crashes+) and a short red one-liner is echoed into the conversation
    # pane; cancellation is silent because {Shared::ConversationTextView::Listener}
    # already rendered the +Cancelled+ event.
    # 
    # _@param_ `message`
    # 
    # _@param_ `attachments`
    def start_turn: (String message, ::Array[Pikuri::Attachment] attachments) -> void

    # A turn can end with items still sitting in the interloper queue (the agent
    # only drains it at +after_tool_result+ boundaries). Drain them and start a
    # fresh turn so every leftover is delivered promptly. Fires after a cancelled
    # turn too: a mid-turn message is usually a correction, and the cancel is
    # what makes room for it.
    # 
    # The queue holds two {Pikuri::Agent::Control::Interloper::Item} kinds
    # (+:user+ / +:system+). +:user+ leftovers join, in submission order, into
    # the fresh turn's message, their attachments with them; +:system+ leftovers (e.g. a skill scheduled
    # during the final assistant message and never drained) go *back* on the
    # queue via +inject_system_message+, so the next +run_loop+ re-applies them
    # as system context at its top rather than folding a skill body into a user
    # message. With only +:system+ leftovers the fresh turn is bare, which still
    # drains + applies them.
    # 
    # Runs on the UI thread (the caller marshals via +submit+), so the
    # +@turn_in_progress+ read inside {#submit} is safe.
    def deliver_pending_injections: () -> void

    # _@return_ — the agent this session drives, or +nil+
    # until it's set. Set it once, after the shell's build block has
    # returned the agent: the agent, hence its interloper and transport,
    # doesn't exist at construction.
    attr_accessor agent: Pikuri::Agent?
  end

  # Turns pikuri's on-disk slash commands — the +.md+ prompt templates under
  # +.pikuri/commands+ / +.claude/commands+ — into {Shared::SlashCommand}s the
  # palette can list and run:
  # 
  #   commands = Shared::FileCommands.build(
  #     registry: command_registry, reserved: built_ins.map(&:name),
  #     screen: screen, logger: LOG,
  #     on_expand: ->(text) { session.submit(text) }
  #   )
  #   #=> [#<SlashCommand name="/wh" description="<label> — weekly work log" …>]
  # 
  # Running one expands its template (+$ARGUMENTS+, +$1+…+$9+) against the rest
  # of the typed line and hands the result to +on_expand+ as an ordinary user
  # turn — the human wrote it, the template just saved the typing. So it is not a
  # +:system+ block and it is not hidden from the transcript.
  # 
  # A command whose file pikuri refuses — it declares +allowed-tools:+, or its
  # body carries a <code>!`cmd`</code> shell directive — is still listed, marked
  # +(unavailable)+, and answers with the reason instead of running. A menu entry
  # that silently vanished would be the worse failure, since the human is looking
  # straight at the list.
  # 
  # +reserved+ is what a built-in already took. A file command may not capture a
  # built-in verb: a cloned repo shipping +.claude/commands/plan.md+ would
  # otherwise take over +/plan+, which flips a safety gate. The loser is dropped
  # with a warn, and dropped is all it is — unlike a shadowed skill, nothing else
  # reaches it.
  # 
  # Requires no pikuri gem: +registry+ is duck-typed, so the lean chat process
  # (which never loads pikuri-skills) can still eager-load this file.
  module FileCommands
    # _@param_ `registry` — the scanned command files.
    # 
    # _@param_ `reserved` — command names already taken, leading slash included.
    # 
    # _@param_ `screen` — resolves the theme at run time, so a refusal is toned by whatever theme is current rather than the boot one.
    # 
    # _@param_ `logger` — takes the shadowing warnings, so they carry the composing shell's subsystem tag.
    # 
    # _@param_ `on_expand` — called with the expanded template +String+; drives it as a user turn.
    # 
    # _@return_ — in the registry's own precedence
    # order.
    def build: (
                 registry: Pikuri::Command::Registry,
                 reserved: ::Array[String],
                 screen: Tuile::Screen,
                 logger: Logger,
                 on_expand: Proc
               ) -> ::Array[Shared::SlashCommand]

    # _@param_ `registry` — the scanned command files.
    # 
    # _@param_ `reserved` — command names already taken, leading slash included.
    # 
    # _@param_ `screen` — resolves the theme at run time, so a refusal is toned by whatever theme is current rather than the boot one.
    # 
    # _@param_ `logger` — takes the shadowing warnings, so they carry the composing shell's subsystem tag.
    # 
    # _@param_ `on_expand` — called with the expanded template +String+; drives it as a user turn.
    # 
    # _@return_ — in the registry's own precedence
    # order.
    def self.build: (
                      registry: Pikuri::Command::Registry,
                      reserved: ::Array[String],
                      screen: Tuile::Screen,
                      logger: Logger,
                      on_expand: Proc
                    ) -> ::Array[Shared::SlashCommand]

    # _@param_ `command`
    # 
    # _@return_ — the palette's right column: the argument hint leads when
    # the file declared one, since that is what you type next.
    def hint: (Pikuri::Command::Registry::Command command) -> String

    # _@param_ `command`
    # 
    # _@return_ — the palette's right column: the argument hint leads when
    # the file declared one, since that is what you type next.
    def self.hint: (Pikuri::Command::Registry::Command command) -> String

    # _@param_ `registry`
    # 
    # _@param_ `command`
    # 
    # _@param_ `screen`
    # 
    # _@param_ `on_expand`
    # 
    # _@return_ — the +(rest)+ action; +nil+ return for a command that ran (the
    # turn is its own record), the refusal reason for one that cannot.
    def callback: (
                    Pikuri::Command::Registry registry,
                    Pikuri::Command::Registry::Command command,
                    Tuile::Screen screen,
                    Proc on_expand
                  ) -> Proc

    # _@param_ `registry`
    # 
    # _@param_ `command`
    # 
    # _@param_ `screen`
    # 
    # _@param_ `on_expand`
    # 
    # _@return_ — the +(rest)+ action; +nil+ return for a command that ran (the
    # turn is its own record), the refusal reason for one that cannot.
    def self.callback: (
                         Pikuri::Command::Registry registry,
                         Pikuri::Command::Registry::Command command,
                         Tuile::Screen screen,
                         Proc on_expand
                       ) -> Proc
  end

  # One slash command: the typed name, the autocomplete hint, and the action.
  # 
  #   # an action command ignores the rest of the line:
  #   Shared::SlashCommand.new('/diff', 'show the git diff',
  #                            ->(_rest) { sidebar.open_diff; 'Opened the git diff.' })
  #   # a skill command consumes it as a follow-up message:
  #   Shared::SlashCommand.new('/writing-rdoc', 'writing rdoc docs',
  #                            ->(rest) { skill_ext.schedule_load_skill('writing-rdoc'); session.submit(rest); nil })
  # 
  # The +description+ is the right-column hint in the {Shared::SlashMenuPopup}
  # list; the +callback+'s *return value* is a separate string — the outcome
  # shown below the command in the conversation pane once it runs (nil for none,
  # e.g. a command that drives an agent turn and lets the turn be its own record).
  # So the hint ("show the git diff") and the effect report ("Opened the git
  # diff.") are distinct, and a command can report a dynamic result.
  # 
  # The +rest+ argument is the text after the command name (+""+ when none) —
  # {Shared::SlashMenuPopup} splits +"/name rest"+ and passes +rest+ through. An
  # action command takes-and-ignores it (+->(_rest) { … }+); a skill command
  # forwards it to the agent as a follow-up message.
  # 
  # Sibling of {Shared::LeaderMenu::Action}; each shell registers its own set.
  # 
  # @!attribute [r] name
  #   @return [String] the command as typed, leading slash included (+"/diff"+).
  # @!attribute [r] description
  #   @return [String] the autocomplete hint (right column of the popup list).
  # @!attribute [r] callback
  #   @return [Proc, Method] one-arg action (the +rest+ String), run one tick
  #     after Enter; its +String+ (or nil) return is echoed below the command as
  #     the outcome.
  class SlashCommand < Data
    # _@return_ — the command as typed, leading slash included (+"/diff"+).
    attr_reader name: String

    # _@return_ — the autocomplete hint (right column of the popup list).
    attr_reader description: String

    # _@return_ — one-arg action (the +rest+ String), run one tick
    # after Enter; its +String+ (or nil) return is echoed below the command as
    # the outcome.
    attr_reader callback: (Proc | Method)
  end

  # Shell-style recall for the prompt: the messages submitted this session,
  # oldest first, with the unsent draft pinned one slot *below* the newest — so
  # browsing away from what you were typing and back is lossless.
  # 
  #   history.append('deploy staging')  # the user submits
  #   history.draft = 'half-typed'      # capture on leaving the draft (the first Up)
  #   history.older                     # => 'deploy staging'
  #   history.older                     # => nil — already at the oldest
  #   history.newer                     # => 'half-typed' — back on the draft
  # 
  # Entries are frozen and never rewritten — the arrows always show exactly what
  # was sent, and the draft is the one mutable slot.
  class PromptHistory
    def initialize: () -> void

    # _@return_ — the entries, oldest first; a copy, so mutating it
    # doesn't reach the store.
    def entries: () -> ::Array[String]

    # _@return_ — whether the cursor is on the draft, i.e. nothing is
    # currently recalled.
    def at_draft?: () -> bool

    # Record a submitted message, then return the cursor to a cleared draft —
    # so submitting while browsing discards the pending draft, as shells do.
    # Only *consecutive* duplicates collapse (zsh's +HIST_IGNORE_DUPS+):
    # 
    #   history.append('ls'); history.append('ls')    # => one entry
    #   history.append('pwd'); history.append('ls')   # => ls, pwd, ls
    # 
    # _@param_ `text` — the submitted text; kept frozen, so the caller may go on mutating the String it passed.
    def append: (String text) -> void

    # _@param_ `text` — the unsent buffer to preserve; kept frozen.
    def draft=: (String text) -> void

    # Step one entry toward the oldest.
    # 
    # _@return_ — the entry to show, or +nil+ when the cursor is
    # already on the oldest entry (or there is no history at all).
    def older: () -> String?

    # Step one entry toward the newest, stopping on the draft.
    # 
    # _@return_ — the entry to show — the draft, once past the newest
    # entry — or +nil+ when the cursor is already on the draft.
    def newer: () -> String?

    # Abandon browsing and go straight back to the draft.
    # 
    # _@return_ — the preserved draft (+""+ when none was captured).
    def jump_to_draft: () -> String
  end

  # A single open streamed block: a {Tuile::Component::TextView::Region} plus the
  # streaming buffer writing into it, opened lazily on the first {#append} and then
  # closed one of three ways - {#finalize} (commit the authoritative text),
  # {#wipe} (drop the region and its content), or {#preserve} (drop the handle,
  # keep the content on screen). The assistant answer and the reasoning pane are
  # each one of these; they differ only in which buffer builder opens them, which
  # is exactly what the +open+ factory captures.
  # 
  #   block = Shared::StreamedBlock.new do
  #     region = view.create_region
  #     [region, view.build_assistant_buffer(region, indent: 0)]
  #   end
  #   block.append(delta)     # opens the region + buffer on the first call
  #   block.finalize(full)    # commit the final text, then close
  #   # …or, on an event that interrupts the stream:
  #   block.wipe              # a ToolCall arrived mid-answer -> remove the preview
  #   block.preserve          # a cancel -> keep what streamed, drop the handle
  # 
  # After any close ({#finalize} / {#wipe} / {#preserve}) the block is reusable: the
  # next {#append} opens a fresh region + buffer. {#wipe} / {#preserve} / {#finalize}
  # are no-ops while closed, so a caller can fire them unconditionally on an
  # interrupting event without first checking {#open?}.
  # 
  # UI-thread-confined: every region / buffer mutation it makes must run on the UI
  # thread (the caller marshals the driving event stream there).
  class StreamedBlock
    def initialize: () ?{ () -> [Tuile::Component::TextView::Region, untyped] } -> void

    # _@return_ — whether the block is currently open (holds an unfinalized
    # buffer).
    def open?: () -> bool

    # Append a streamed delta, opening the region + buffer on the first call.
    # 
    # _@param_ `content` — the delta text.
    def append: (String content) -> void

    # Commit the authoritative full text (which may replace a truncated preview)
    # and close. A no-op when not open.
    # 
    # _@param_ `content` — the final text.
    def finalize: (String content) -> void

    # Remove the region and its rendered content, then close - for an event that
    # interrupts an unfinished stream (e.g. a tool call mid-answer). A no-op when
    # not open.
    def wipe: () -> void

    # Drop the region / buffer handles but leave the rendered content on screen -
    # for a stream that should stay (a cancel, or handing off to a non-streamed
    # bookend). A no-op when not open.
    def preserve: () -> void

    def close: () -> void
  end

  # The transcript-density submenu — a {Shared::LeaderMenu} whose labels carry
  # live state, lazyvim's +<leader>u+ retargeted at Tuile. Hang it off the
  # leader menu:
  # 
  #   ui = Shared::UIToggleMenu.new(screen: screen, conversation: conversation)
  #   menu.add('u', 'UI toggles') { ui.open }
  # 
  #   Ctrl+K  u
  #   ┌ UI ─────────────────────┐
  #   │ t  thinking: shown      │
  #   │ v  tool lines: short    │
  #   └─────────────────────────┘
  # 
  # Each entry flips one {Shared::ConversationTextView} display flag, a session
  # override of a +[ui]+ config default that is never written back.
  # 
  # A submenu rather than two more top-level keys, and worth the extra keystroke
  # only because there are two: it keeps the leader menu a list of *actions*
  # (open the logs, clear the conversation) rather than a mix of actions and
  # settings, and puts the two preferences where they read against each other.
  # 
  # UI-thread-confined.
  class UIToggleMenu
    CAPTION: String

    # _@param_ `screen` — the screen the popup mounts on.
    # 
    # _@param_ `conversation` — the pane whose display flags these entries flip.
    def initialize: (screen: Tuile::Screen, conversation: Shared::ConversationTextView) -> void

    def open: () -> void

    # _@return_ — the toggle entries, in display
    # order. Exposed for tests.
    def actions: () -> ::Array[Shared::LeaderMenu::Action]
  end

  # Installs each +[[server]] max_concurrent_requests+ into pikuri's
  # process-wide request throttle, logging a line per server it sized:
  # 
  #   Shared::RequestPermits.install(config.servers)
  #   # permits: grok at most 4 concurrent request(s) → https://api.x.ai/v1
  # 
  # A server naming no ceiling is left alone, so pikuri's +/props+ probe sizes it
  # from the box's own +total_slots+. Don't add a spelling for "explicitly
  # unlimited": it suppresses that probe, and the only server worth typing it
  # against is a cloud endpoint the probe already answers for.
  # 
  # == Implementation details
  # 
  # +.limit+ wins by *decision*, not by ordering: +ServerPermits+ marks an
  # explicit size and refuses to let the probe's +.default+ overwrite it, so this
  # may run before or after the agent is built. Its scope is one process, not the
  # machine — three shells against one llama.cpp each get the full allowance.
  # 
  # The ceiling rations nothing in a pikuri-tui process, and this is still not
  # dead wiring. Nothing here puts two requests in flight (+tool_concurrency+ is
  # off, +SubAgentTool+ runs its child's loop inline, {Shared::AgentSession}
  # takes one turn at a time), so the live effect is narrower: a sized server
  # counts as *known* and skips the boot +/props+ probe (pikuri's
  # +decisions.md+ → +probe_when_unknown+). The ceiling is installed for the schema's
  # other consumer, pikuri-web, which does serve concurrent conversations — and
  # for the day this one does.
  module RequestPermits
    LOG: Logger

    # Size every server that asked to be sized; ignore the rest.
    # 
    # An unreferenced +[[server]]+ is installed too — rationing a server nobody
    # dials is a no-op, and cheaper than filtering by what the +[[llm]]+ list
    # happens to name.
    # 
    # _@param_ `servers` — the config's +[[server]]+ definitions.
    def install: (::Array[Shared::Config::Server] servers) -> void

    # Size every server that asked to be sized; ignore the rest.
    # 
    # An unreferenced +[[server]]+ is installed too — rationing a server nobody
    # dials is a no-op, and cheaper than filtering by what the +[[llm]]+ list
    # happens to name.
    # 
    # _@param_ `servers` — the config's +[[server]]+ definitions.
    def self.install: (::Array[Shared::Config::Server] servers) -> void
  end

  # One human decision awaiting an answer in the transcript: a rendered body, the
  # outcomes on offer, and the callback that reports the picked one.
  # 
  #   decision = Shared::PendingDecision.new(
  #     body: 'OK to run `rm -rf build`?',
  #     choices: [Shared::PendingDecision::Choice.new(key: 'y', label: 'approve', outcome: :approve),
  #               Shared::PendingDecision::Choice.new(key: 'n', label: 'reject',  outcome: :reject)],
  #     on_choice: ->(outcome) { decide(outcome) }   # gets :approve / :reject
  #   )
  #   conversation.pending_decision = decision   # renders body + "(y) approve   (n) reject"
  # 
  # +body+ arrives already rendered (ANSI, newline-joined) because what a decision
  # looks like is the asking side's business — a write request renders a diff, a
  # sub-agent delegation renders the task text.
  # 
  # UI-free and Pikuri-free: the pane renders it, but nothing here reaches for
  # either — so the lean chat process can load it too.
  class PendingDecision
    # The key cue shown under the body.
    # 
    #   '(y) approve   (e) edit   (n) reject'
    def cue: () -> String

    # _@param_ `key` — a pressed key, case as typed.
    # 
    # _@return_ — the choice that key picks, or +nil+ if it picks none.
    def choice_for: (String key) -> Choice?

    # One offered outcome: the key that picks it, the word shown in the cue, and
    # the symbol handed to +on_choice+.
    class Choice < Data
      # Returns the value of attribute key
      attr_reader key: Object

      # Returns the value of attribute label
      attr_reader label: Object

      # Returns the value of attribute outcome
      attr_reader outcome: Object
    end
  end

  # The slash-command palette: a non-modal overlay that appears while the prompt
  # buffer starts with +/+, lists the matching commands in two columns, and runs
  # the picked one. A borderless full-width bar floating just above the input:
  # 
  #    /diff   show the git diff
  #    /exit   quits the app
  #    /quit   quits the app
  #    <name>  <description>
  # 
  # Driven entirely by the {Shared::InputPane} that owns it — the popup never
  # takes focus (the caret stays in the field). The window wires three verbs:
  # 
  #   menu = Shared::SlashMenuPopup.new(
  #     screen: screen, commands: cmds, conversation: conversation_window)
  #   menu.sync(buffer)              # on every keystroke: open/filter/close
  #   menu.handle_nav_key(key)       # Up/Down move the selection, ESC closes
  #   menu.submit(buffer)            # Enter: run the selected/typed command
  # 
  # This is one self-sufficient component: it holds the catalog, filters it,
  # renders it, tracks the selection, splits +"/name rest"+, runs the command with
  # +rest+, and echoes any outcome to the conversation pane. It stays generic
  # across command *kinds* — a skill command carries its agent/catalog wiring in
  # its own {Shared::SlashCommand} callback (built by the shell), so this box only
  # resolves-and-calls. Should those callbacks ever bloat, split a non-widget
  # service out and leave this to only *pick* a command; until then one box is
  # simpler.
  # 
  # The panel *is* a {Tuile::Component::ListDropdown} — Tuile's reusable
  # "borderless, tinted, non-focusable floating list an input drops open" building
  # block, the panel half of {Tuile::Component::ComboBox}. The parent owns the
  # wrapped list, the {Tuile::Theme#input_bg_color} tint, the non-focusable /
  # never-steals-the-caret contract, and key-forwarding ({#move} / {#choose}); the
  # palette adds only the driver-specific parts that vary per dropdown — filtering,
  # two-column row rendering, geometry, and running the picked command.
  # 
  # == Implementation details
  # 
  # Geometry is the placement's ({AboveAnchor}, or {AtBottom} with no {#anchor}):
  # full screen width less one column each edge, {HEIGHT} tall, bottom edge just
  # above the anchor. The {Tuile::ScreenPane} runs it on every layout pass, so it
  # tracks a resize and the input moving.
  # 
  # {#submit} resolves the command *before* the caller clears the buffer (the
  # {Shared::InputPane} calls submit first, then wipes the field), so the
  # highlighted row is still valid: a partial +"/di"+ with +/diff+ highlighted
  # runs +/diff+. The callback runs one tick later (via the event queue) so a
  # command that opens its own popup (+/diff+) doesn't stack under this one
  # closing. The outcome echo is a plain {Shared::ConversationTextView#add_block} —
  # it never reaches the agent's message history.
  # 
  # UI-thread-confined.
  class SlashMenuPopup < Tuile::Component::ListDropdown
    PAD: Integer
    HEIGHT: Integer

    # The palette's rect for a bar whose bottom edge sits at row +bottom+.
    # 
    # _@param_ `bottom` — the screen row the palette ends just above.
    # 
    # _@param_ `screen_size`
    def self.bar_above: (Integer bottom, Tuile::Size screen_size) -> Tuile::Rect

    # _@param_ `screen` — mounts the popup, defers callbacks, resolves the theme and screen size.
    # 
    # _@param_ `commands` — the full catalog.
    # 
    # _@param_ `conversation` — where command echoes and outcomes are written (never the agent context).
    def initialize: (screen: Tuile::Screen, commands: ::Array[Shared::SlashCommand], conversation: Shared::ConversationTextView) -> void

    # Replaces the command catalog and recomputes the name-column width.
    # 
    # _@param_ `commands`
    def commands=: (::Array[Shared::SlashCommand] commands) -> void

    # _@return_ — whether the palette is currently shown.
    def visible?: () -> bool

    # Reconcile the palette with the current buffer: open + refilter while +text+
    # is a bare command token (leading +/+, no whitespace yet) with matches,
    # otherwise close. Once the user types a space they've committed to a command
    # and are writing its follow-up message, so the palette gets out of the way —
    # Enter still runs the command (parsed in {#submit}), but there's nothing left
    # to pick. Called on every buffer change; the selection resets to the top
    # match on each refilter (arrow keys don't change the text, so they don't
    # reset it).
    # 
    # _@param_ `text` — the whole input buffer.
    def sync: (String text) -> void

    # Move the selection or dismiss while the palette is open. Called by the
    # input's key forwarder, not by dispatch — the list is unfocused, so movement
    # rides {Tuile::Component::ListDropdown#move} (which forwards to the list
    # regardless of focus); ESC is driver-owned (dismiss), so {#move} never claims
    # it and this does.
    # 
    # _@param_ `key`
    # 
    # _@return_ — true iff the key was consumed here.
    def handle_nav_key: (String key) -> bool

    # Run the command +text+ names, passing the rest of the line as its argument,
    # and echo any outcome to the conversation pane. +"/name the rest"+ splits
    # into the command (resolved: the highlighted row while the palette is open,
    # else an exact first-word match) and +"the rest"+ (+""+ when none), which is
    # handed to the callback — an action command ignores it, a skill command sends
    # it as a follow-up message. A truthy return is echoed below the name; a nil
    # return echoes nothing (the command's own effect — a popup, an agent turn —
    # is the feedback). An unknown command echoes a red "Command not found" and
    # runs nothing. Either way the agent context is never written directly. Closes
    # the palette.
    # 
    # _@param_ `text` — the whole input buffer (must start with +/+).
    def submit: (String text) -> void

    # What {#open} places the palette with.
    def default_placement: () -> (AboveAnchor | AtBottom)

    # Whether the buffer is still a command being *picked*: a leading +/+ with no
    # whitespace yet. A space means the user has moved on to the command's
    # argument, so the palette closes (see {#sync}).
    # 
    # _@param_ `text`
    def picking?: (String text) -> bool

    # Commands whose name starts with the (whole, space-free) buffer.
    # 
    # _@param_ `text`
    def matching: (String text) -> ::Array[Shared::SlashCommand]

    # The text after the command name — the follow-up argument. +""+ when the
    # buffer is a bare command (+"/foo"+ → +""+, +"/foo a b"+ → +"a b"+).
    # 
    # _@param_ `text`
    def remainder: (String text) -> String

    # The command +text+ should run: the highlighted match while open (so a
    # partial name completes to the selection), else an exact first-word match.
    # 
    # _@param_ `text`
    def resolve: (String text) -> Shared::SlashCommand?

    # _@param_ `text`
    # 
    # _@return_ — the leading whitespace-delimited word (the command name).
    def first_word: (String text) -> String

    # A two-column list row: name padded to the widest name in the tool tone,
    # description in the dim detail tone. Padded before coloring so the SGR codes
    # don't throw off the column width.
    # 
    # _@param_ `command`
    # 
    # _@param_ `_width` — the columns the list gives the row, unused — a long description takes the list's trailing ellipsis.
    # 
    # _@return_ — ANSI, parsed by the list.
    def row: (Shared::SlashCommand command, Integer _width) -> String

    # The conversation echo for a run command: its name in the tool tone with the
    # already-colored outcome on the line below. Only called with a real outcome
    # ({#submit} skips the echo entirely when the callback returns nil).
    # 
    # _@param_ `name`
    # 
    # _@param_ `outcome`
    def echo: (String name, String outcome) -> String

    def theme: () -> Shared::AppTheme

    # The input the palette floats above, set by the {Shared::InputPane} that owns
    # it before the first open. When nil (bare use / tests) the palette sits at
    # the screen bottom.
    attr_accessor anchor: Tuile::Component?

    # Places the palette just above +anchor+. The +anchor+ member is the
    # {Tuile::Component::Overlay::Placement} anchor, so the {Tuile::ScreenPane}
    # resolves it — following the input as it moves, and leaving the palette put
    # rather than placing it against nothing once the input is hidden or detached.
    class AboveAnchor < Data
      include Tuile::Component::Overlay::Placement

      # _@param_ `_popup`
      # 
      # _@param_ `screen_size`
      # 
      # _@param_ `anchor_rect` — {#anchor} in screen coordinates, resolved by the pane.
      def rect_for: (Shared::SlashMenuPopup _popup, Tuile::Size screen_size, Tuile::Rect anchor_rect) -> Tuile::Rect

      # Returns the value of attribute anchor
      attr_reader anchor: Object
    end

    # Places the palette just above the bottom screen edge, for the bare use.
    class AtBottom < Data
      include Tuile::Component::Overlay::Placement

      # _@param_ `_popup`
      # 
      # _@param_ `screen_size`
      # 
      # _@param_ `_anchor_rect` — unused: this placement declares no {#anchor}.
      def rect_for: (Shared::SlashMenuPopup _popup, Tuile::Size screen_size, Tuile::Rect? _anchor_rect) -> Tuile::Rect
    end
  end

  # Turns the +@path+ tokens in a prompt line into images for the model, leaving
  # each file's name in the text so a sentence about two images still says which
  # is which:
  # 
  #   text, images = Shared::AttachmentTokens.split("compare @a.png with @'/tmp/my b.png'")
  #   text    # => "compare a.png with my b.png"
  #   images  # => [#<data Pikuri::Attachment filename="a.png" ...>, #<data ... filename="my b.png" ...>]
  # 
  # A token is +@+ at the start of the line or after whitespace, then a path:
  # bare (backslash escapes a space), or single- / double-quoted — the forms a
  # terminal pastes for a dragged file. A +@word+ that names no file and doesn't
  # look like a path (no +/+, no image extension) stays text, so +@alice+ is
  # still a mention; one that does look like a path raises, so a typo never
  # drops an image the user believes was sent. Punctuation trailing a bare token
  # (+"see @shot.png, please"+) belongs to the sentence.
  # 
  # {.token} goes the other way, building a checked token from a path for
  # +/image+ to put in the prompt. Every refusal is an {Error} whose message is
  # ready to show the user.
  module AttachmentTokens
    MAX_BYTES: Integer
    MIMES: ::Array[String]
    TOKEN: Regexp
    IMAGE_EXTENSION: Regexp
    TRAILING_PUNCTUATION: Regexp

    # Splits +line+ into the text to send and the images its tokens name, each
    # file read once.
    # 
    # _@param_ `line` — the prompt as typed.
    # 
    # _@return_ — the text with every
    # attached token replaced by its file's basename, and the images in token
    # order.
    def self.split: (String line) -> [String, ::Array[Pikuri::Attachment]]

    # Checks the file +arg+ names and returns the token that attaches it, quoted
    # when the path needs it — what +/image <path>+ puts in the prompt:
    # 
    #   token("/tmp/shot.png")         # => "@/tmp/shot.png"
    #   token("'/tmp/my shot.png'")    # => "@'/tmp/my shot.png'"   (a dragged file)
    #   token("/tmp/my shot.png")      # => "@'/tmp/my shot.png'"   (unquoted: the whole arg is the path)
    # 
    # _@param_ `arg` — one path, bare, quoted or backslash-escaped.
    # 
    # _@return_ — a token {.split} attaches the same file from.
    def self.token: (String arg) -> String

    # _@param_ `arg` — a path, maybe wrapped in matching quotes.
    # 
    # _@return_ — the path with its quotes or backslash escapes removed.
    def self.unquote: (String arg) -> String

    # Peels sentence punctuation off a bare token, unless the file's name really
    # ends in it.
    # 
    #   split_tail('shot.png,')   # => ["shot.png", ","]
    # 
    # _@param_ `raw` — an unquoted token's path, escapes resolved.
    # 
    # _@return_ — the path and the punctuation behind it.
    def self.split_tail: (String raw) -> [String, String]

    # _@param_ `raw` — a token's path, as typed.
    # 
    # _@return_ — the absolute path; relative ones resolve against the
    # process's working directory.
    def self.expand: (String raw) -> String

    # Reads +path+ once, so the model sees exactly the bytes that were checked.
    # 
    # _@param_ `path` — an existing file.
    def self.load: (String path) -> Pikuri::Attachment

    # A token that names a path which can't be attached. The line it came from
    # should not be sent.
    class Error < StandardError
    end
  end

  # The one-row rule separating the conversation pane from the prompt, carrying
  # the agent's status readout. A busy rule reads:
  # 
  #   ── ⏸ decision — Tab to answer · ‖ Plan Mode · ⠹ ~/work/pikuri-tui · Qwen 3.6 · 2 queued · 25k/60k ──
  #      <parked decision>            <plan mode>   <spinner> <context>  <model>    <queued>   <token stats>
  # 
  # Empty segments drop out (chat never lights the badge; an idle agent shows no
  # spinner) and with nothing at all to say the row is a plain hairline. With the
  # coding shell's sidebar narrowed away, the counts its panes would be carrying
  # stand in here ({#workspace_digest=}):
  # 
  #   ── ⠹ ~/work/pikuri-tui · 3 files +42/-7 · 2/5 tasks · Qwen 3.6 · 25k/60k ──
  # 
  # During a
  # long sub-agent delegation the token slot shows the delegate's own line
  # instead, e.g. +⤷ researcher  8k/60k+, so the readout doesn't freeze while the
  # main agent blocks in the +agent+ tool.
  # 
  # Drive it with the setters and the spinner controls. It also duck-types as an
  # agent listener via {#on_event} — fold it into the agent's +ListenerList+ and
  # it re-points {#current_model} whenever a +run_loop+ model switch lands:
  # 
  #   rule = Shared::StatusRuleLabel.new(token_log: token_log)
  #   rule.current_model = 'Local Qwen 3.6'  # boot model
  #   rule.interloper = agent.interloper     # enables the "N queued" segment
  #   rule.plan_active = true                # lights the badge
  #   rule.start_animation                   # spinner on for a turn; stop_animation after
  #   config.add_listener(rule)              # re-points current_model on a switch
  # 
  # +token_log+ must be the *same* {Pikuri::Agent::Listener::TokenLog} instance
  # wired into the agent — the rule reads its cached +status_line+ rather than
  # subscribing to events itself.
  # 
  # The row paints +:pane_bg+, so it reads as the top edge of the tinted block
  # the {Shared::InputPane} continues rather than as a divider on the terminal
  # ground — the transcript above it is the one untinted pane.
  # 
  # This is a component rather than the presenter it grew out of: with the pane
  # frames gone there is no border footer chrome to drive, the rule is an
  # addressable row of its own, and owning the widget is what buys the
  # width-aware +─+ fill (painted in {#repaint}) and the light/dark re-render
  # (+handle_theme_changed+) for free.
  # 
  # Shared by all three shells.
  # 
  # UI-thread-confined, with exceptions ({#on_event} and the token-log observer
  # both self-marshal).
  class StatusRuleLabel < Tuile::Component::Label
    SPINNER: ::Array[String]
    FRAME_INTERVAL_S: Float
    LEAD: Integer

    # Claims the +token_log.on_status_line+ observer slot.
    # 
    # _@param_ `token_log` — the agent's token log; must be the *same* instance wired into the agent (see class docs).
    # 
    # _@param_ `names` — {Shared::Model::Choice.key} → display name, used to resolve a transport passed to {#current_model=}; transports absent from the map render as their raw model id.
    # 
    # _@param_ `context` — a static leading segment naming what the agent is pointed at — the coding shell passes its project root, the chat and computer shells nothing. Unlike every other segment it never changes, so it is a constructor argument rather than a setter.
    def initialize: (token_log: Pikuri::Agent::Listener::TokenLog, ?names: ::Hash[[String, String, ::Hash[untyped, untyped]], String], ?context: String?) -> void

    # Start the mid-turn spinner ticker; idempotent.
    def start_animation: () -> void

    # Stop the spinner ticker and settle the rule back to idle; idempotent.
    def stop_animation: () -> void

    # Agent-listener entry point (duck-typed — the rule plays the listener role
    # without subclassing +Pikuri::Agent::Listener::Base+): on a +run_loop+ model
    # switch ({Pikuri::Agent::Event::ModelSwitched}), re-points {#current_model}
    # to the switched-to transport; ignores every other event. Fold the rule into
    # the agent's +ListenerList+ for this.
    # 
    # Safe from any thread: invoked on the agent's worker thread, it marshals the
    # {#current_model=} back onto the UI thread via +screen.event_queue.submit+.
    # 
    # _@param_ `event` — any agent event; only {Pikuri::Agent::Event::ModelSwitched} is acted on.
    def on_event: (Data event) -> void

    # _@return_ — short label used by +Pikuri::Agent#to_s+ when the rule
    # is in its +ListenerList+.
    def to_s: () -> String

    # Paints the readout, then the hairline out to the right edge (the whole row
    # with no readout) — ink, not text, because only at paint time is the width
    # settled.
    # 
    # _@param_ `canvas`
    def repaint: (Tuile::Canvas canvas) -> void

    # Re-renders against the new {Tuile::Screen#theme}, already in place when
    # this fires: the lead hairline and every segment tone are baked into the text.
    def handle_theme_changed: () -> void

    # Resolve a transport to its friendly connection name via +names+, falling
    # back to the raw model id when the +[model, api_base]+ pair isn't mapped.
    # 
    # _@param_ `transport`
    def display_name: (Pikuri::Agent::ChatTransport transport) -> String

    # +TokenLog#on_status_line+ observer: stash a sub-agent's pushed line
    # (+id+ non-empty) for {#refresh} to show, or clear the stash on a
    # main-agent or empty line. We stash rather than poll because a sub-agent's
    # +TokenLog+ is a separate instance {#refresh} can't reach.
    # 
    # Safe from any thread: the push arrives on the agent-loop thread, so it
    # marshals the stash and {#refresh} onto the UI thread via +submit+.
    # 
    # _@param_ `id` — owning agent's id; +""+ for the main agent.
    # 
    # _@param_ `status_line` — the freshly formatted line.
    def on_status_line: (String id, String status_line) -> void

    # Rebuild the text from the current state: {LEAD} hairline columns, then the
    # readout (badge, spinner, queued count, token line) padded by a space on
    # each side; {#repaint} fills the rest of the row. With an empty readout the
    # text is empty and the row is one unbroken hairline.
    def refresh: () -> void

    # _@param_ `width` — how many columns to fill; non-positive yields an empty string (a rule narrower than its own readout simply stops).
    # 
    # _@return_ — +width+ hairline columns in the +:pane_frame+
    # tone — the hairline derived for the +:pane_bg+ this row paints.
    def hairline: (Integer width) -> Tuile::StyledString

    # The status readout: the badges (notice-toned, so they pop against the dim
    # chrome) leading a hint-toned tail of spinner / model / queue / tokens. Any
    # part may be empty.
    # 
    # _@return_ — +nil+ when there is nothing to say.
    def build_readout: () -> Tuile::StyledString?

    # _@return_ — the lit badges, most urgent first: a
    # parked decision outranks the plan-mode posture.
    def badges: () -> ::Array[Tuile::StyledString]

    # _@return_ — the plain (uncolored) spinner + segment tail.
    def tail_text: () -> String

    # _@return_ — zero to two tail segments — the files count, the
    # tasks tally — as {WorkspaceDigest} describes them.
    def digest_segments: () -> ::Array[String]

    # _@param_ `digest`
    # 
    # _@return_ — +"3 files +42/-7"+ — the +/+ pairing the counts the way the
    # coding shell's own change summary does.
    def files_segment: (WorkspaceDigest digest) -> String

    # The agent's mid-loop input queue; its +#size+ drives the "N queued"
    # segment. +nil+ until the host wires one.
    attr_accessor interloper: Pikuri::Agent::Control::Interloper?

    # Display name shown as the readout's leading segment (after any badge);
    # +nil+/empty renders no model segment.
    attr_accessor current_model: (String | Pikuri::Agent::ChatTransport)?

    # Whether the agent is in plan mode; when +true+ the readout leads with a
    # notice-toned "‖ Plan Mode" badge.
    attr_accessor plan_active: bool

    # Whether a tool is parked waiting for a human answer in the transcript. It
    # leads the readout because the turn cannot proceed until it is answered.
    attr_accessor decision_pending: bool

    # _@return_ — the counts currently standing in for
    # off-screen panes; +nil+ (the default) renders no segments.
    attr_accessor workspace_digest: WorkspaceDigest?

    # What {#workspace_digest=} takes: the counts a workspace pane would be
    # showing if one were on screen. Renders as up to two segments —
    # +3 files +42/-7+ and +2/5 tasks+ — each dropping out when its own count is
    # zero, so a clean tree with no tasks adds nothing to the rule. A files count
    # whose line counts are both zero (a mode-only diff) renders bare: +2 files+.
    class WorkspaceDigest < Data
      # Returns the value of attribute files
      attr_reader files: Object

      # Returns the value of attribute added
      attr_reader added: Object

      # Returns the value of attribute deleted
      attr_reader deleted: Object

      # Returns the value of attribute tasks_done
      attr_reader tasks_done: Object

      # Returns the value of attribute tasks_total
      attr_reader tasks_total: Object
    end
  end

  # Paints a +Pikuri::Trifecta::Report+ for the conversation pane: the advisory
  # toned by verdict, the map below it untoned — it is a table of facts, and
  # coloring it would compete with the one line that carries the meaning.
  # 
  #   Shared::TrifectaRenderer.render(agent.trifecta, theme: screen.theme)
  # 
  #   [TRIFECTA: HARD] pikuri-tui-code — private(read, grep, glob, bash) +   <- red on :loud,
  #   untrusted(read, grep, glob, bash, skill) + egress(bash). An injection      yellow on :soft,
  #   in what this agent reads can drive an exfiltration. Break a leg: ...       dim on :silent
  # 
  #   pikuri-tui-code [:private, :untrusted_hard, :egress]
  #     read [:private, :untrusted_hard]
  #     ...
  #     researcher [gate: unreviewed] [:untrusted_hard, :egress]
  #       fetch [:untrusted_hard, :egress]
  # 
  # Nothing here wraps: the advisory is one long hard line, left to the
  # +TextView+ to word-wrap at the pane width. Its closing "See
  # book/trifecta-detector.md in this repo" points at *pikuri's* repo, where that
  # chapter lives, and is passed through unedited.
  module TrifectaRenderer
    # Render the whole report — advisory line, blank line, map.
    # 
    # _@param_ `report` — a walked report, normally +agent.trifecta+.
    # 
    # _@param_ `theme` — supplies the verdict tone; taken as an argument, so this renders (and tests) without a {Tuile::Screen}.
    # 
    # _@return_ — ANSI, newline-separated, no trailing newline — ready for
    # {Shared::ConversationTextView#add_block}.
    def self.render: (Pikuri::Trifecta::Report report, theme: Shared::AppTheme) -> String

    # _@param_ `verdict` — +:silent+, +:soft+ or +:loud+.
    # 
    # _@param_ `text` — the advisory line.
    # 
    # _@param_ `theme`
    # 
    # _@return_ — ANSI-toned text.
    def self.tone: (Symbol verdict, String text, Shared::AppTheme theme) -> String
  end

  # A borderless pane's caption row: the pane's name in the theme's
  # {Shared::AppTheme::TALUS} hint accent, then a hairline rule filling the rest
  # of the width.
  # 
  #   Tasks ──────────────────────
  # 
  # The borderless stand-in for the caption a {Tuile::Component::Panel} paints
  # into its top border. The rule half is what keeps the row reading as a
  # *boundary* — without it a bare word floating above content reads as a list
  # item, not a section head.
  # 
  #   caption = Shared::PaneCaptionLabel.new('Tasks')
  #   pane.add(caption, Fixed[1])
  #   caption.caption = 'Tasks: 2/5'   # a pane carrying a live count re-labels it
  #   caption.caption = Tuile::StyledString.plain('Changes: 13; ') +
  #                     Tuile::StyledString.styled('+147', fg: theme[:added])
  # 
  # The accent is filled *under* the caption rather than painted over it, so the
  # toned half of that tally survives and only the prose picks the accent up.
  # 
  # The hairline is +:pane_frame+, derived for the tinted +:pane_bg+ ground every
  # captioned pane sits on. There is no token parameter: every borderless
  # surface in these shells that carries chrome is a tinted secondary — the one
  # untinted pane, the transcript, has no caption and no rule.
  # 
  # UI-thread-confined.
  class PaneCaptionLabel < Tuile::Component::Label
    # _@param_ `caption` — the pane's name.
    def initialize: ((String | Tuile::StyledString) caption) -> void

    # Paints the caption, then the hairline out to the right edge — ink, not
    # text, because only at paint time is the width settled. A width too narrow
    # for the rule drops it.
    # 
    # _@param_ `canvas`
    def repaint: (Tuile::Canvas canvas) -> void

    # Re-renders against the new {Tuile::Screen#theme}: the caption's tone is
    # baked into the label's text.
    def handle_theme_changed: () -> void

    # Rebuilds the caption text in the hint accent; {#repaint} adds the rule (the
    # {Tuile::Component::Label} ellipsizes the caption itself).
    def refresh: () -> void

    # _@return_ — the pane's name, as set.
    attr_accessor caption: (String | Tuile::StyledString)
  end

  # The conversation transcript as one cohesive Tuile component: a
  # {Tuile::Component::TextView} that renders an agent conversation into itself —
  # user turns, streamed reasoning, streamed assistant answers, tool calls, tool
  # observations, cancellation markers. The host folds the listener it exposes
  # into the agent:
  # 
  #   pane = Shared::ConversationTextView.new
  #   config.add_listener(pane.listener)   # into the agent's ListenerList
  # 
  # This is the app's *primary* pane, so it is deliberately unframed and
  # untinted: it keeps the terminal's own background, and the surfaces around it
  # — the {Shared::StatusRuleLabel} below it, the {Shared::InputPane} below that,
  # the coding shell's sidebar beside it — are the tinted secondaries that set it
  # off. The agent status it used to carry in its bottom border now lives on the
  # rule, which is a sibling row the shell's +Layout+ owns.
  # 
  # The pikuri seam lives in the nested {Listener}, not on the pane: this
  # component exposes UI verbs ({#add_block}, {#open_assistant_block},
  # {#render_markdown}, …) and knows nothing about +Pikuri::Agent::Event+. The
  # {Listener} is the sole translator from the event stream into those verbs.
  # 
  # == State ownership
  # 
  # The pane itself is *stateless* with respect to a conversation's progress: it
  # holds no "currently-open block" cursor. Each {Listener} carries its own
  # open-stream state (two {Shared::StreamedBlock}s — assistant and thinking —
  # plus the tool-call/result pairing) and drives the pane's stateless verbs.
  # That is what lets a sub-agent be "another thin listener with a bigger indent"
  # writing into this same pane without sharing the parent's open blocks (see
  # {Listener#for_sub_agent}).
  # 
  # *Display* state is the pane's own, though: {#pending_decision}, because the
  # pane is what the answering keys arrive at, and the display flags below with
  # their block register, because a flag on a listener would be copied into every
  # sub-agent sibling at mint time and go stale.
  # 
  # == Asking a human decision
  # 
  #   conversation.pending_decision = decision      # body + "(y) approve …"
  #   # user Tabs here (the prompt's caret vanishes — that is the focus cue),
  #   # presses y; decision.on_choice fires with :approve
  #   conversation.settle_pending_decision('approved')
  # 
  # The answer keys are armed by *focus*: they only answer while this pane holds
  # it. That is the whole safety property — prose typed at the prompt is a
  # different focus target, so no amount of typing can answer a question the user
  # has not looked at.
  # 
  # == Display flags
  # 
  # Two flags reshape what is already in the transcript, not just what arrives
  # next. {#tool_detail=} picks a tool line's form:
  # 
  #   Bash(rm -rf build)                      # :short — the tool's own summary
  #     Error: exit 1: rm: cannot remove 'build'
  #   → bash(command="rm -rf build")          # :verbose — the argument dump
  #     = rm: cannot remove 'build': Permis…
  # 
  # and {#show_thinking=} shows or hides every reasoning block. Both work by
  # re-running each affected block's thunk ({#add_kinded_block}), because both
  # answer a *retrospective* question — "that call looked wrong, show me its
  # arguments". Never reach for +#clear+ plus a replay instead: +#clear+ drops
  # the region a parked {#pending_decision} is asking in, so the question would
  # vanish while the tool thread stays blocked on its answer.
  # 
  # A flag reaches only what was filed under its kind, and the roster of kinds —
  # +:tool+ and +:thinking+, nothing else — is the whole statement of what a
  # reader may *not* turn off: user echoes, assistant prose, +⊕+ injections, +!+
  # notices, cancel markers, a {Shared::PendingDecision}'s block (a parked
  # decision blocks the turn, so it stays loud) and the +edit+ / +write+ diffs (a
  # diff is reviewed, not skimmed) are all rendered unkinded on purpose. Filing
  # one of those under a kind is what a new toggle must not do.
  # 
  # Neither flag keeps scroll bookkeeping: Tuile clamps +scroll_top_row+ on every
  # region rewrite and re-tails a following view, so collapsing a screenful under
  # a scrolled-up reader lands where it should.
  # 
  # Hiding reasoning skips only its *rendering*: the block still opens where the
  # reasoning streamed and collects it, so a reveal draws it in place — above the
  # answer — instead of wherever its +Thinking+ bookend happened to land. The one
  # cost: a reveal mid-stream draws the prefix collected so far and then stops
  # growing, and the block catches up on the next toggle.
  # 
  # == Markdown flag
  # 
  # +markdown:+ (default +true+) gates the assistant render path: when off, the
  # assistant streaming path uses {Shared::Markdown::PassthroughBuffer} and
  # {#render_markdown} returns its input verbatim. The thinking pane's grayscale
  # repaint is independent of the flag — a +markdown: false+ reasoning block
  # renders through a recolor-only function, so the gray tint survives.
  # 
  # UI-thread-confined, with exceptions (the nested {Listener} marshals the event
  # stream onto the UI thread before driving these verbs; {#render_turn_error} is
  # safe off-thread and self-marshals).
  class ConversationTextView < Tuile::Component::TextView
    TOOL_DETAIL_MODES: ::Array[Symbol]
    LEAVE_KEYS: ::Array[String]
    BAR_COLUMNS: Integer
    LOG: Logger

    # _@param_ `markdown` — when +true+ (the default), assistant content is rendered through {Shared::Markdown::Renderer}; when +false+, echoed verbatim and streamed through {Shared::Markdown::PassthroughBuffer}. The thinking path always recolors to gray.
    # 
    # _@param_ `show_thinking` — whether reasoning blocks start shown.
    # 
    # _@param_ `tool_detail` — the {TOOL_DETAIL_MODES} form to start on.
    # 
    # _@param_ `tool_formatters` — per-tool-name formatters that replace the default +Name(argument)+ / summary rendering for those tools (the +edit+ / +write+ diff views). Defaults to +{}+.
    def initialize: (
                      ?markdown: bool,
                      ?show_thinking: bool,
                      ?tool_detail: Symbol,
                      ?tool_formatters: ::Hash[String, untyped]
                    ) -> void

    # Fired with an {EscapeEvent} when the user leaves this pane
    # ({LEAVE_KEYS}) — normally "put focus back on the prompt".
    # 
    # **Empty means the pane declines those keys**, so they fall through
    # unclaimed and the event loop stops on them.
    def on_escape: () -> Tuile::Listeners

    # _@return_ — the screen's current theme (re-read each call so an
    # OS light/dark flip is picked up).
    def theme: () -> Tuile::Theme

    # Render width for a fresh block: the pane's width less {BAR_COLUMNS} whether
    # or not the +:auto+ bar is showing yet. A block is rendered once, so one
    # rendered at the full width would rewrap — a padded diff bar into two rows —
    # the moment the transcript overflows and the bar takes its columns. Floored
    # at 1 so a not-yet-laid-out pane doesn't pass a non-positive width to
    # {Shared::Markdown::Renderer}.
    def buffer_width: () -> Integer

    # Append one logical block to the pane: create a fresh region and assign
    # +text+ (prefixed with +indent+ spaces on its first line). Each
    # non-streaming event lands as exactly one such block.
    # 
    # _@param_ `text` — the block's content.
    # 
    # _@param_ `indent` — leading spaces on the block's first line.
    def add_block: ((String | Tuile::StyledString) text, ?indent: Integer) -> void

    # Append a block that can be redrawn later: +render+ is a zero-arg thunk
    # producing the block's text, filed under +kind+ so {#rerender} can re-run it
    # when the form it draws changes.
    # 
    #   view.add_kinded_block(kind: :tool, indent: @indent) do
    #     short? ? short_call_line(name, arguments) : verbose_call_line(name, arguments)
    #   end
    # 
    # Closing over the event's content is what makes a redraw pick up the pane's
    # *current* width, theme and flags. A thunk answers only "what does this block
    # say" — whether the kind is currently hidden is the pane's business, and a
    # hidden one is never called.
    # 
    # _@param_ `kind` — the redraw group.
    # 
    # _@param_ `indent` — leading spaces on the block's first line.
    def add_kinded_block: (kind: Symbol, ?indent: Integer) ?{ () -> (String | Tuile::StyledString) } -> void

    # Redraw every block of +kind+ from its thunk, in place.
    # 
    # _@param_ `kind`
    def rerender: (kind: Symbol) -> void

    # _@return_ — the reasoning visibility now in force.
    def toggle_thinking: () -> bool

    # Apply a +/thinking+ argument — +on+ / +off+, or blank to toggle — and report
    # what happened for the command to echo.
    # 
    #   conversation.select_thinking('off')   # => "Thinking hidden for this session …"
    # 
    # The echo names the config key, since a flip lasts only for the session.
    # 
    # _@param_ `argument` — the rest of the typed line.
    # 
    # _@return_ — the outcome line.
    def select_thinking: (String argument) -> String

    # Switch to the next {TOOL_DETAIL_MODES} entry, wrapping around.
    # 
    # _@return_ — the form now in force.
    def toggle_tool_detail: () -> Symbol

    # Apply a +/tools+ argument — a {TOOL_DETAIL_MODES} name, or blank to toggle
    # — and report what happened for the command to echo.
    # 
    #   conversation.select_tool_detail('verbose')   # => "Tool lines: verbose."
    #   conversation.select_tool_detail('')          # => "Tool lines: short."
    #   conversation.select_tool_detail('loud')      # => "No tool-line form …"
    # 
    # _@param_ `argument` — the rest of the typed line.
    # 
    # _@return_ — the outcome line.
    def select_tool_detail: (String argument) -> String

    # Open a fresh streamed assistant block: a new region plus the streaming
    # buffer writing into it — a {Shared::Markdown::StreamingBuffer} (Markdown →
    # ANSI) when +@markdown+, else a {Shared::Markdown::PassthroughBuffer}. The
    # render proc snapshots the width + terminal scheme at build time (one buffer
    # per block), so an appearance flip mid-block keeps the scheme it started
    # with. Drives a {Shared::StreamedBlock}.
    # 
    # _@param_ `indent` — leading spaces baked into the render proc.
    # 
    # _@return_ — the region and
    # its streaming buffer.
    def open_assistant_block: (?indent: Integer) -> [Tuile::Component::TextView::Region, untyped]

    # Twin of {#open_assistant_block} for the reasoning pane, tinted gray in both
    # Markdown modes: the render is {Shared::Markdown::Renderer}→recolor when
    # Markdown is on, recolor-only when off. The reasoning tone is snapshot at
    # build time, like the width.
    # 
    # Hidden reasoning still opens its region — so the block holds the place the
    # reasoning *streamed* at, not the place its +Thinking+ bookend arrives at,
    # which is after the answer — but takes a
    # {Shared::Markdown::CollectingBuffer}: the deltas pile up unrendered until a
    # reveal.
    # 
    # The region registers as a +:thinking+ block whose thunk re-renders the
    # buffer's own +#source+ — which is what lets {#show_thinking=} reach
    # reasoning that already streamed, whether its buffer went on to be finalized,
    # preserved, or is still open.
    # 
    # _@param_ `indent` — leading spaces baked into the render proc.
    # 
    # _@return_ — the region and
    # its streaming buffer.
    def open_thinking_block: (?indent: Integer) -> [Tuile::Component::TextView::Region, untyped]

    # Render assistant Markdown for the pane, degrading to the raw string when
    # the renderer raises — LLM output is arbitrary and a kramdown / rouge
    # surprise shouldn't abort an in-flight conversation on a long-running TUI.
    # A no-op returning +content+ unchanged when +@markdown+ is false.
    # 
    # _@param_ `content` — assistant Markdown
    # 
    # _@return_ — rendered ANSI text, or +content+ on failure / when
    # Markdown is off.
    def render_markdown: (String content) -> String

    # Render a non-streamed reasoning bookend: the Markdown render recolored to
    # the theme's single muted reasoning tone (structure preserved). Used when a
    # {Pikuri::Agent::Event::Thinking} arrives with no preceding deltas.
    # 
    # _@param_ `content` — reasoning Markdown
    # 
    # _@return_ — gray-toned ANSI text
    def render_thinking: (String content) -> String

    # Append a one-line, error-themed turn-failure notice to the transcript.
    # Safe to call from the agent worker thread; marshals its own append onto
    # the event-loop thread.
    # 
    # _@param_ `exception` — the caught library exception.
    def render_turn_error: (StandardError exception) -> void

    # Append a one-line, muted informational notice to the transcript — the dim
    # sibling of {#render_turn_error}, same self-marshaling shape but the detail
    # tone, so a non-failure (e.g. a bare skill-load with nothing to send yet)
    # never reads as an error. Safe to call from the agent worker thread.
    # 
    # _@param_ `text` — the notice, plain; this applies the tone.
    def render_notice: (String text) -> void

    # Rewrite the asked decision's cue line as +text+, the record of how it went,
    # and disarm its keys. Repeatable: an outcome reached in two steps (reject,
    # then a typed reason) settles once per step.
    # 
    #   conversation.settle_pending_decision('approved')   # · approved
    # 
    # _@param_ `text` — the outcome, plain; this applies the tone.
    def settle_pending_decision: (String text) -> void

    # Claims the asked decision's keys, then {LEAVE_KEYS}, then falls back to
    # {Tuile::Component::TextView}'s scroll ladder.
    # 
    # _@param_ `key`
    # 
    # _@return_ — +true+ if the key was consumed here.
    def handle_key?: (String key) -> bool

    # Drops every region, the asked decision's and the redrawable blocks'
    # included.
    def clear: () -> void

    # Draw one registered block, or collapse it to nothing when its kind is
    # hidden.
    # 
    # _@param_ `block`
    def draw_kinded: (KindedBlock block) -> void

    # _@param_ `kind`
    def hidden_kind?: (Symbol kind) -> bool

    # _@param_ `shown`
    # 
    # _@return_ — the +/thinking+ echo, naming the key that makes it stick.
    def thinking_outcome: (bool shown) -> String

    # _@param_ `key`
    # 
    # _@return_ — whether the key picked an outcome for the asked decision.
    def choose: (String key) -> bool

    # Rewrite the decision block as its body over +tail+.
    # 
    # _@param_ `tail` — the toned cue or outcome line.
    def write_decision: (String tail) -> void

    # Prepend +indent+ spaces to a block, handling both +String+ blocks (theme
    # helpers, rendered markdown) and +Tuile::StyledString+ blocks (the diff
    # formatters). The pad lands on the first line only.
    # 
    # _@param_ `text`
    # 
    # _@param_ `indent`
    def indent_block: ((String | Tuile::StyledString) text, Integer indent) -> (String | Tuile::StyledString)

    # Wrap a +String -> String+ render proc so its output carries +indent+ spaces
    # on the first line. A no-op (returns the proc unchanged) for the main agent.
    # The {Shared::Markdown::StreamingBuffer}'s commit-probe sentinel is
    # unaffected: the pad lands on the first line, the sentinel on the last.
    # 
    # _@param_ `render`
    # 
    # _@param_ `indent`
    def indent_render: (untyped render, Integer indent) -> untyped

    # A callable snapshotting the current {#buffer_width} + terminal scheme,
    # routing through {Shared::Markdown::Renderer.render}.
    def build_markdown_renderer: () -> Proc

    # Whether the pane is on a dark terminal background, so
    # {Shared::Markdown::Renderer} can pick a legible code-highlighting theme.
    # The screen holds {Shared::AppTheme::DARK} or {Shared::AppTheme::LIGHT}
    # resolved against its background (their tints are derived tokens), so
    # equality against +LIGHT+ resolved the same way is the live scheme — a
    # transient +Tuile::Screen#theme=+ included, which
    # +Tuile::Screen#color_scheme+ would miss.
    def dark_scheme?: () -> bool

    # _@return_ — the transcript listener bound to this pane, created once
    # at construction. The host includes it in the agent's +ListenerList+;
    # pikuri mints indented siblings off it via {Listener#for_sub_agent}.
    attr_reader listener: Listener

    # _@return_ — the decision this pane is currently
    # asking, +nil+ when there is none. While set, {#handle_key?} claims that
    # decision's keys.
    attr_accessor pending_decision: Shared::PendingDecision?

    # _@return_ — the per-tool
    # formatters, consulted by the {Listener} on each tool call.
    attr_reader tool_formatters: ::Hash[String, untyped]

    # _@return_ — the tool-line form currently drawn, one of
    # {TOOL_DETAIL_MODES}.
    attr_accessor tool_detail: Symbol

    # _@return_ — whether reasoning blocks are currently drawn.
    attr_accessor show_thinking: bool

    # What {#on_escape} fires.
    # 
    # @!attribute [r] source
    #   @return [Shared::ConversationTextView] the pane the user is leaving.
    class EscapeEvent < Data
      include Tuile::Event

      # _@return_ — the pane the user is leaving.
      attr_reader source: Shared::ConversationTextView
    end

    # One redrawable block: its region, the redraw group it belongs to, the
    # indent to re-apply, and the thunk producing its text.
    class KindedBlock < Data
      # Returns the value of attribute region
      attr_reader region: Object

      # Returns the value of attribute kind
      attr_reader kind: Object

      # Returns the value of attribute indent
      attr_reader indent: Object

      # Returns the value of attribute render
      attr_reader render: Object
    end

    # Translates a +Pikuri::Agent+'s normalized event stream into
    # {Shared::ConversationTextView} render calls — the Tuile-targeted equivalent of
    # +Pikuri::Agent::Listener::Terminal+, rendering into the conversation pane
    # instead of stdout.
    # 
    # This holds the per-conversation *state* the pane deliberately does not: two
    # {Shared::StreamedBlock}s (the open assistant and thinking blocks, each a
    # region + streaming buffer), the streamed-thinking flag, and the
    # tool-call/result pairing slot. Everything visual is delegated to the pane's
    # stateless verbs. Because the state lives here (not on the shared pane), a
    # sub-agent listener minted by {#for_sub_agent} renders into the same pane
    # with its own independent open blocks.
    # 
    # == Variant coverage
    # 
    # Mirrors the terminal listener with four intentional departures:
    # 
    # 1. {Pikuri::Agent::Event::UserTurn} renders as +"> #{content}"+, plus a dim
    #    +📎+ line per image, instead of staying silent — submitting clears the
    #    input, so without an echo the user's message would vanish.
    # 2. Library failures during rendering are caught + logged (by the pane's
    #    {#render_markdown}), never raised — an uncaught raise on the worker
    #    thread would kill the agent loop.
    # 3. Streaming deltas ({Pikuri::Agent::Event::AssistantDelta} /
    #    {Pikuri::Agent::Event::ThinkingDelta}) render incrementally through a
    #    per-block streaming buffer; the thinking buffer recolors to one muted
    #    tone. A trailing bookend ({Pikuri::Agent::Event::Assistant} /
    #    {Pikuri::Agent::Event::Thinking}) finalizes the open buffer (replacing
    #    the preview if the delta stream was truncated) or, with no deltas,
    #    renders directly.
    # 4. Tool lines default to the short +Bash(rm -rf build)+ /
    #    +Returned 3 lines+ pair — the strings the *tool* composed, styled and
    #    capped here. The terminal listener's argument dump survives as the
    #    pane's +:verbose+ form.
    # 
    # +Tokens+ / +ContextCap+ stay silent (their consumer is
    # +Pikuri::Agent::Listener::TokenLog+).
    # 
    # {#on_event} fires on the agent's worker thread and wraps the whole dispatch
    # in +screen.event_queue.submit+, so every region mutation runs on the
    # event-loop thread under the UI lock; the queue is FIFO, so events still land
    # in order.
    class Listener < Pikuri::Agent::Listener::Base
      SUB_AGENT_INDENT: Integer
      TOOL_RESULT_INDENT: Integer
      TOOL_ARGUMENT_MAX_CHARS: Integer
      TOOL_SUMMARY_MAX_CHARS: Integer
      MAX_TOOL_RESULT_CHARS: Integer

      # _@param_ `view` — the pane this listener renders into. Lifetime owned by the pane; the listener neither constructs nor destroys it.
      # 
      # _@param_ `screen` — the screen whose +event_queue+ marshals UI mutations back from the worker thread. Passed explicitly so the listener can be unit-tested with a {Tuile::FakeScreen}.
      # 
      # _@param_ `indent` — leading spaces prepended to every block (0 for the main agent, {SUB_AGENT_INDENT} on a {#for_sub_agent} sibling).
      def initialize: (view: Shared::ConversationTextView, screen: Tuile::Screen, ?indent: Integer) -> void

      # Dispatch one event to the pane, marshaled onto the event-loop thread so
      # the downstream region mutations execute under the UI lock.
      # 
      # _@param_ `event` — any agent event (a +Pikuri::Agent::Event+ variant).
      def on_event: (Data event) -> void

      # _@return_ — short label used by +Pikuri::Agent#to_s+.
      def to_s: () -> String

      # Mint a sub-agent sibling rendering into the *same* pane, indented one
      # {SUB_AGENT_INDENT} deeper (dispatched by
      # +Pikuri::Agent::ListenerList#for_sub_agent+ when the +agent+ tool spawns a
      # delegate). It carries its own open-stream state — the parent's buffers are
      # flushed before the tool call runs and the parent is blocked until the
      # delegate returns, so there is nothing to clobber.
      def for_sub_agent: () -> Listener

      # The actual case dispatch. Runs on the event-loop thread (via {#on_event}'s
      # +submit+) so every region mutation is under the UI lock.
      # 
      # _@param_ `event` — any agent event (a +Pikuri::Agent::Event+ variant).
      def dispatch_event: (Data event) -> void

      # Render a {Pikuri::Agent::Event::SystemInjected} body — dim, with a ⊕
      # marker, mirroring +Pikuri::Agent::Listener::Terminal+ — collapsing the two
      # skill-shaped ones:
      # 
      #   ⊕ loaded skill: writing-rdoc      # was a whole SKILL.md body
      #                                     # a promotion block renders nothing
      # 
      # Both are XML-wrapped payloads sized for the model, and pasting either
      # verbatim buries the transcript under a screenful the human didn't ask for.
      # A promotion is dropped outright rather than summarized because the host
      # that promoted it announces its own line — one carrying the matched path
      # this block has no room for.
      # 
      # _@param_ `content` — the injected block.
      def render_system_injection: (String content) -> void

      # Render a {Pikuri::Agent::Event::ToolCall}. A registered formatter for
      # +name+ takes precedence and is stashed so the paired result routes back to
      # it; a missing / declining formatter goes in as a redrawable block picking
      # its form off {Shared::ConversationTextView#tool_detail}, and clears the
      # pending slot.
      # 
      # _@param_ `name` — the registered tool name.
      # 
      # _@param_ `arguments` — the raw tool-call arguments.
      # 
      # _@param_ `display_name` — the tool's own +Bash+ / +WebSearch+ label.
      # 
      # _@param_ `argument` — the tool's own one-argument description.
      def render_tool_call: (
                              name: String,
                              arguments: ::Hash[untyped, untyped],
                              display_name: String,
                              argument: String
                            ) -> void

      # Render a {Pikuri::Agent::Event::ToolResult}. When the paired call was
      # formatter-handled, route to its +render_result+ (which returns +nil+ to
      # suppress a redundant success line, or a string for an error); otherwise a
      # redrawable block indented under the call it answers.
      # 
      # _@param_ `content` — the observation the model reads.
      # 
      # _@param_ `summary` — the tool's own one-line status.
      def render_tool_result: (content: String, summary: String) -> void

      # _@return_ — whether the pane is currently drawing tool lines short.
      def short?: () -> bool

      # The +:short+ call line for a tool with no formatter of its own:
      # 
      #   Bash(rm -rf build)
      #   EnterPlanMode               # empty argument, so no parentheses
      # 
      # _@param_ `display_name` — +Pikuri::Tool#display_name+.
      # 
      # _@param_ `argument` — +Pikuri::Tool#describe_call+.
      # 
      # _@return_ — the toned line.
      def short_call_line: (String display_name, String argument) -> String

      # The +:short+ result line for a tool with no formatter of its own — dim,
      # or error-toned when the summary reports a failure:
      # 
      #   Returned 23 search results
      #   Error: exit 1: rm: cannot remove 'build'
      # 
      # The +Error:+ test reads the tool's own status rather than guessing at the
      # observation: pikuri composes that prefix in +Tool::Result.error+.
      # 
      # _@param_ `summary` — +Pikuri::Agent::Event::ToolResult#summary+.
      # 
      # _@return_ — the toned line.
      def short_result_line: (String summary) -> String

      # The +:verbose+ call line — the terminal listener's argument dump,
      # +→ bash(command="rm -rf build")+. The arguments skip {#safe} because
      # +inspect+ already escapes them.
      # 
      # _@param_ `name`
      # 
      # _@param_ `arguments`
      # 
      # _@return_ — the toned line.
      def verbose_call_line: (String name, ::Hash[untyped, untyped] arguments) -> String

      # The +:verbose+ result line — the observation itself, += rm: cannot …+.
      # 
      # _@param_ `content`
      # 
      # _@return_ — the toned line.
      def verbose_result_line: (String content) -> String

      # Flatten whitespace and cap to {MAX_TOOL_RESULT_CHARS}. Long results
      # (rendered HTML, PDF text) would otherwise drown the transcript; the
      # byte-count suffix distinguishes "tool returned exactly this" from "tool
      # returned much more."
      # 
      # _@param_ `content` — tool observation
      # 
      # _@return_ — single-line display form, possibly truncated
      def truncate_tool_result: (String content) -> String

      # Neutralize model-composed text and flatten it to one line. Every path that
      # prints a tool value raw owes the transcript this call: a filename carrying
      # +ESC[+ recolors everything after it otherwise.
      # 
      # _@param_ `text`
      def safe: (String text) -> String

      # The dim line under a user turn for each image it showed the model:
      # 
      #   > shot.png what's wrong here?
      #   📎 shot.png (image/png, 48.3 kB)
      # 
      # _@param_ `attachment`
      # 
      # _@return_ — the toned line.
      def attachment_line: (Pikuri::Attachment attachment) -> String

      # Elide +text+ to +limit+ characters, ellipsis included. Applied after
      # {#safe} so a cut can't land inside an escaped +\xNN+ token.
      # 
      # _@param_ `text`
      # 
      # _@param_ `limit`
      def cap: (String text, Integer limit) -> String

      # Wipe the pane and drop every per-turn render handle on
      # {Pikuri::Agent::Event::Reset} (the host cleared the conversation). The
      # pane is cleared (detaching all regions, including any open buffers'), then
      # both blocks are +preserve+d — dropping their now-detached handles without
      # a second +region.remove+ — and the streaming / pairing slots reset to
      # construction state.
      def reset_conversation: () -> void
    end
  end

  # The screen's content component: a shell's pane layout with the
  # {Shared::StatusBar} on the last row.
  # 
  #   screen.content = Shared::RootLayout.new(Chat::Layout.new(...), status_bar)
  # 
  # Tuile draws no status bar and reserves no row for one (its +DECISIONS.md+
  # +D-status-bar+), so the bottom line is a component the app has to place
  # itself — which is all this layout is: the shell takes every row the bar
  # doesn't, the bar takes exactly one.
  # 
  # UI-thread-confined.
  class RootLayout < Tuile::Component::Layout::Vertical
    # _@param_ `shell` — the shell's own pane layout.
    # 
    # _@param_ `status_bar` — the bottom row.
    def initialize: (Tuile::Component::Layout shell, Shared::StatusBar status_bar) -> void

    # _@return_ — the shell's pane layout.
    attr_reader shell: Tuile::Component::Layout

    # _@return_ — the bottom row.
    attr_reader status_bar: Shared::StatusBar
  end

  # A "leader key" command menu: a modal popup listing app actions, each on
  # one follow-up key, opened by a single reserved shortcut (the shells bind
  # +Ctrl+K+). Register actions with {#add} (chainable) before the first
  # {#open}:
  # 
  #   menu = Shared::LeaderMenu.new(screen: screen)
  #   menu.add('l', 'logs') { log_ui.open }
  #   menu.add('q', 'quit') { app.quit }
  #   # Ctrl+K opens the popup; "l" runs the logs action; ESC / Ctrl+C cancel
  # 
  # The which-key pattern (lazyvim / VS Code) retargeted at Tuile: one leader
  # key stands in for a fistful of global shortcuts, and the popup advertises
  # every binding, so nothing has to be memorized and the terminal's scarce
  # unprintable-key namespace (much of it eaten by tmux, flow control) stays
  # free. Each picked callback is deferred to the next event-loop tick so the
  # menu popup is fully closed *before* the action runs — an action that
  # opens another popup (logs, git diff, model picker) then never stacks a
  # second modal over this one.
  # 
  # == Implementation details
  # 
  # Built on {Tuile::Component::PickerDialog} (single-key options, a
  # picked-key callback, the ESC/+q+ dismissal idiom, closing itself on a
  # pick). Follow-up keys are *printable* (+l+ / +d+ / +p+ / +m+ / +q+) —
  # legal because the popup consumes them directly, unlike
  # {Tuile::Screen#register_global_shortcut}, which rejects printable keys so
  # they can't hijack typing in the input. ESC and any unbound key dismiss;
  # +Ctrl+C+ dismisses too, via {CancelPickerDialog} (it would otherwise be
  # suppressed while a modal dialog is open).
  # 
  # UI-thread-confined.
  class LeaderMenu
    CAPTION: String

    # _@param_ `screen` — the screen the popup mounts on and whose event queue defers each picked callback to the next tick.
    # 
    # _@param_ `caption` — the popup's caption ({CAPTION} by default; a submenu passes its own).
    def initialize: (screen: Tuile::Screen, ?caption: String) -> void

    # Register an action. Chainable; call before the first {#open}.
    # 
    # A *callable* label is resolved each time the menu opens, which is how a
    # toggle advertises its own state:
    # 
    #   menu.add('t', -> { "thinking: #{pane.show_thinking ? 'shown' : 'hidden'}" }) { pane.toggle_thinking }
    # 
    # _@param_ `key` — the single follow-up key (e.g. +"l"+).
    # 
    # _@param_ `label` — the action label (e.g. +"logs"+), or a zero-arg callable returning one.
    def add: (String key, (String | untyped) label) -> self

    # _@return_ — true when no action has been registered.
    def empty?: () -> bool

    # Open the menu as a modal popup listing every registered action. A
    # no-op when none are registered. Picking a key defers that action to the
    # next event-loop tick (so the menu closes first); ESC / +Ctrl+C+ / an
    # unbound key dismisses without running anything.
    # 
    # A {CancelPickerDialog} (ESC *and* +Ctrl+C+ close) rather than the base
    # picker (ESC / +q+ only) — note +q+ here is a quit *action*, intercepted as
    # an option key before the dialog's close handler, so cancel is ESC /
    # +Ctrl+C+.
    def open: () -> void

    # _@return_ — the registered actions, in display order.
    # Exposed for tests.
    attr_reader actions: ::Array[Action]

    # The menu's {Tuile::Component::PickerDialog}, adding one thing over the
    # base: +Ctrl+C+ dismisses it, exactly like ESC. The key bubbles up from the
    # focused list and is not an option key — the same path ESC / +q+-close take.
    class CancelPickerDialog < Tuile::Component::PickerDialog
      # _@param_ `key`
      # 
      # _@return_ — true if the key was handled.
      def handle_key?: (String key) -> bool
    end

    # One menu entry: a follow-up key, its human label, and the zero-arg
    # callback run when the key is picked.
    # 
    # @!attribute [r] key
    #   @return [String] the single follow-up key that runs this action.
    # @!attribute [r] label
    #   @return [String, #call] the action's label, shown after the key glyph;
    #     a callable is resolved at {#open} time.
    # @!attribute [r] callback
    #   @return [Proc, Method] the zero-arg callable run on pick.
    class Action < Data
      # _@return_ — the label as it should read right now.
      def text: () -> String

      # _@return_ — the single follow-up key that runs this action.
      attr_reader key: String

      # _@return_ — the action's label, shown after the key glyph;
      # a callable is resolved at {#open} time.
      attr_reader label: (String | untyped)

      # _@return_ — the zero-arg callable run on pick.
      attr_reader callback: (Proc | Method)
    end
  end

  # The always-visible bottom row: the two global keys, +^C+ first. With unread
  # errors behind the menu it reads
  # 
  #   ^C cancel  ^K ⚠ menu (2)
  # 
  # Tuile draws no status bar and reserves no row for one (its +DECISIONS.md+
  # +D-status-bar+), so this is an ordinary component, placed on the last row by
  # {Shared::RootLayout}. The +^K+ half is a block so it can carry a live tally:
  # 
  #   bar.menu_hint { "^K #{screen.theme.hint('menu')}" }
  #   bar.refresh   # the tally changed; re-run it
  # 
  # A block rather than assigned text is also what makes the row survive a
  # light/dark flip: +theme.hint+ / +theme.error+ bake their colors in as they
  # run, so {#handle_theme_changed} just runs them again.
  # 
  # +^C cancel+ is unconditional — every shell binds +Ctrl+C+. There is
  # deliberately no +q quit+ segment: Tuile's loop still quits on an *unhandled*
  # +q+, but the focused input consumes it in every pikuri shell, so advertising
  # it would be a lie.
  # 
  # UI-thread-confined.
  class StatusBar < Tuile::Component::Label
    # Declares how the +^K+ half renders, and renders the row.
    def menu_hint: () ?{ () -> (String | Tuile::StyledString)? } -> void

    # Re-renders the row, re-running the {#menu_hint} block. Call it after
    # changing state that block reads.
    def refresh: () -> void

    # Re-renders against the new {Tuile::Screen#theme}, already in place when
    # this fires.
    def handle_theme_changed: () -> void
  end

  # The bottom input pane: a borderless, permanently tinted well framing an
  # editable {Area} (Enter submits, blank buffers are a no-op), with a static
  # {MARKER} hanging off its left edge.
  # 
  #   ❯ what about lifetimes                   <- MARKER, then the Area
  #                                            <- HEIGHT rows, all editable
  # 
  # The whole rect paints +:pane_bg+ — this is a *secondary* surface, set off
  # against the untinted {Shared::ConversationTextView} above it — and it does so
  # regardless of focus. Left alone, Tuile's
  # {Tuile::Component::AbstractStringField} would paint a well of its own
  # (+active_bg_color+ focused, +input_bg_color+ otherwise) — a second shade
  # inside the pane, flipping as focus moves — so the {Area} is built with
  # +bg_color = ComponentBackground::INHERIT+ and takes this pane's tint instead.
  # 
  # The well is a permanent spatial anchor, not a focus cue — the *caret* is the
  # focus cue, and it does the whole job. Focus leaves the prompt only for the
  # {Shared::ConversationTextView} (to answer a {Shared::PendingDecision}), and an
  # unfocused {Tuile::Component::TextView} publishes no cursor position, so the
  # caret simply vanishes: "your keys go to the transcript now", stated without
  # the labeled chips a multi-pane borderless app would need.
  # 
  # The host builds one, drops it into the layout, and focuses it — {#focus}
  # forwards to the private {Area}, since a {Tuile::Component::Layout} has no
  # Panel→content focus cascade to do it:
  # 
  #   menu = Shared::SlashMenuPopup.new(screen:, commands:, conversation:)
  #   pane = Shared::InputPane.new(on_submit: session.method(:submit),
  #                                slash_menu: menu, conversation: conversation)
  #   layout = Chat::Layout.new(conversation: conversation, status_rule: rule, input: pane)
  #   pane.focus   # lands the caret in the Area
  # 
  # With a +slash_menu+, the prompt also owns slash-command entry: the {Area}
  # opens/filters the palette as the buffer changes, arbitrates Enter (a
  # leading-+/+ buffer runs a command instead of submitting a turn), and forwards
  # Up/Down/ESC to the palette while it's shown. The prompt is the natural owner —
  # it already holds Enter and the buffer, and the {Area} is private, so nothing
  # outside could arbitrate them.
  # 
  # With a +conversation+, PageUp/PageDown page that pane half a screen — the
  # transcript reads back without the caret leaving the prompt. A visible palette
  # gets those keys first, to page its own list.
  # 
  # {#capture} borrows the prompt for a one-off answer instead of a turn — a
  # reason for rejecting a tool call, a rewritten sub-agent task. Prose is typed
  # here and nowhere else, which is what keeps it away from anything that treats
  # a keystroke as a decision.
  # 
  # Shared by all three shells.
  # 
  # UI-thread-confined.
  class InputPane < Tuile::Component::Layout
    MARKER: String
    MARKER_WIDTH: Integer
    TRAILING_PAD: Integer
    HEIGHT: Integer

    # _@param_ `on_submit` — called as +(text, attachments:)+ when the user presses Enter on a non-blank line: the text with its +@path+ tokens split out by {Shared::AttachmentTokens}, and the images they named.
    # 
    # _@param_ `slash_menu` — the slash-command palette this prompt drives, or nil for a plain input. This pane becomes its anchor (the palette floats just above it).
    # 
    # _@param_ `conversation` — the transcript PageUp/PageDown page while the prompt holds focus, or nil to leave those keys to the {Tuile::Component::TextArea}.
    def initialize: (on_submit: (Proc | Method), ?slash_menu: Shared::SlashMenuPopup?, ?conversation: Shared::ConversationTextView?) -> void

    # Focuses the editable area. The pane itself is passive layout; the {Area} is
    # what owns the caret and the keyboard, and unlike a
    # {Tuile::Component::Panel} a {Tuile::Component::Layout} cascades nothing.
    def focus: () -> void

    # Borrow the prompt for one answer instead of a turn: swap the marker, hand
    # the buffer +initial+, and route the next Enter (or ESC) to +on_finish+
    # rather than to +on_submit+. The answer is not recorded in the history and a
    # leading +/+ stays literal — it is text, not a command.
    # 
    #   input.capture(marker: '✎', initial: task) do |text|
    #     text.nil? ? reject : approve(text)   # nil = the user pressed ESC
    #   end
    # 
    # _@param_ `marker` — glyph shown in place of {MARKER} while capturing, so the prompt doesn't look like it is waiting for a message.
    # 
    # _@param_ `initial` — pre-fill text.
    def capture: (marker: String, ?initial: String) ?{ (String? text) -> void } -> void

    # Put an +@path+ token for +arg+ at the front of the prompt, caret after it,
    # so the user types the question next — the +/image <path>+ command. A file
    # that can't be attached gets the same "Can't attach" alert a submit does.
    # 
    #   input.attach("'/tmp/my shot.png'")   # prompt: "@'/tmp/my shot.png' ▏"
    # 
    # _@param_ `arg` — the path, as typed or dragged after +/image+.
    def attach: (String arg) -> void

    # Report that the model refused a submitted line's images: the alert, and
    # the line back in the prompt from history for a fix — unless the user has
    # already started typing something else.
    # 
    # _@param_ `reason` — e.g. +"shot.png (image/png): model m takes no vision input"+.
    def refuse_attachment: (String reason) -> void

    # _@return_ — whether the prompt is currently borrowed by {#capture}.
    def capturing?: () -> bool

    # End a {#capture} as if the user had pressed ESC — its callback runs with
    # +nil+. A no-op when the prompt isn't captured.
    def cancel_capture: () -> void

    # Repaints the marker in the new theme's hint accent — its tone is baked into
    # the label's text, so a light/dark flip has to re-run it.
    def handle_theme_changed: () -> void

    # Lays the marker and the editable area out across the tinted well: the
    # marker on the first row at the very left edge, the area filling the rest
    # bar {TRAILING_PAD} columns. The base {Tuile::Component#repaint} fills
    # whatever the two children don't cover with {#bg_color} — which is what
    # paints the trailing pad and the rows under the marker.
    def relayout: () -> void

    # Re-renders the marker label; its accent is baked into the text.
    def rebuild_marker: () -> void

    # _@return_ — the editable area. Exposed for tests;
    # production drives the prompt through +on_submit+ and {#focus}, and the
    # {Area} class itself stays private so nothing outside can re-arbitrate the
    # keys it owns.
    attr_reader area: Tuile::Component::TextArea

    # The editable content: a {Tuile::Component::TextArea} that rebinds Enter
    # from "insert a newline" to "submit the buffer and clear it".
    # 
    #   # Enter on "hi"           → on_submit.call("hi", attachments: []), then the field clears
    #   # Enter on "@a.png why?"  → on_submit.call("a.png why?", attachments: [a.png's image])
    #   # Enter on "@nope.png"    → "Can't attach" alert; the line stays
    #   # Enter on "   "          → no-op (a blank buffer can't burn a turn)
    # 
    # Enter is line-at-a-time because pikuri's turn is, and Shift+Enter is not
    # used for a newline: most terminals don't distinguish it from a plain
    # Enter on the wire. Everything submitted also lands in a
    # {Shared::PromptHistory}: Up/Down recall it once the caret has nowhere left
    # to go in that direction, and ESC goes back to the draft. All other
    # TextArea behaviour (caret motion, word-jumps, backspace/delete) is
    # inherited unchanged. Private to {Shared::InputPane} — the pane is the only
    # public handle.
    class Area < Tuile::Component::TextArea
      PAGE_KEYS: ::Array[String]

      # _@param_ `on_submit` — called as +(text, attachments:)+ when the user presses Enter on a non-blank buffer. This class owns the clear, so callers don't wipe the input in their handler.
      # 
      # _@param_ `slash_menu` — the palette to drive, or nil for a plain input (then every slash branch below is skipped).
      # 
      # _@param_ `conversation` — the pane the page keys scroll, or nil to leave them unclaimed.
      def initialize: (on_submit: (Proc | Method), slash_menu: Shared::SlashMenuPopup?, conversation: Shared::ConversationTextView?) -> void

      # Route the next Enter / ESC to +on_finish+ instead of submitting a turn.
      # 
      # _@param_ `initial` — pre-fill text.
      def capture: (initial: String) ?{ (String? text) -> void } -> void

      # _@return_ — whether a {#capture} is in progress.
      def capturing?: () -> bool

      # Open the "Can't attach" alert.
      # 
      # _@param_ `reason` — the dialog's message.
      def alert: (String reason) -> void

      # Show the newest history entry, caret at its end.
      def restore_last: () -> void

      # End the capture, empty the buffer, then hand +value+ to its callback — in
      # that order, so a callback that starts a second capture wins.
      # 
      # _@param_ `value` — the answer, or +nil+ when cancelled.
      # 
      # _@return_ — always true; Enter/ESC during a capture is ours.
      def finish_capture: (String? value) -> bool

      # Route keys with the slash palette in mind, then fall through to
      # {Tuile::Component::TextArea#handle_key?}. Returns +true+ on a consumed key
      # so it isn't re-dispatched up the tree as something else. While a palette
      # is present: Up/Down/ESC drive it *only when shown* (otherwise they edit
      # normally), and Enter on a leading-+/+ buffer runs a command instead of
      # submitting a turn.
      # 
      # _@param_ `key`
      # 
      # _@return_ — +true+ if the key was consumed here.
      def handle_key?: (String key) -> bool

      # Claim Up/Down for history recall, but only in the first/last row and only
      # when the store has something to give. Anything else — an exhausted edge
      # included — falls through to +super+, so with no history the prompt is a
      # plain {Tuile::Component::TextArea}, edge-snap included.
      # 
      # _@param_ `key`
      # 
      # _@return_ — +true+ if the key was consumed here.
      def handle_text_input_key?: (String key) -> bool

      # _@param_ `key`
      # 
      # _@return_ — whether the palette claims this key while shown.
      def nav_key?: (String key) -> bool

      # Page the conversation pane by half a screen.
      # 
      # _@param_ `key` — +PAGE_UP+ or +PAGE_DOWN+.
      # 
      # _@return_ — always true — a scroll clamped at either edge still
      # consumed the key.
      def scroll_conversation: (String key) -> bool

      # ESC outside the palette, in place of the inherited blur (turned off with
      # {Tuile::Component::AbstractStringField#escape_clears_focus} in the
      # constructor): leave history if browsing, otherwise wipe the buffer.
      def escape: () -> void

      # Step to the older entry, preserving the buffer as the draft first if
      # we're leaving it.
      # 
      # _@return_ — whether an entry was recalled.
      def recall_older: () -> bool

      # _@return_ — whether an entry (or the draft) was recalled.
      def recall_newer: () -> bool

      # Show +entry+ with the caret at its end, without letting the slash palette
      # react — a recall is not typing, so a recalled +/command+ sits inert until
      # the user edits it or sends it.
      # 
      # _@param_ `entry` — the text to show; +nil+ when the store had nothing at that end.
      # 
      # _@return_ — whether anything was recalled.
      def recall: (String? entry) -> bool

      # Replace the buffer with the caret at its end. A +value=+ write is not the
      # user's, so the slash palette does not react.
      # 
      # _@param_ `value`
      def replace_text_quietly: (String value) -> void

      # Record and run the slash command in the buffer, then clear the field.
      # Order matters:
      # {Shared::SlashMenuPopup#submit} resolves against the still-open palette
      # (so the highlighted row wins) *before* the clear closes it.
      # 
      # _@return_ — always true; Enter on a slash buffer is ours.
      def submit_command: () -> bool

      # Split the +@path+ tokens out, record the line as typed, clear it, then
      # hand off to the host callback — in that order, so a handler that redraws
      # synchronously sees an empty input, and one that *raises* costs neither
      # the clear nor the history entry. A token that can't be attached refuses
      # the whole line: an alert says why, and the buffer stays for a fix.
      # 
      # _@return_ — always true; the host has decided Enter is a
      # meaningful key for the input.
      def submit: () -> bool
    end
  end

  # The app's own {Tuile::Theme}: the built-in accent tokens (active
  # highlight, input well, active border) plus the extra colors pikuri-tui
  # paints that the framework doesn't know about, carried in
  # {Tuile::Theme#custom}. Subclassing (rather than passing a bare
  # +custom:+ hash) buys one coloring helper per token:
  # 
  #   theme.error('! boom')   # instead of theme.fg(:error, '! boom')
  #   theme.tool('Bash(ls)')  # → the conversation pane's tool-call color
  # 
  # +Data#with+ keeps the subclass through a +with+.
  # 
  # The tokens cover the chrome all three shells paint:
  # 
  # - +:hint+ — the chrome accent, {TALUS}: kuri's own coat color, so the
  #   keyboard hints, the +❯+ prompt marker, the pane captions and the status
  #   rule's model / token readout all read as the mascot's palette. +:tool+
  #   below is the same coat one step warmer, so the conversation pane's
  #   machinery reads as a sibling of the chrome rather than as a second accent
  #   hue — the panes keep them apart, the palette no longer has to. See {#hint}
  #   for why this is ours rather than the built-in Tuile token it used to be.
  # - +:tool+ — the +Bash(ls)+ call lines (and, in the verbose form, the
  #   += result+ lines) {Shared::ConversationTextView::Listener} writes into the
  #   conversation pane, plus the slash-menu command names and the coding
  #   shell's diff headers.
  #   {CHESTNUT} / {CHESTNUT_SHADE}.
  # - +:notice+ — the +! reason+ fallback line and the
  #   {Code::ConfirmRenderer} sanitizer warnings (a "read this carefully"
  #   amber).
  # - +:error+ — the +! ClassName: message+ turn-failure line, the
  #   +! cancelled+ notice, the +^C cancel+ shortcut hint, and the
  #   +⚠ logs (N)+ error tally.
  # - +:thinking+ — the single muted tone {Shared::Markdown::Grayscale} flattens
  #   reasoning blocks to. Read as a {Tuile::Color} (+theme[:thinking]+)
  #   rather than a text helper, since {Shared::Markdown::Grayscale} repaints spans
  #   via +StyledString#with_fg+.
  # - +:detail+ — the dim secondary text under a confirmer's question
  #   (the sanitized command/diff detail).
  # - +:user+ — the +> message+ echo of a user turn in the conversation
  #   pane. Pure black (+#000000+, an explicit RGB rather than the named
  #   ANSI black the terminal would remap) on light so it reads as solid
  #   black, solid white on dark so it stands out the same way there.
  # - +:added+ / +:removed+ — the green +"+N"+ / red +"-N"+ line-count
  #   markers {Code::GitWatcher} paints next to each path in the sidebar
  #   change summary. (The full diff popup uses git's own SGR coloring, not
  #   these — they're only for the summary's hand-rendered counts.)
  # - +:pane_bg+ — the background of every *secondary* surface: the status
  #   rule, the prompt well, and the coding shell's tasks / changes sidebar.
  #   The conversation pane and the status bar are the untinted ones, keeping
  #   the terminal's own background, so the app still blends with the user's
  #   terminal theme (and stays translucent under a transparent one).
  # - +:pane_frame+ — the hairline color for the +─+ / +│+ rules that separate
  #   panes now that nothing is framed (the status rule, the sidebar's captions
  #   and its left-edge column). Derived from +:pane_bg+, the ground all of
  #   them rule on — a hairline must step from the ground it sits on, not from
  #   the terminal's. See {.pane_bg_token}.
  # - +:diff_line_add+ / +:diff_line_del+ / +:diff_span_add+ /
  #   +:diff_span_del+ — the four *background* tones {Code::DiffRenderer}
  #   paints for the edit / write tool diff view: a dim whole-line bar
  #   (+line+) and a brighter changed-character emphasis (+span+), for
  #   additions and removals. Read as {Tuile::Color}s (the renderer applies
  #   them as backgrounds via +StyledString+ +bg:+), not via a text helper.
  #   Distinct from +:added+/+:removed+, which are foreground count markers.
  #   All eight are +delta+'s own defaults verbatim (its
  #   +DARK_THEME_MINUS_COLOR+ family), so a diff here reads as the one in
  #   lazygit. Two properties of that palette are easy to "improve" away and
  #   worth keeping: the tones are *pure* — no grey floor in the off-hue
  #   channels, which is what keeps a wide bar a tint rather than a lit-up
  #   area — and on light the *green* carries roughly twice the perceptual
  #   weight of the red (ΔE 31 vs 13 against paper), so additions lead and
  #   removals whisper. Balancing the two by eye is what makes red shout.
  #   Caveat inherited along with them: the dark pair assumes a near-black
  #   ground, so on a mid-dark terminal (One Dark, Gruvbox) the +line+ tier
  #   lands at or just under the background and the bar reads as a dark hole
  #   rather than a wash.
  # 
  # The markdown body palette ({Shared::Markdown::AnsiConverter}'s header
  # / emphasis / code SGR codes) is deliberately NOT a theme token: that
  # converter is a screen-agnostic +Kramdown::Converter+ used in specs
  # without a {Tuile::Screen}, and its output is flattened away on the
  # thinking path by {Shared::Markdown::Grayscale} anyway — it renders content, not
  # chrome accents, which is what theming is for. Its accents are
  # named-ANSI, so they track the terminal's own light/dark remapping
  # for free. The one exception is rouge code-block highlighting, which
  # emits absolute 256-colors: {Shared::Markdown::Renderer.render} passes the
  # current scheme as a plain +dark:+ boolean (not a theme token, so the
  # converter stays screen-agnostic) and {Shared::Markdown::AnsiConverter}
  # picks a light-legible code theme on light.
  # 
  # Install the {THEME_DEF} pair at boot (+screen.theme_def=+) so OS
  # light/dark flips re-pick the legible variant; tests point
  # +Tuile::ThemeDef.default+ at it once so every +Screen.fake+ resolves
  # the custom tokens.
  # 
  # +:pane_bg+ and +:pane_frame+ are Tuile *derived tokens* — Procs of the
  # terminal's reported background, which the screen resolves whenever the
  # theme or +Tuile::Screen#background_color+ changes — so {DARK} / {LIGHT} are
  # unresolved themes: read those two tokens off +screen.theme+, or off
  # +DARK.resolve(background)+, never off the constants.
  # 
  # Immutable.
  class AppTheme < Tuile::Theme
    TALUS: Tuile::Color
    TALUS_SHADE: Tuile::Color
    CHESTNUT: Tuile::Color
    CHESTNUT_SHADE: Tuile::Color
    DARK_CUSTOM: ::Hash[Symbol, (Tuile::Color | Proc)]
    LIGHT_CUSTOM: ::Hash[Symbol, (Tuile::Color | Proc)]
    DARK: Shared::AppTheme
    LIGHT: Shared::AppTheme
    THEME_DEF: Tuile::ThemeDef

    # Renders +text+ in the +:hint+ foreground — the chrome accent: the +❯+
    # prompt marker, the pane captions, the keyboard hints and the status
    # rule's readout.
    # 
    # Tuile carried this as a built-in +Theme#hint+ until it dropped the token
    # after 0.15.0 — a "de-emphasized text" shade describes a look rather than a
    # role, so the framework declines to name one. It is one of *our* {#custom}
    # tokens now, which is the path Tuile documents for an app color that must
    # follow the appearance, and is why it still survives a light/dark flip:
    # {THEME_DEF} pairs the two variants.
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def hint: (String text) -> String

    # Renders +text+ in the +:tool+ foreground. See {#hint}.
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def tool: (String text) -> String

    # Renders +text+ in the +:notice+ foreground.
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def notice: (String text) -> String

    # Renders +text+ in the +:error+ foreground.
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def error: (String text) -> String

    # Renders +text+ in the +:detail+ foreground.
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def detail: (String text) -> String

    # Renders +text+ in the +:user+ foreground (the user-turn echo).
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def user: (String text) -> String

    # Renders +text+ in the +:added+ foreground (the +"+N"+ count marker).
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def added: (String text) -> String

    # Renders +text+ in the +:removed+ foreground (the +"-N"+ count marker).
    # 
    # _@param_ `text`
    # 
    # _@return_ — ANSI-rendered text, ending with an SGR reset.
    def removed: (String text) -> String

    # The derived +:pane_bg+ token: the terminal's background stepped toward
    # mid-grey ({Shared::Tint.pane_bg}), guarded so the foregrounds painted on
    # the tint ({.guard_colors}) keep their contrast. With no reported
    # background (+nil+ — plenty of terminals answer no OSC 11) it is +floor+.
    # 
    # _@param_ `floor` — the fixed tint assumed for the variant's common ground.
    # 
    # _@return_ — +(background, theme) -> Tuile::Color+.
    def self.pane_bg_token: (Tuile::Color floor) -> Proc

    # The derived +:pane_frame+ token: a hairline on the +:pane_bg+ ground
    # ({Shared::Tint.hairline}), since every rule it colors sits on that tint
    # rather than on the terminal's own background. +floor+ with no reported
    # background, paired with {.pane_bg_token}'s.
    # 
    # _@param_ `floor`
    # 
    # _@return_ — +(background, theme) -> Tuile::Color+.
    def self.pane_frame_token: (Tuile::Color floor) -> Proc

    # The foregrounds actually painted *on* +:pane_bg+, which {.pane_bg_token}'s
    # contrast guard defends: the prompt marker and sidebar captions
    # (+:hint+), the placeholder / completed-task tone
    # (+:detail+) and the three change-kind tones the git summary paints. The
    # named-ANSI ones among those have no knowable RGB and skip themselves inside
    # {Shared::Tint.pane_bg}.
    # 
    # Deliberately *not* the conversation pane's tokens (+:tool+, +:user+,
    # +:thinking+, the diff backgrounds): that pane keeps the terminal's own
    # background, so no tint can hurt them.
    # 
    # _@param_ `theme` — the variant to read the tokens from — a resolved theme, or the resolver a derived token is handed.
    def self.guard_colors: ((Shared::AppTheme | Tuile::Theme::Resolver) theme) -> ::Array[Tuile::Color]
  end

  # Layered TOML configuration loaded once at boot by all three shells,
  # before the screen is up, and read from there on:
  # 
  #   config = Shared::Config.load(overrides: { sandbox: cli_sandbox })
  #   config.primary_llm   # the boot connection
  #   config.llms          # every [[llm]], for the model picker
  #   config.servers       # every [[server]], for the request throttle
  #   config.sandbox       # coding/OS sandbox switch (flag > file > default)
  # 
  # It holds the resolved model connections, the web-search selection,
  # the coding shell's sandbox / confirm switches, its MCP server list, and
  # the +[ui]+ transcript-density defaults, merged from the XDG config search
  # path with the bins' CLI overrides on top.
  # 
  # == +[[server]]+ and +[[llm]]+
  # 
  #   [[server]]
  #   id                      = "grok"
  #   url                     = "https://api.x.ai/v1"
  #   api_key                 = "xai-..."
  #   max_concurrent_requests = 4
  # 
  #   [[llm]]
  #   name           = "Grok 4 Fast"
  #   server         = "grok"
  #   model          = "grok-4-fast"
  #   context_window = 131072
  # 
  # The box and the model running on it are separate tables, so four models on
  # one provider state its URL and its key once instead of four times. +id+ is
  # referenced by machine, +name+ is shown to a person — the rule
  # +[[code.mcp]]+ already follows — and those two are what {.load} checks for
  # uniqueness. Two +[[server]]+ entries may share a URL (two accounts on one
  # provider), and an unreferenced +[[server]]+ is legal, so commenting out an
  # +[[llm]]+ cannot break the file.
  # 
  # {Llm#server} is the resolved *URL*, and the +id+ leaves this class only in a
  # log line: an id means nothing away from the file defining it, so anything
  # that stored one would hold a reference a later edit can orphan, where a URL
  # stands on its own.
  # 
  # Nothing here has a default connection to fall back on. No +[[llm]]+ at all,
  # a missing +server+ or +model+, and a +server+ resolving to nothing each raise
  # {Error} — a hardcoded model tag reached silently would be a second, invisible
  # connection source, so that knowledge is {EXAMPLE_CONFIG}, quoted by the raise
  # for the user to edit. A file written against the older URL-in-+[[llm]]+ shape
  # is guided by those messages, never accepted.
  # 
  # == The +[ui]+ table
  # 
  #   [ui]
  #   show_thinking = false     # start with reasoning blocks collapsed
  #   tool_lines    = "verbose" # start on the raw argument dump
  # 
  # One table for all three shells — no +[chat.ui]+ / +[code.ui]+ — because
  # transcript density is a preference per *person* far more than per shell.
  # Each key sets the *starting* value of a {Shared::UIToggleMenu} toggle;
  # flipping one lasts the session and is never written back, the same
  # file-sets-default / runtime-overrides shape +sandbox+ and +confirm+ have.
  # Making them session-only with no file key at all would have meant re-typing
  # a taste every boot; a rewrite-in-place preferences store can still replace
  # this table later without the pane noticing, since the pane is handed only a
  # resolved value.
  # 
  # The conversation pane's +markdown:+ flag is the same shape and has no key
  # here yet — the natural third entry when someone wants it.
  # 
  # == +params+, and the siblings' tables
  # 
  #   [[llm]]
  #   name   = "Local Qwen 3.6, no thinking"
  #   server = "local"
  #   model  = "unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M"
  #   params = { chat_template_kwargs = { enable_thinking = false } }
  # 
  #   [titler]              # which connection pikuri-web writes titles on;
  #   llm = "qwen-titler"   # exposed nowhere here, these shells title nothing
  # 
  #   [web]                 # the one password gating pikuri-web when it is
  #   user     = "mavi"     # bound off loopback; a terminal shell has no
  #   password = "…"        # port for anyone to knock on
  # 
  # {Llm#params} is an opaque table of extra chat-completion payload keys, sent
  # as written on that connection — the spelling being per-model-per-server,
  # pikuri translates none of it. It rides the connection's
  # +Pikuri::Agent::ChatTransport+ as {Llm#context_window} does, so it survives
  # a model switch.
  # 
  # +[titler]+ and +[web]+ are the shared keys nothing here reads: one file
  # serves every pikuri shell, so this is the whole shared schema rather than the
  # part these three use, and a table a sibling owns is parsed, logged as unread
  # at load, and acted on in no way.
  # 
  # Ownership also picks the strictness. A table these shells read is strict,
  # because an unknown +[ui]+ key is a typo the user wants named; a sibling's is
  # checked for shape only, so pikuri-web growing a second +[titler]+ key cannot
  # stop this app from booting — the bargain its own +[ui]+ validation takes in
  # the other direction.
  # 
  # == Precedence
  # 
  # Lowest to highest: built-in defaults → +/etc/xdg/pikuri/config.toml+
  # (each +$XDG_CONFIG_DIRS+ entry, earlier = higher) →
  # +$XDG_CONFIG_HOME/pikuri/config.toml+ (default +~/.config+) → the CLI
  # safety switches. Files merge deeply (tables key-by-key); arrays — the
  # +[[server]]+, +[[llm]]+ and +[[code.mcp]]+ lists — replace wholesale,
  # nearest file wins. The +[search]+ table merges key-by-key like any table, so
  # a system file can supply +brave_key+ while the user file adds +exa_key+.
  # 
  # +server+ references resolve *after* the whole merge, so a user file can add
  # one +[[llm]]+ against a system file's +[[server]]+ rather than re-pasting
  # that block, secrets included. The consequence, since arrays replace: a nearer
  # file declaring +[[server]]+ at all replaces every farther one, which can
  # leave a farther file's +[[llm]]+ dangling. That raises; it never falls back.
  # 
  # == No connection overrides
  # 
  # +overrides:+ takes the safety switches and nothing else. Don't add a
  # +--server+ / +--model+ pair: an override lands on one {Llm}'s
  # +server+/+model+ but cannot rename it, so the picker offers that entry
  # under its configured {Llm#name} while talking to something else — a
  # mislabel no test catches, and one that outlives the flag, since
  # +Shared::Model::Picker+ builds its whole catalog from {#llms}. A model
  # identifier is long enough (+unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M+) that it
  # wants writing down once anyway, and the picker already covers switching at
  # runtime.
  # 
  # There is deliberately no project-local layer: a config file inside the
  # repo would be git-committable and readable by the sandboxed coding
  # agent — exactly where a literal {Server#api_key} or {Search} provider key
  # must not live.
  # 
  # == The Pikuri seam
  # 
  # This class is eager-loaded by all three shells, including the chat shell,
  # whose +Bundler.setup(:default)+ never puts +pikuri-mcp+ (nor the rest of
  # the +:code+ group) on the load path. So {Config} references nothing from
  # those gems: MCP servers surface as plain {McpServer} value objects whose
  # field names ({McpServer#id} / +command+ / +url+ / +headers+) match
  # +Pikuri::Mcp::Registry+'s entries 1:1, and the coding bin does the
  # trivial pass-through into +Registry::StdioEntry+ / +Registry::HttpEntry+.
  # The +bearer_token+ / +basic_auth+ HTTP-auth conveniences are resolved
  # here into {McpServer#headers} so that pass-through stays trivial.
  # Translation lives in the wiring layer where +Pikuri::*+ is allowed, not
  # here.
  # 
  # The one +Pikuri+ touch allowed here is +pikuri-core+'s logging facade:
  # {.load} reports which config files it read — and any loose-permissions
  # advisory ({.warn_loose_perms}) — through +Pikuri.logger_for+ (memoized,
  # +progname+-tagged), which all three shells load (+pikuri-core+ is in the
  # +:default+ group). +Pikuri.log_io+ defaults to +$stderr+, so these lines
  # surface immediately at boot — before any screen exists. The bins install a
  # {Shared::Log::BufferingIO} as that boot sink, which tees to +$stderr+ and retains
  # every line, so each bin's +App+ replays the pre-screen lines into the
  # diagnostic log dialog when it rewires +Pikuri.log_io+. {Config} just logs;
  # it never collects advisories for the caller to surface.
  # 
  # == The file's shape
  # 
  # Typemap maps the merged TOML onto {Root} and the classes nested in it, and
  # checks every value against the type its YARD tag gives (read back from
  # +sig/pikuri_tui.rbs+, which +rake sig+ generates). Typemap's limits add
  # non-blank names and unique ids; a class's +validate+ keeps only what no limit
  # can say, "exactly one of +command+ / +url+" and the like. {.load} then resolves the file's shape into the values
  # the shells read: each {LlmTable} with its {Server} looked up becomes an {Llm},
  # each {McpTable} with its auth sugar folded into +headers+ becomes an
  # {McpServer}. {Server} and {Search} already match the file and pass through.
  # 
  # == Errors
  # 
  # Every load failure — unreadable file, malformed TOML, schema violation —
  # raises {Error}. A schema message starts with the offending value's path, an
  # array entry named after its index by its +entry_name+:
  # 
  #   llm[1] "Grok 4 Fast".context_window: must be at least 1, got 0
  #   code.mcp[0] "github": set exactly one of `command` (stdio) or `url` (http)
  # 
  # Loading runs at boot before the screen is up, so the bins rescue {Error}
  # into a plain +warn+ + +exit+ rather than the usual route-to-log-dialog path
  # (there is no log dialog yet).
  # 
  # Immutable.
  class Config
    LOG: Logger
    DEFAULT_SANDBOX: bool
    DEFAULT_CONFIRM: bool
    DEFAULT_SHOW_THINKING: bool
    DEFAULT_TOOL_LINES: Symbol
    EXAMPLE_CONFIG: String
    FILENAME: String
    XDG_SUBDIR: String
    MAPPER: Typemap::Mapper

    # Load and resolve the layered configuration.
    # 
    # _@param_ `overrides` — CLI overrides; +nil+ values are ignored (treated as "flag not given"). The only recognized keys are +:sandbox+ and +:confirm+, the coding/OS safety switches — pass +false+ for +--no-sandbox+ / +--no-confirm+ / +--yolo+. Nothing about a *connection* is overridable — no server, no model (see "No connection overrides" above), and no key (a secret must never travel on the command line, visible in +ps+ and shell history); those come only from an {Llm} table in this file.
    # 
    # _@param_ `env` — environment consulted for +XDG_CONFIG_HOME+ / +XDG_CONFIG_DIRS+. Defaults to +ENV+; injectable for tests.
    # 
    # _@return_ — the resolved configuration.
    def self.load: (?overrides: ::Hash[Symbol, bool?], ?env: untyped) -> Config

    # _@param_ `llms` — one or more model connections (never empty).
    # 
    # _@param_ `servers` — the +[[server]]+ definitions {#llms} was resolved against. Defaults to empty: only the request throttle reads it, and a config built in code has no ceilings to install.
    # 
    # _@param_ `search` — web-search provider keys (fields may be nil).
    # 
    # _@param_ `sandbox` — resolved coding sandbox switch.
    # 
    # _@param_ `confirm` — resolved coding confirmer switch.
    # 
    # _@param_ `mcp` — coding-shell MCP servers (may be empty).
    # 
    # _@param_ `show_thinking` — resolved +[ui]+ reasoning-block default.
    # 
    # _@param_ `tool_lines` — resolved +[ui]+ tool-line form.
    def initialize: (
                      llms: ::Array[Llm],
                      search: Search,
                      sandbox: bool,
                      confirm: bool,
                      mcp: ::Array[McpServer],
                      ?servers: ::Array[Server],
                      ?show_thinking: bool,
                      ?tool_lines: Symbol
                    ) -> void

    # _@return_ — the boot connection (the first); the rest are
    # reachable at runtime through the leader menu's model picker.
    def primary_llm: () -> Llm

    # File layers, lowest priority first. +$XDG_CONFIG_DIRS+ (default
    # +/etc/xdg+) is +:+-separated with earlier entries ranking higher, so
    # we append them reversed; +$XDG_CONFIG_HOME+ (default +~/.config+)
    # outranks all of them. No project-local layer — see the class header.
    # 
    # _@param_ `env` — see {.load}
    # 
    # _@return_ — the file paths, lowest priority first
    def self.candidate_paths: (untyped env) -> ::Array[String]

    # Advise (non-fatally, through {LOG}) when a file carrying a literal
    # secret (an +[[llm]]+ api_key or a +[search]+ provider key) is
    # group/other-accessible — a plaintext secret should be +chmod 600+.
    # Only files that actually contain a secret are checked, so a
    # world-readable but secret-free /etc/xdg config raises no noise. Logged
    # at boot rather than collected: pikuri's default +$stderr+ sink (or the
    # bins' {Shared::Log::BufferingIO}) carries it to the diagnostic pane once a screen
    # exists, with no caller-side replay.
    # 
    # _@param_ `path` — the file just read
    # 
    # _@param_ `parsed` — its raw TOML
    def self.warn_loose_perms: (String path, ::Hash[String, Object] parsed) -> void

    # Reads +[[server]]+ for the key, not +[[llm]]+: this check runs per file
    # and pre-merge, on raw TOML, so it sees the table the key is *written* in
    # rather than the {Llm} it is later resolved into.
    # 
    # _@param_ `parsed` — one file's raw TOML
    # 
    # _@return_ — true when the parsed file carries any literal secret
    # (a +[[server]]+ +api_key+, a +[search]+ +brave_key+/+exa_key+, or an
    # +[[code.mcp]]+ +bearer_token+/+basic_auth+/+headers+/+env+).
    def self.holds_secret?: (::Hash[String, Object] parsed) -> bool

    # Parse one file, wrapping any failure (read error, TOML syntax) in
    # {Error} with the path attached — a library exception we surface at
    # boot rather than let escape as a bare backtrace.
    # 
    # _@param_ `path` — the file to read
    # 
    # _@return_ — its raw TOML
    def self.parse_file: (String path) -> ::Hash[String, Object]

    # Recursive merge: tables merge key-by-key; scalars and arrays take the
    # right-hand (higher-priority) value wholesale.
    # 
    # _@param_ `lower` — the farther file's tables
    # 
    # _@param_ `higher` — the nearer file's, winning every conflict
    # 
    # _@return_ — a new Hash; neither argument is modified
    def self.deep_merge: (::Hash[String, Object] lower, ::Hash[String, Object] higher) -> ::Hash[String, Object]

    # _@param_ `merged` — the merged TOML
    def self.map: (::Hash[String, Object] merged) -> Root

    # Log one line per table this shell parses and never acts on, so an ignored
    # table says so in the diagnostic pane instead of silently doing nothing.
    # INFO, not WARN: the file is shared, and a table written for pikuri-web is
    # doing its job there.
    # 
    # _@param_ `root` — the mapped file
    def self.log_unread_tables: (Root root) -> void

    # _@param_ `table` — one +[[llm]]+ entry
    # 
    # _@param_ `by_id` — every +[[server]]+, by id — the whole layered set, not just the file the entry was written in
    def self.resolve_llm: (LlmTable table, ::Hash[String, Server] by_id) -> Llm

    # Each way a reference can fail gets its own message, since with no compat
    # path the raise *is* the whole migration. A URL in +server+ earns the most
    # effort: it parses cleanly and fails as a *lookup*, which reads like the
    # user's mistake rather than a key whose meaning changed. The entry's stray
    # +api_key+ rides along into the suggested block, so one edit fixes both
    # halves of an old file instead of two round trips.
    # 
    # _@param_ `ref` — the entry's +server+ value
    # 
    # _@param_ `name` — the entry's +name+, for messages
    # 
    # _@param_ `by_id` — every +[[server]]+, by id
    # 
    # _@param_ `api_key` — the entry's stray +api_key+, quoted in the migration hint
    # 
    # _@return_ — the referenced server
    def self.resolve_server: (
                               String ref,
                               String name,
                               ::Hash[String, Server] by_id,
                               String? api_key
                             ) -> Server

    # _@param_ `url` — the URL the old-format entry wrote in +server+
    # 
    # _@param_ `api_key` — the entry's stray +api_key+
    # 
    # _@return_ — the error message, a paste-ready +[[server]]+ block included
    def self.server_is_now_an_id: (String url, String? api_key) -> String

    # Covers both "no config file at all" and "a file that defines no
    # connection" — the same hole with the same fix, so one message with the
    # path to write it to.
    # 
    # _@param_ `any_loaded` — whether any config file was found
    # 
    # _@param_ `env` — see {.load}
    # 
    # _@return_ — the error message, {EXAMPLE_CONFIG} included
    def self.no_connection_message: (bool any_loaded, untyped env) -> String

    # _@return_ — all configured connections, declaration order;
    # never empty.
    attr_reader llms: ::Array[Llm]

    # _@return_ — every +[[server]]+, declaration order, including
    # any that no +[[llm]]+ references.
    attr_reader servers: ::Array[Server]

    # _@return_ — the web-search provider keys (fields may be nil).
    attr_reader search: Search

    # _@return_ — coding sandbox switch (flag > file > default).
    attr_reader sandbox: bool

    # _@return_ — coding confirmer switch (flag > file > default).
    attr_reader confirm: bool

    # _@return_ — coding-shell MCP servers, declaration order.
    attr_reader mcp: ::Array[McpServer]

    # _@return_ — whether reasoning blocks start shown (+[ui]+ > default).
    attr_reader show_thinking: bool

    # _@return_ — the tool-line form to start on (+[ui]+ > default), one of
    # {Shared::ConversationTextView::TOOL_DETAIL_MODES}.
    attr_reader tool_lines: Symbol

    # Raised for any unreadable / malformed / schema-invalid config file.
    # Carries a human-readable message naming the offending key or file.
    class Error < StandardError
    end

    # One inference server: what is true of the box rather than of a model
    # running on it, referenced by {#id} from any number of +[[llm]]+ entries
    # (the class header shows the pair of tables).
    # 
    # @!attribute [r] id
    #   @return [String] unique reference an +[[llm]]+ names in its +server+
    #     key; never shown to the user, never stored anywhere outside this
    #     class (see the class header).
    # @!attribute [r] url
    #   @return [String] base URL, with or without the +/v1+ suffix — pikuri
    #     normalizes both the transport's base and the throttle's key by
    #     stripping it, so either spelling names one server.
    # @!attribute [r] api_key
    #   @return [String, nil] the API key/token, stored literally, or +nil+ for
    #     a server that needs none (a local llama.cpp). Kept in this file rather
    #     than an env var on purpose: the environment is inherited by every
    #     subprocess pikuri spawns — sandboxed bash, stdio MCP servers — so a key
    #     there leaks to code the agent runs, whereas this file is read only by
    #     the parent and never exported. It also lives outside the workspace the
    #     coding agent can read. Both protections rely on the file sitting in the
    #     user/system config (see {.load}); project-local files are not loaded
    #     for exactly this reason.
    # @!attribute [r] max_concurrent_requests
    #   @return [Integer, nil] ceiling on requests in flight against this server
    #     — a +llama-server --parallel+ number — or +nil+ to let pikuri's
    #     +/props+ probe size it. See +Shared::RequestPermits+ for what the key
    #     does and does not buy.
    class Server < Data
      extend Typemap::Constrain

      # _@param_ `id` — see {#id}
      # 
      # _@param_ `url` — see {#url}
      # 
      # _@param_ `api_key` — see {#api_key}
      # 
      # _@param_ `max_concurrent_requests` — see {#max_concurrent_requests}
      def initialize: (
                        id: String,
                        url: String,
                        ?api_key: String?,
                        ?max_concurrent_requests: Integer?
                      ) -> void

      # Names the entry in a schema error, +server[1] "grok".url: required+.
      # 
      # _@param_ `raw` — the entry as the file wrote it, unchecked
      # 
      # _@return_ — its +id+, which Typemap strips; a blank or missing one
      # leaves the bare index
      def self.entry_name: (::Hash[String, Object] raw) -> Object

      # _@return_ — unique reference an +[[llm]]+ names in its +server+
      # key; never shown to the user, never stored anywhere outside this
      # class (see the class header).
      attr_reader id: String

      # _@return_ — base URL, with or without the +/v1+ suffix — pikuri
      # normalizes both the transport's base and the throttle's key by
      # stripping it, so either spelling names one server.
      attr_reader url: String

      # _@return_ — the API key/token, stored literally, or +nil+ for
      # a server that needs none (a local llama.cpp). Kept in this file rather
      # than an env var on purpose: the environment is inherited by every
      # subprocess pikuri spawns — sandboxed bash, stdio MCP servers — so a key
      # there leaks to code the agent runs, whereas this file is read only by
      # the parent and never exported. It also lives outside the workspace the
      # coding agent can read. Both protections rely on the file sitting in the
      # user/system config (see {.load}); project-local files are not loaded
      # for exactly this reason.
      attr_reader api_key: String?

      # _@return_ — ceiling on requests in flight against this server
      # — a +llama-server --parallel+ number — or +nil+ to let pikuri's
      # +/props+ probe size it. See +Shared::RequestPermits+ for what the key
      # does and does not buy.
      attr_reader max_concurrent_requests: Integer?
    end

    # One model connection: a +[[llm]]+ entry with its +[[server]]+ already
    # resolved into it, so nothing downstream has to hold the reference.
    # Every entry becomes a leader-menu model-picker choice (the bins map each
    # to a +Shared::Model::Choice+ + +ChatTransport+); the first {Config#llms}
    # entry is the boot connection.
    # 
    # @!attribute [r] name
    #   @return [String] unique display name, e.g. +"Local Qwen 3.6"+.
    # @!attribute [r] server
    #   @return [String] the referenced {Server}'s {Server#url} — a base URL,
    #     never the +id+ the file wrote.
    # @!attribute [r] model
    #   @return [String] model identifier passed to the transport.
    # @!attribute [r] api_key
    #   @return [String, nil] the referenced {Server}'s {Server#api_key}, or
    #     +nil+ when that server omits it (the bins then fall back to
    #     +"not-needed"+, fine for a local llama.cpp).
    # @!attribute [r] context_window
    #   @return [Integer, nil] explicit context-window cap for this
    #     connection, or +nil+ to let pikuri auto-detect it (its llama.cpp
    #     +/props+ probe, which yields +nil+ for a non-llama server). Set it
    #     for a cloud model the probe can't reach — e.g. a 2M-window model on
    #     x.ai — so the status rule shows a real +used/cap+. Rides the connection's
    #     +Pikuri::Agent::ChatTransport+, so it is correct per-model across a
    #     model switch.
    # @!attribute [r] params
    #   @return [Hash{String => Object}] extra request parameters merged into
    #     every chat completion on this connection, verbatim — e.g.
    #     +{"chat_template_kwargs" => {"enable_thinking" => false}}+ to turn
    #     Qwen 3.6's reasoning off. Frozen, and +{}+ when the entry omits it.
    class Llm < Data
      # _@param_ `name` — see {#name}
      # 
      # _@param_ `server` — see {#server}
      # 
      # _@param_ `model` — see {#model}
      # 
      # _@param_ `api_key` — see {#api_key}
      # 
      # _@param_ `context_window` — see {#context_window}
      # 
      # _@param_ `params` — see {#params}; frozen here
      def initialize: (
                        name: String,
                        server: String,
                        model: String,
                        api_key: String?,
                        context_window: Integer?,
                        ?params: ::Hash[String, Object]
                      ) -> void

      # _@return_ — unique display name, e.g. +"Local Qwen 3.6"+.
      attr_reader name: String

      # _@return_ — the referenced {Server}'s {Server#url} — a base URL,
      # never the +id+ the file wrote.
      attr_reader server: String

      # _@return_ — model identifier passed to the transport.
      attr_reader model: String

      # _@return_ — the referenced {Server}'s {Server#api_key}, or
      # +nil+ when that server omits it (the bins then fall back to
      # +"not-needed"+, fine for a local llama.cpp).
      attr_reader api_key: String?

      # _@return_ — explicit context-window cap for this
      # connection, or +nil+ to let pikuri auto-detect it (its llama.cpp
      # +/props+ probe, which yields +nil+ for a non-llama server). Set it
      # for a cloud model the probe can't reach — e.g. a 2M-window model on
      # x.ai — so the status rule shows a real +used/cap+. Rides the connection's
      # +Pikuri::Agent::ChatTransport+, so it is correct per-model across a
      # model switch.
      attr_reader context_window: Integer?

      # _@return_ — extra request parameters merged into
      # every chat completion on this connection, verbatim — e.g.
      # +{"chat_template_kwargs" => {"enable_thinking" => false}}+ to turn
      # Qwen 3.6's reasoning off. Frozen, and +{}+ when the entry omits it.
      attr_reader params: ::Hash[String, Object]
    end

    # One MCP server definition (coding shell only). Exactly one of
    # {#command} (local stdio subprocess) / {#url} (remote HTTP) is
    # non-nil. Mirrors +Pikuri::Mcp::Registry+'s two entry types without
    # naming them — see the class header's "Pikuri seam" note.
    # 
    # The convenience +bearer_token+ / +basic_auth+ TOML keys are not fields
    # here: {McpTable#resolve} folds them into {#headers}, so this value object
    # exposes only the single +headers+ hash that
    # +Pikuri::Mcp::Registry::HttpEntry+ consumes 1:1.
    # 
    # @!attribute [r] id
    #   @return [String] unique id the LLM uses to call +mcp_connect+.
    # @!attribute [r] command
    #   @return [Array<String>, nil] full argv to spawn a stdio server
    #     (exe first), or +nil+ for an HTTP server.
    # @!attribute [r] url
    #   @return [String, nil] endpoint URL of an HTTP server, or +nil+ for
    #     a stdio server.
    # @!attribute [r] headers
    #   @return [Hash{String => String}] HTTP headers sent on every request
    #     to an HTTP server (auth + custom), frozen. Always empty for a
    #     stdio server.
    # @!attribute [r] env
    #   @return [Hash{String => String}] extra environment variables for a
    #     stdio server's subprocess (merged over the inherited environment),
    #     frozen. Always empty for an HTTP server.
    class McpServer < Data
      # _@param_ `id` — see {#id}
      # 
      # _@param_ `command` — see {#command}
      # 
      # _@param_ `url` — see {#url}
      # 
      # _@param_ `headers` — see {#headers}; frozen here
      # 
      # _@param_ `env` — see {#env}; frozen here
      def initialize: (
                        id: String,
                        ?command: ::Array[String]?,
                        ?url: String?,
                        ?headers: ::Hash[String, String],
                        ?env: ::Hash[String, String]
                      ) -> void

      # _@return_ — true for a local-subprocess (stdio) server.
      def stdio?: () -> bool

      # _@return_ — true for a remote HTTP server.
      def http?: () -> bool

      # _@return_ — unique id the LLM uses to call +mcp_connect+.
      attr_reader id: String

      # _@return_ — full argv to spawn a stdio server
      # (exe first), or +nil+ for an HTTP server.
      attr_reader command: ::Array[String]?

      # _@return_ — endpoint URL of an HTTP server, or +nil+ for
      # a stdio server.
      attr_reader url: String?

      # _@return_ — HTTP headers sent on every request
      # to an HTTP server (auth + custom), frozen. Always empty for a
      # stdio server.
      attr_reader headers: ::Hash[String, String]

      # _@return_ — extra environment variables for a
      # stdio server's subprocess (merged over the inherited environment),
      # frozen. Always empty for an HTTP server.
      attr_reader env: ::Hash[String, String]
    end

    # The web-search selection: which engines to search with, and the keys the
    # paid ones need (chat wires +web_search+ as a main tool; the coding /
    # computer shells wire it sub-agent-only). Every field is +nil+ when
    # omitted, which leaves pikuri's own default — DuckDuckGo plus whichever
    # keyed provider was configured.
    # 
    # The keys are secrets and get the same treatment as {Server#api_key}: stored
    # literally in this parent-only file (never an env var pikuri would
    # inherit into the sandboxed bash / stdio MCP subprocesses, never a CLI
    # flag visible in +ps+), outside the workspace the coding agent reads,
    # and flagged by a logged warning when the file has loose permissions.
    # 
    # Field names match +Pikuri::Tool::WebSearch.build+'s keyword arguments
    # 1:1, and both the bins and the shells rely on that: they splat
    # +search.to_h+ straight into +build+ (and into
    # +Pikuri::Tool::Search::Engines.resolve+ for the boot-time check). Keep the
    # mirror exact — a field pikuri does not take is an unknown-keyword crash at
    # wiring time (see the "Pikuri seam" note).
    # 
    # @!attribute [r] brave_key
    #   @return [String, nil] Brave Search API key, or +nil+ when unset.
    # @!attribute [r] exa_key
    #   @return [String, nil] Exa API key, or +nil+ when unset.
    # @!attribute [r] engines
    #   @return [Array<String>, nil] the engines to search with — any of
    #     +duckduckgo+, +brave+, +exa+ — or +nil+ to let pikuri derive the set
    #     from the keys. A *set*, not a preference order: pikuri shuffles per
    #     query, so +["brave", "duckduckgo"]+ splits traffic between the two
    #     rather than preferring Brave. Naming an engine whose key is absent is
    #     an error pikuri raises; which names exist is pikuri's to say too, so
    #     the file is checked for shape only and no engine list here can rot.
    class Search < Data
      # _@param_ `brave_key` — see {#brave_key}
      # 
      # _@param_ `exa_key` — see {#exa_key}
      # 
      # _@param_ `engines` — see {#engines}; frozen here
      def initialize: (?brave_key: String?, ?exa_key: String?, ?engines: ::Array[String]?) -> void

      # _@return_ — Brave Search API key, or +nil+ when unset.
      attr_reader brave_key: String?

      # _@return_ — Exa API key, or +nil+ when unset.
      attr_reader exa_key: String?

      # _@return_ — the engines to search with — any of
      # +duckduckgo+, +brave+, +exa+ — or +nil+ to let pikuri derive the set
      # from the keys. A *set*, not a preference order: pikuri shuffles per
      # query, so +["brave", "duckduckgo"]+ splits traffic between the two
      # rather than preferring Brave. Naming an engine whose key is absent is
      # an error pikuri raises; which names exist is pikuri's to say too, so
      # the file is checked for shape only and no engine list here can rot.
      attr_reader engines: ::Array[String]?
    end

    # One +[[llm]]+ table as the file writes it; {.load} resolves it into an {Llm}.
    # 
    # @!attribute [r] name
    #   @return [String] see {Llm#name}
    # @!attribute [r] server
    #   @return [String] the {Server#id} this model runs on
    # @!attribute [r] model
    #   @return [String] see {Llm#model}
    # @!attribute [r] api_key
    #   @return [String, nil] never valid here: read only so {.load} can name the
    #     +[[server]]+ it belongs on, where an unknown-key error would not
    # @!attribute [r] context_window
    #   @return [Integer, nil] see {Llm#context_window}
    # @!attribute [r] params
    #   @return [Hash{String => Object}] see {Llm#params}; checked to be a table,
    #     its contents the server's business
    class LlmTable < Data
      extend Typemap::Constrain

      # _@param_ `name` — see {#name}
      # 
      # _@param_ `server` — see {#server}
      # 
      # _@param_ `model` — see {#model}
      # 
      # _@param_ `api_key` — see {#api_key}
      # 
      # _@param_ `context_window` — see {#context_window}
      # 
      # _@param_ `params` — see {#params}
      def initialize: (
                        name: String,
                        server: String,
                        model: String,
                        ?api_key: String?,
                        ?context_window: Integer?,
                        ?params: ::Hash[String, Object]
                      ) -> void

      # _@param_ `raw` — see {Server.entry_name}
      # 
      # _@return_ — its +name+
      def self.entry_name: (::Hash[String, Object] raw) -> Object

      # _@return_ — see {Llm#name}
      attr_reader name: String

      # _@return_ — the {Server#id} this model runs on
      attr_reader server: String

      # _@return_ — see {Llm#model}
      attr_reader model: String

      # _@return_ — never valid here: read only so {.load} can name the
      # +[[server]]+ it belongs on, where an unknown-key error would not
      attr_reader api_key: String?

      # _@return_ — see {Llm#context_window}
      attr_reader context_window: Integer?

      # _@return_ — see {Llm#params}; checked to be a table,
      # its contents the server's business
      attr_reader params: ::Hash[String, Object]
    end

    # A +[[code.mcp]]+ entry's +basic_auth+ table.
    # 
    # @!attribute [r] username
    #   @return [String] non-blank
    # @!attribute [r] password
    #   @return [String]
    class BasicAuth < Data
      extend Typemap::Constrain

      # _@return_ — the +Authorization+ value, strict (newline-free) Base64
      # through +Array#pack+, so no +base64+ require
      def header: () -> String

      # _@return_ — non-blank
      attr_reader username: String

      attr_reader password: String
    end

    # One +[[code.mcp]]+ table as the file writes it; {#resolve} turns it into
    # the {McpServer} the coding bin hands to pikuri-mcp.
    # 
    # +bearer_token+ and +basic_auth+ are sugar for an +Authorization+ header,
    # so they exclude each other and an +Authorization+ entry in +headers+.
    # 
    # @!attribute [r] id
    #   @return [String] see {McpServer#id}
    # @!attribute [r] command
    #   @return [Array<String>, nil] see {McpServer#command}
    # @!attribute [r] url
    #   @return [String, nil] see {McpServer#url}
    # @!attribute [r] bearer_token
    #   @return [String, nil] becomes +Authorization: Bearer …+
    # @!attribute [r] basic_auth
    #   @return [BasicAuth, nil] becomes +Authorization: Basic …+
    # @!attribute [r] headers
    #   @return [Hash{String => String}, nil] extra HTTP headers, sent verbatim
    # @!attribute [r] env
    #   @return [Hash{String => String}, nil] see {McpServer#env}
    class McpTable < Data
      extend Typemap::Constrain

      # _@param_ `id` — see {#id}
      # 
      # _@param_ `command` — see {#command}
      # 
      # _@param_ `url` — see {#url}
      # 
      # _@param_ `bearer_token` — see {#bearer_token}
      # 
      # _@param_ `basic_auth` — see {#basic_auth}
      # 
      # _@param_ `headers` — see {#headers}
      # 
      # _@param_ `env` — see {#env}
      def initialize: (
                        id: String,
                        ?command: ::Array[String]?,
                        ?url: String?,
                        ?bearer_token: String?,
                        ?basic_auth: BasicAuth?,
                        ?headers: ::Hash[String, String]?,
                        ?env: ::Hash[String, String]?
                      ) -> void

      # _@param_ `raw` — see {Server.entry_name}
      # 
      # _@return_ — its +id+
      def self.entry_name: (::Hash[String, Object] raw) -> Object

      def validate: () -> void

      # _@return_ — this entry with its auth sugar folded into +headers+
      def resolve: () -> McpServer

      # _@return_ — see {McpServer#id}
      attr_reader id: String

      # _@return_ — see {McpServer#command}
      attr_reader command: ::Array[String]?

      # _@return_ — see {McpServer#url}
      attr_reader url: String?

      # _@return_ — becomes +Authorization: Bearer …+
      attr_reader bearer_token: String?

      # _@return_ — becomes +Authorization: Basic …+
      attr_reader basic_auth: BasicAuth?

      # _@return_ — extra HTTP headers, sent verbatim
      attr_reader headers: ::Hash[String, String]?

      # _@return_ — see {McpServer#env}
      attr_reader env: ::Hash[String, String]?
    end

    # The +[code]+ table.
    # 
    # @!attribute [r] sandbox
    #   @return [Boolean] see {Config#sandbox}; a CLI flag outranks it
    # @!attribute [r] confirm
    #   @return [Boolean] see {Config#confirm}; a CLI flag outranks it
    # @!attribute [r] mcp
    #   @return [Array<McpTable>] the +[[code.mcp]]+ entries, ids unique
    class CodeTable < Data
      extend Typemap::Constrain

      # _@param_ `sandbox` — see {#sandbox}
      # 
      # _@param_ `confirm` — see {#confirm}
      # 
      # _@param_ `mcp` — see {#mcp}
      def initialize: (?sandbox: bool, ?confirm: bool, ?mcp: ::Array[McpTable]) -> void

      # _@return_ — see {Config#sandbox}; a CLI flag outranks it
      attr_reader sandbox: bool

      # _@return_ — see {Config#confirm}; a CLI flag outranks it
      attr_reader confirm: bool

      # _@return_ — the +[[code.mcp]]+ entries, ids unique
      attr_reader mcp: ::Array[McpTable]
    end

    # The +[ui]+ table (the class header has the why).
    # 
    # @!attribute [r] show_thinking
    #   @return [Boolean] see {Config#show_thinking}
    # @!attribute [r] tool_lines
    #   @return [String] see {Config#tool_lines}; checked against the pane's own
    #     list rather than a copy here that could rot
    class UiTable < Data
      extend Typemap::Constrain

      # _@param_ `show_thinking` — see {#show_thinking}
      # 
      # _@param_ `tool_lines` — see {#tool_lines}
      def initialize: (?show_thinking: bool, ?tool_lines: String) -> void

      # _@return_ — see {Config#show_thinking}
      attr_reader show_thinking: bool

      # _@return_ — see {Config#tool_lines}; checked against the pane's own
      # list rather than a copy here that could rot
      attr_reader tool_lines: String
    end

    # The whole file, every table at its default when the file leaves it out.
    # 
    # @!attribute [r] server
    #   @return [Array<Server>] the +[[server]]+ entries, ids unique
    # @!attribute [r] llm
    #   @return [Array<LlmTable>] the +[[llm]]+ entries, names unique
    # @!attribute [r] search
    #   @return [Search] the +[search]+ table
    # @!attribute [r] code
    #   @return [CodeTable] the +[code]+ table
    # @!attribute [r] ui
    #   @return [UiTable] the +[ui]+ table
    # @!attribute [r] titler
    #   @return [Hash{String => Object}, nil] pikuri-web's table, checked for
    #     shape only (see the class header)
    # @!attribute [r] web
    #   @return [Hash{String => Object}, nil] pikuri-web's table, checked for
    #     shape only
    class Root < Data
      extend Typemap::Constrain

      # _@param_ `server` — see {#server}
      # 
      # _@param_ `llm` — see {#llm}
      # 
      # _@param_ `search` — see {#search}
      # 
      # _@param_ `code` — see {#code}
      # 
      # _@param_ `ui` — see {#ui}
      # 
      # _@param_ `titler` — see {#titler}
      # 
      # _@param_ `web` — see {#web}
      def initialize: (
                        ?server: ::Array[Server],
                        ?llm: ::Array[LlmTable],
                        ?search: Search,
                        ?code: CodeTable,
                        ?ui: UiTable,
                        ?titler: ::Hash[String, Object]?,
                        ?web: ::Hash[String, Object]?
                      ) -> void

      # _@return_ — the +[[server]]+ entries, ids unique
      attr_reader server: ::Array[Server]

      # _@return_ — the +[[llm]]+ entries, names unique
      attr_reader llm: ::Array[LlmTable]

      # _@return_ — the +[search]+ table
      attr_reader search: Search

      # _@return_ — the +[code]+ table
      attr_reader code: CodeTable

      # _@return_ — the +[ui]+ table
      attr_reader ui: UiTable

      # _@return_ — pikuri-web's table, checked for
      # shape only (see the class header)
      attr_reader titler: ::Hash[String, Object]?

      # _@return_ — pikuri-web's table, checked for
      # shape only
      attr_reader web: ::Hash[String, Object]?
    end
  end

  # Derives the borderless-chrome colors from the terminal's reported background
  # RGB (+Tuile::Screen#background_color+): the secondary panes' background tint
  # ({.pane_bg}) and the +─+/+│+ hairline colors ({.hairline}). Stateless; called
  # from {Shared::AppTheme}'s derived tokens, which the screen resolves whenever
  # the reported background changes, and unit-tested from canned backgrounds.
  # 
  # The derivation preserves hue — popular terminal themes are rarely neutral
  # (Catppuccin Mocha +#1e1e2e+ is purple-blue) and a neutral-grey prompt well
  # next to a hue-tinted conversation pane looks dirty — so every step is an HSL
  # round-trip moving only lightness, *toward mid-grey*: a dark background
  # lightens, a light one darkens. Toward-grey rather than toward-the-pole
  # because the pole rule dies exactly at +#000+/+#fff+, the two most common
  # terminal backgrounds, where toward-grey's failure case (a mid-grey terminal)
  # exists on no real terminal.
  # 
  # Ported from virtui's +UI::Tint+, which carries the measurement table behind
  # {DELTA} in its +DECISIONS.md+ → +tint_toward_grey+; the local consequences
  # are in +design/decisions.md+, +D_borderless_panes+.
  # 
  # Thread-safe (pure functions over immutable values).
  module Tint
    DELTA: Float
    HAIRLINE_DELTA: Float
    CONTRAST_FLOOR: Float

    # The secondary-pane background: +background+ stepped {DELTA} toward
    # mid-grey, unless that would drag a guarded foreground token under
    # {CONTRAST_FLOOR} — then the step flips away from grey instead. The flip is
    # expected dead on every real terminal; it protects the backgrounds never
    # measured.
    # 
    # _@param_ `background` — the terminal background; must carry RGB.
    # 
    # _@param_ `guard` — foreground tokens rendered on the tinted pane; entries without a knowable RGB (symbolic ANSI colors, remapped by the terminal) are skipped.
    # 
    # _@return_ — the pane background, 24-bit RGB.
    def pane_bg: (Tuile::Color background, ?guard: ::Array[Tuile::Color]) -> Tuile::Color

    # The secondary-pane background: +background+ stepped {DELTA} toward
    # mid-grey, unless that would drag a guarded foreground token under
    # {CONTRAST_FLOOR} — then the step flips away from grey instead. The flip is
    # expected dead on every real terminal; it protects the backgrounds never
    # measured.
    # 
    # _@param_ `background` — the terminal background; must carry RGB.
    # 
    # _@param_ `guard` — foreground tokens rendered on the tinted pane; entries without a knowable RGB (symbolic ANSI colors, remapped by the terminal) are skipped.
    # 
    # _@return_ — the pane background, 24-bit RGB.
    def self.pane_bg: (Tuile::Color background, ?guard: ::Array[Tuile::Color]) -> Tuile::Color

    # A hairline color for rules drawn on +ground+: the ground stepped
    # {HAIRLINE_DELTA} toward mid-grey — always the same perceptual distance
    # away, whatever the terminal's background.
    # 
    # _@param_ `ground` — the background the hairline sits on; must carry RGB.
    # 
    # _@return_ — the hairline color, 24-bit RGB.
    def hairline: (Tuile::Color ground) -> Tuile::Color

    # A hairline color for rules drawn on +ground+: the ground stepped
    # {HAIRLINE_DELTA} toward mid-grey — always the same perceptual distance
    # away, whatever the terminal's background.
    # 
    # _@param_ `ground` — the background the hairline sits on; must carry RGB.
    # 
    # _@return_ — the hairline color, 24-bit RGB.
    def self.hairline: (Tuile::Color ground) -> Tuile::Color

    # WCAG 2.x contrast ratio between two colors.
    # 
    # _@param_ `first` — a color or RGB triple.
    # 
    # _@param_ `second` — a color or RGB triple.
    # 
    # _@return_ — the ratio, 1.0..21.0.
    def contrast: ((Tuile::Color | ::Array[Integer]) first, (Tuile::Color | ::Array[Integer]) second) -> Float

    # WCAG 2.x contrast ratio between two colors.
    # 
    # _@param_ `first` — a color or RGB triple.
    # 
    # _@param_ `second` — a color or RGB triple.
    # 
    # _@return_ — the ratio, 1.0..21.0.
    def self.contrast: ((Tuile::Color | ::Array[Integer]) first, (Tuile::Color | ::Array[Integer]) second) -> Float

    # Which way mid-grey lies from +rgb+, on the HSL lightness axis.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — +1+ (lighten) below mid-lightness, else +-1+ (darken).
    def direction: (::Array[Integer] rgb) -> Integer

    # Which way mid-grey lies from +rgb+, on the HSL lightness axis.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — +1+ (lighten) below mid-lightness, else +-1+ (darken).
    def self.direction: (::Array[Integer] rgb) -> Integer

    # +rgb+ with its HSL lightness moved by +delta+ (clamped to 0..1), hue and
    # saturation held.
    # 
    # _@param_ `rgb`
    # 
    # _@param_ `delta` — signed lightness delta.
    # 
    # _@return_ — the stepped RGB triple.
    def step: (::Array[Integer] rgb, Float delta) -> ::Array[Integer]

    # +rgb+ with its HSL lightness moved by +delta+ (clamped to 0..1), hue and
    # saturation held.
    # 
    # _@param_ `rgb`
    # 
    # _@param_ `delta` — signed lightness delta.
    # 
    # _@return_ — the stepped RGB triple.
    def self.step: (::Array[Integer] rgb, Float delta) -> ::Array[Integer]

    # WCAG relative luminance of an RGB triple.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — 0.0..1.0.
    def luminance: (::Array[Integer] rgb) -> Float

    # WCAG relative luminance of an RGB triple.
    # 
    # _@param_ `rgb`
    # 
    # _@return_ — 0.0..1.0.
    def self.luminance: (::Array[Integer] rgb) -> Float

    # RGB → HSL.
    # 
    # _@param_ `rgb` — channels 0..255.
    # 
    # _@return_ — hue in degrees, saturation 0..1,
    # lightness 0..1.
    def to_hsl: (::Array[Integer] rgb) -> [Float, Float, Float]

    # RGB → HSL.
    # 
    # _@param_ `rgb` — channels 0..255.
    # 
    # _@return_ — hue in degrees, saturation 0..1,
    # lightness 0..1.
    def self.to_hsl: (::Array[Integer] rgb) -> [Float, Float, Float]

    # HSL → RGB.
    # 
    # _@param_ `hue` — hue in degrees.
    # 
    # _@param_ `sat` — saturation 0..1.
    # 
    # _@param_ `light` — lightness 0..1.
    # 
    # _@return_ — channels 0..255.
    def from_hsl: (Float hue, Float sat, Float light) -> ::Array[Integer]

    # HSL → RGB.
    # 
    # _@param_ `hue` — hue in degrees.
    # 
    # _@param_ `sat` — saturation 0..1.
    # 
    # _@param_ `light` — lightness 0..1.
    # 
    # _@return_ — channels 0..255.
    def self.from_hsl: (Float hue, Float sat, Float light) -> ::Array[Integer]
  end
end