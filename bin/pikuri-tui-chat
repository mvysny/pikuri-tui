#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Tuile chat TUI built on Pikuri::Agent.
#
# Pin Bundler to this project's Gemfile so locked dependency versions win and
# the script works when invoked via a symlink (e.g. ~/.local/bin/pikuri-tui-chat)
# from any working directory. `__dir__` resolves through symlinks, so this
# points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

# Activate only the shared :default group — NOT the :code group, whose
# six extra pikuri gems (workspace/code/tasks/skills/mcp/subagents) the
# chat shell never touches. The explicit +Bundler.setup+ form (rather
# than +require 'bundler/setup'+, which activates every group) keeps
# those off this process's load path. The chat shell has no group of
# its own — its deps (tuile, kramdown, rouge, pikuri-core, pikuri-pdf)
# all live in :default.
require 'bundler'
Bundler.setup(:default)
require 'optparse'

# pikuri-tui has no published gemspec yet — wired only as a path dependency
# from this Gemfile — so its +lib/+ is not on Bundler's load path. Adding it
# here lets +require 'pikuri_tui'+ resolve through Zeitwerk.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri_tui'

server = 'http://localhost:8080'
model  = 'unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M'
api_key_env = 'OPENAI_API_KEY'

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-tui-chat [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--server URL', "LLM server base URL (default: #{server})") { |v| server = v }
  opts.on('--model NAME', "Model identifier (default: #{model})") { |v| model = v }
  opts.on('--api-key-env VAR', "Env var holding the API key (default: #{api_key_env})") { |v| api_key_env = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

server = server.chomp('/')
openai_api_base = "#{server}/v1"

api_key = ENV[api_key_env]
api_key_missing = api_key.nil? || api_key.strip.empty?
api_key = 'not-needed' if api_key_missing

Pikuri::Extractors::PDF.register

RubyLLM.configure do |c|
  c.openai_api_base = openai_api_base
  c.openai_api_key  = api_key
end

# llama.cpp exposes the server's launched +n_ctx+ at +/props+ on the base
# host (not under +/v1+). Hand the derived URL to
# +Pikuri::Agent::ContextWindowDetector+ so the cap is resolved against the
# local server, which is unknown to ruby_llm's bundled model registry.
llama_probe_url = "#{server}/props"

cancel_flag = Pikuri::Agent::Control::Cancellable.new

# Mid-loop input channel: PikuriTui::Chat::App injects messages submitted
# while a turn is in flight; the agent drains the queue at every
# after_tool_result boundary, and App delivers any leftovers as a fresh
# turn when the loop ends.
interloper = Pikuri::Agent::Control::Interloper.new

system_prompt = Pikuri.prompt(:'pikuri-chat')
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"

Tuile::Screen.new

# Constructed up front so both the App (for the footer's status line) and the
# Agent's ListenerList see the same TokenLog instance.
token_log = Pikuri::Agent::Listener::TokenLog.new

app = PikuriTui::Chat::App.new(token_log: token_log) do |listener|
  # Coalesce streaming delta chunks at 15 fps before they reach the
  # Markdown-rendering TuileListener: a fast llama.cpp can emit dozens
  # of deltas per second and re-rendering Markdown on every one is
  # wasted work the user can't perceive. flush_pending_on_non_delta:
  # false because the Assistant / Thinking bookend events re-render
  # the authoritative final content (see TuileListener#flush_assistant
  # / #flush_thinking), so emitting the trailing 0–66 ms of buffered
  # deltas right before the redraw is pure CPU waste.
  rate_limited_listener = Pikuri::Agent::Listener::RateLimited.new(
    listener,
    fps: 15,
    flush_pending_on_non_delta: false
  )
  Pikuri::Agent.new(
    transport: Pikuri::Agent::ChatTransport.new(
      model: model,
      provider: :openai,
      assume_model_exists: true
    ),
    system_prompt: system_prompt,
    step_limit: Pikuri::Agent::Control::StepLimit.new(max: 20),
    cancellable: cancel_flag,
    interloper: interloper,
    llama_probe_url: llama_probe_url,
    streaming: true
  ) do |c|
    c.add_listener rate_limited_listener
    c.add_listener token_log
    c.add_tool Pikuri::Tool::WEB_SEARCH
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_tool Pikuri::Tool::WEB_SCRAPE
    c.add_tool Pikuri::Tool::FETCH
  end
end

if api_key_missing
  Tuile.logger.warn(
    "API key env var #{api_key_env} is blank or unset; falling back to \"not-needed\" " \
    '(fine for local llama.cpp, will fail against authenticated remotes)'
  )
end

app.run
