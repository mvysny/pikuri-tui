#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Tuile chat TUI built on Pikuri::Agent.
#
# Pin Bundler to this project's Gemfile so locked dependency versions win and
# the script works when invoked via a symlink (e.g. ~/.local/bin/pikuri-tui-chat)
# from any working directory. `__dir__` resolves through symlinks, so this
# points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

# Activate only the shared :default group — NOT the :code group, whose
# six extra pikuri gems (workspace/code/tasks/skills/mcp/subagents) the
# chat shell never touches. The explicit +Bundler.setup+ form (rather
# than +require 'bundler/setup'+, which activates every group) keeps
# those off this process's load path. The chat shell has no group of
# its own — its deps (tuile, kramdown, rouge, pikuri-core, pikuri-pdf)
# all live in :default.
require 'bundler'
Bundler.setup(:default)
require 'optparse'

# pikuri-tui has no published gemspec yet — wired only as a path dependency
# from this Gemfile — so its +lib/+ is not on Bundler's load path. Adding it
# here lets +require 'pikuri_tui'+ resolve through Zeitwerk.
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri_tui'

# Boot-time logging goes to stderr until the screen is up. A Shared::Log::BufferingIO
# tees every pre-screen log line to stderr (so a crash before the screen still
# prints) AND retains it, so App#wire_logging can replay those lines — config
# file reads, chmod 600 advisories, model wiring — into the diagnostic
# LogWindow once it rewires Pikuri.log_io there. pikuri's loggers
# (Pikuri.logger_for) default to $stderr; we override that with the buffer.
Pikuri.log_io = Shared::Log::BufferingIO.new

# CLI overrides start nil ("flag not given") so Shared::Config can tell
# an explicit flag from an absent one; they override the selected
# connection's fields on top of the config file. Built-in defaults live in
# Shared::Config, the single source of truth shown in --help.
cli_server = nil
cli_model  = nil

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-tui-chat [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--server URL', "LLM server base URL (default: #{Shared::Config::DEFAULT_SERVER})") { |v| cli_server = v }
  opts.on('--model NAME', "Model identifier (default: #{Shared::Config::DEFAULT_MODEL})") { |v| cli_model = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Load the layered config (XDG search path) and overlay the CLI flags. There
# is no --api-key flag: a key must never travel on the command line (visible
# in ps / shell history) — it comes only from the config file. Boot-time,
# before the screen is up, so a bad file is a plain warn + exit, not a
# torn-down TUI.
begin
  config = Shared::Config.load(overrides: { server: cli_server, model: cli_model })
rescue Shared::Config::Error => e
  warn "config error: #{e.message}"
  exit 2
end

# Mount the screen and install the app's theme pair (built-in accents +
# pikuri-tui's own tool/notice/error/thinking/detail tokens) durably, so OS
# light/dark flips re-pick the legible variant instead of falling back to the
# stock Tuile theme. App assumes the screen singleton is already installed
# (tests inject Tuile::Screen.fake), so the bin mounts it here.
Tuile::Screen.new
Tuile::Screen.instance.theme_def = Shared::AppTheme::THEME_DEF

# Hand off: App owns the agent. From the config it derives the model list
# (one Shared::Model::Choice per [[llm]], the first the boot connection),
# builds the streaming Pikuri::Agent with the chat system prompt and the
# web/calc tool set, and wires the conversation listeners. The bin's job
# ends at CLI + config + screen.
Chat::App.new(config: config).run
