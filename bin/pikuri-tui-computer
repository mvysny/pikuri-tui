#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Tuile "computer" TUI built on Pikuri::Agent — one local
# desktop assistant for this machine that composes two pikuri surfaces: the
# OS helper (understand + operate this Linux host) and local Thunderbird mail
# + calendar. Same Tuile shell as bin/pikuri-tui-chat (one conversation pane
# over an input strip, no sidebar), wired with the five file tools + a
# sandboxed bash via Pikuri::Os::Extension, mail/calendar search+read + two
# outbound draft hand-offs via Pikuri::Thunderbird::Extension, a Tuile modal
# confirmer for mutations, plan mode, and the edit/write diff view.
#
# This is pikuri's "reassembled trifecta": whole-disk private pool +
# attacker-authorable email (untrusted) + egress. Every egress leg is
# HUMAN-GATED, never autonomous — bash is kernel-severed, each web-research
# task is approved before dispatch, and every mail/event is a Send/confirm the
# user performs in Thunderbird's own UI. The pikuri-side wiring is ported
# from pikuri's own pikuri-os/bin/pikuri-computer demo; everything Tuile —
# and, since the bin→App refactor, the whole agent object graph — is
# Computer::App's job. The bin does CLI + config + Thunderbird-profile probe
# + screen mount only.
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g.
# ~/.local/bin/pikuri-tui-computer) from any working directory. `__dir__`
# resolves through symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

# Activate :default + :computer — the computer shell needs pikuri-os +
# pikuri-thunderbird (which pull in pikuri-workspace + pikuri-code), diff-lcs
# and pikuri-skills (for its Command::Registry half only — no skill catalog is
# wired here), but NOT the coding shell's tasks/mcp gems. The explicit
# +Bundler.setup+ form (not +require 'bundler/setup'+, which activates every
# group) keeps the :code and :test groups off this process's load path.
require 'bundler'
Bundler.setup(:default, :computer)
require 'optparse'

# pikuri-tui has no published gemspec yet — wired only as a path dependency
# from this Gemfile — so its +lib/+ is not on Bundler's load path. Adding it
# here lets +require 'pikuri_tui'+ resolve through Zeitwerk. pikuri-os is
# required BEFORE pikuri_tui so its loader sees +Pikuri::Workspace+ and
# eager-loads the Computer (and reused Code) subtree (see
# the gate in lib/pikuri_tui.rb).
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-os' # pulls in pikuri-workspace + pikuri-code
require 'pikuri-thunderbird' # local mail + calendar tools + outbound hand-offs
require 'pikuri-subagents' # the `agent` tool + RESEARCHER persona (web research)
require 'pikuri-skills' # Command::Registry — the /name prompt templates (no skill catalog here)
require 'pikuri-pdf' # PDF text extraction for the RESEARCHER's web_scrape + file read
require 'pikuri-web' # the RESEARCHER's web tools
require 'pikuri-conversations' # the conversation the agent runs on
require 'pikuri_tui'

# Boot-time logging goes to stderr until the screen is up. A Shared::Log::BufferingIO
# tees every pre-screen log line to stderr (so a crash before the screen still
# prints) AND retains it, so Shared::Log::UI#wire! can replay those lines — config
# file reads, chmod 600 advisories, model wiring — into the diagnostic
# log dialog once it rewires Pikuri.log_io there. pikuri's loggers
# (Pikuri.logger_for) default to $stderr; we override that with the buffer.
Pikuri.log_io = Shared::Log::BufferingIO.new

# This bin's own logger. Like every pikuri-tui logger it goes through
# Pikuri.logger_for (NOT Tuile.logger — see AGENTS.md), so it writes to
# stderr now and to the log dialog once App rewires Pikuri.log_io.
main_log = Pikuri.logger_for('main')

# CLI overrides start nil ("flag not given") so Shared::Config can tell
# an explicit flag from an absent one. The sandbox/confirm flags only ever
# force false (there is no --sandbox / --confirm); config sets the baseline.
# Built-in defaults live in Shared::Config, shown in --help.
cli_sandbox = nil
cli_confirm = nil

# No --server / --model: the connection comes from a [[llm]] table only —
# see Shared::Config's "No connection overrides".

# Bin-local flags (not config-file concerns, so not routed through
# Shared::Config): web research is ON by default — a "computer" reaches out —
# and the Thunderbird profile auto-discovers unless pinned. Both are handed
# straight to Computer::App.
internet_enabled = true
profile_dir = nil

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-tui-computer [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--no-sandbox', 'Disable the network sandbox around bash. WARNING: bash can then ' \
                          'reach the internet — the no-egress security property is OFF.') { cli_sandbox = false }
  opts.on('--no-confirm', 'Auto-approve every confirmation (skip the y/n prompt for writes + bash).') do
    cli_confirm = false
  end
  opts.on('--no-internet', 'Disable web research (drop the RESEARCHER sub-agent). Mail + calendar ' \
                           'still work, and Thunderbird\'s compose/create hand-offs remain the only ' \
                           'egress leg — human-gated in Thunderbird\'s UI.') { internet_enabled = false }
  opts.on('--profile-dir DIR', 'Thunderbird profile directory (overrides auto-discovery).') { |v| profile_dir = v }
  opts.on('--yolo', 'Combines --no-sandbox + --no-confirm. Use only in a throwaway environment.') do
    cli_sandbox = false
    cli_confirm = false
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Load the layered config (XDG search path only — there is no project-local
# layer, so a secret-bearing config can never sit inside a tree the agent
# reads). The only CLI overlay left is the safety pair, which can only force
# false; the connection comes from the file alone (no --server / --model, and
# never an --api-key: a key must not travel on the command line). Boot-time,
# before the screen is up, so a bad file is a plain warn + exit rather than a
# torn-down TUI.
begin
  config = Shared::Config.load(overrides: { sandbox: cli_sandbox, confirm: cli_confirm })
  # Which engines web_search may use is pikuri's to validate — it owns the
  # engine list and knows which of them need a key. Asked here so an unusable
  # [search] selection is the same plain warn + exit as any other config
  # error, not an ArgumentError from inside the agent wiring.
  Pikuri::Web::Search::Engines.resolve(**config.search.to_h)
rescue Shared::Config::Error, ArgumentError => e
  warn "config error: #{e.message}"
  exit 2
end

# Probe the Thunderbird profile now, before the screen is up, so an ambiguous
# install (profiles under two roots) fails as a plain warn + exit rather than
# a torn-down TUI — a friendly CLI message, not the backtrace the App-side
# extension would otherwise raise. Profile.discover is idempotent — the
# Thunderbird::Extension runs it again at wire time; a nil return (Thunderbird
# not installed) is fine, the extension then registers nothing.
begin
  Pikuri::Thunderbird::Profile.discover(profile_dir: profile_dir)
rescue Pikuri::Thunderbird::Profile::DiscoveryError => e
  warn "Thunderbird profile problem: #{e.message}"
  exit 1
end

Tuile::Screen.new
# Install the app's theme pair (built-in accents + pikuri-tui's own
# tool/notice/error/thinking/detail tokens) durably, so OS light/dark
# flips re-pick the legible variant instead of falling back to the
# stock Tuile theme.
Tuile::Screen.instance.theme_def = Shared::AppTheme::THEME_DEF

# Hand off: App owns the conversation and the agent's whole object graph — from
# config it derives the model list, assembles the OS-assistant prompt, builds
# the FullFsNoNet sandbox (whose bwrap probe may raise) and boots an agent with
# the Os + Thunderbird + RESEARCHER extensions on a thread of its own.
# Tuile::Screen.new has NOT yet entered raw mode / the alternate
# buffer (that is run_event_loop's job), so a raise during App.new still
# reaches a normal terminal; the begin/ensure below tears the screen down on
# any escape — construction OR loop — which is why Computer::App#run no longer
# closes it itself. The boot diagnostics sit inside the begin so they land in
# the log dialog (App.new has rewired Pikuri.log_io to it by then), never in the
# conversation pane (AGENTS.md).
begin
  app = Computer::App.new(config: config, internet_enabled: internet_enabled, profile_dir: profile_dir)

  main_log.info("Working from #{app.project_root}")
  unless app.command_registry.empty?
    names = app.command_registry.list.map { |cmd| "/#{cmd.name}#{cmd.refused? ? ' (unavailable)' : ''}" }
    main_log.info("Loaded #{app.command_registry.list.size} command(s): #{names.sort.join(', ')}")
  end
  main_log.info('Local Thunderbird mail + calendar wired; drafts (reply / event) open in ' \
                'Thunderbird for you to review and Send/confirm — pikuri sends nothing itself.')
  if internet_enabled
    main_log.info('Web research enabled via an isolated RESEARCHER sub-agent (web tools, no filesystem); ' \
                  'you approve each research task before it runs. The main agent has no direct web access; ' \
                  'bash stays network-severed regardless.')
  else
    main_log.info('Web research disabled (--no-internet). Mail + calendar still work; drafts open in ' \
                  'Thunderbird for you to Send/confirm.')
  end
  safety = []
  safety << 'Network sandbox: DISABLED — bash can reach the internet (egress is OPEN).' unless config.sandbox
  safety << 'Confirmer: AUTO-APPROVE — mutations run without asking.' unless config.confirm
  unless safety.empty?
    safety << 'Use only in a throwaway environment.'
    main_log.warn(safety.join(' '))
  end

  app.run
ensure
  Tuile::Screen.close
end
