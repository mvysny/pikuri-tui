#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Tuile coding TUI built on Pikuri::Agent — the
# in-repo coding agent. Same shape as bin/pikuri-tui-chat, but wired with
# the six file/shell tools, a project-rooted workspace, the bubblewrap
# sandbox, and an in-transcript confirmer instead of the stdin one. The
# pikuri-side wiring is ported from pikuri's own bin/pikuri-code demo;
# everything Tuile — and, since the bin→App refactor, the whole agent object
# graph — is Code::App's job. The bin does the genuinely pre-screen boot
# sequencing that App can't: CLI parsing, project-root discovery + chdir, the
# workspace/sandbox, the interactive git-trust prompt, and the
# posture-reflecting system prompt.
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g.
# ~/.local/bin/pikuri-tui-code) from any working directory. `__dir__`
# resolves through symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

# Activate :default + :code — the coding shell needs the heavier pikuri
# gems (workspace/code/tasks/skills/mcp/subagents) that the chat shell
# does not. The explicit +Bundler.setup+ form (not +require
# 'bundler/setup'+, which activates every group) keeps the :test group
# off this process's load path.
require 'bundler'
Bundler.setup(:default, :code)
require 'optparse'

# pikuri-tui has no published gemspec yet — wired only as a path
# dependency from this Gemfile — so its +lib/+ is not on Bundler's load
# path. Adding it here lets +require 'pikuri_tui'+ resolve through
# Zeitwerk. The :code gems are required BEFORE pikuri_tui so its loader
# sees the :code runtime and eager-loads the Code subtree (see
# lib/pikuri_tui.rb).
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri-workspace'
require 'pikuri-code'
require 'pikuri-tasks'
require 'pikuri-skills'
require 'pikuri-mcp'
require 'pikuri-subagents'
require 'pikuri_tui'

# Boot-time logging goes to stderr until the screen is up. A Shared::Log::BufferingIO
# tees every pre-screen log line to stderr (so a crash before the screen still
# prints) AND retains it, so Shared::Log::UI#wire! can replay those lines — config
# file reads, chmod 600 advisories, model wiring — into the diagnostic
# log dialog once it rewires Pikuri.log_io there. pikuri's loggers
# (Pikuri.logger_for) default to $stderr; we override that with the buffer.
Pikuri.log_io = Shared::Log::BufferingIO.new

# This bin's own logger. Like every pikuri-tui logger it goes through
# Pikuri.logger_for (NOT Tuile.logger — see AGENTS.md), so it writes to
# stderr now and to the log dialog once App rewires Pikuri.log_io.
main_log = Pikuri.logger_for('main')

# CLI overrides start nil ("flag not given") so Shared::Config can tell
# an explicit flag from an absent one. The sandbox/confirm flags only ever
# force false (there is no --sandbox / --confirm); config sets the baseline.
# Built-in defaults live in Shared::Config, shown in --help.
yolo = false
extra_readable = []
extra_writable = []
cli_sandbox = nil
cli_confirm = nil

# No --server / --model: the connection comes from a [[llm]] table only —
# see Shared::Config's "No connection overrides".
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-tui-code [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--no-sandbox', 'Disable the bubblewrap sandbox around bash commands.') { cli_sandbox = false }
  # Expanded eagerly (the handler runs at parse!, before the chdir to the
  # discovered project root below) so relative paths and ~ resolve
  # against where the user launched, not where the project lives.
  opts.on('--readable PATH', 'Additional read-only directory (repeatable).') do |v|
    extra_readable << File.expand_path(v)
  end
  opts.on('--writable PATH', 'Additional read+write directory (repeatable).') do |v|
    extra_writable << File.expand_path(v)
  end
  opts.on('--no-confirm', 'Auto-approve every confirmation (skip the y/n prompt for writes + bash).') do
    cli_confirm = false
  end
  opts.on('--yolo', 'Combines --no-sandbox + --no-confirm + opens the filesystem ' \
                    '(credential denylist only). Use only inside a container.') do
    cli_sandbox = false
    cli_confirm = false
    yolo = true
  end
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Fail fast with a readable message — Filesystem.new realpath's its
# readable:/writable: entries and a missing one raises a bare
# Errno::ENOENT much later, mid-construction. This is boot-time, before
# the screen is up, so a plain warn + exit is correct.
(extra_readable + extra_writable).each do |path|
  next if File.directory?(path)

  warn "no such directory: #{path}"
  exit 2
end

# Climb from the launch directory to the project root (a VCS marker:
# .git / .hg / .svn), and chdir the whole process to it so the file
# tools, Bash, Grep, Glob all operate against one anchor — see
# Pikuri::Workspace::ProjectRoot. Falls back to the launch dir.
launch_cwd   = Pathname.new(Dir.pwd)
project_root = Pikuri::Workspace::ProjectRoot.find(cwd: launch_cwd) || launch_cwd
chdir_notice = ("Changing working directory to project root: #{project_root}" if Dir.pwd != project_root.to_s)
Dir.chdir(project_root.to_s) if chdir_notice

# Load the layered config (XDG search path only — there is no project-local
# layer, so a secret-bearing config can never sit inside the repo the agent
# reads). The only CLI overlay left is the safety pair, which can only force
# false; the connection comes from the file alone (no --server / --model, and
# never an --api-key: a key must not travel on the command line). Boot-time,
# before the screen is up, so a bad file is a plain warn + exit rather than a
# torn-down TUI.
begin
  config = Shared::Config.load(overrides: { sandbox: cli_sandbox, confirm: cli_confirm })
  # Which engines web_search may use is pikuri's to validate — it owns the
  # engine list and knows which of them need a key. Asked here so an unusable
  # [search] selection is the same plain warn + exit as any other config
  # error, not an ArgumentError from inside the agent wiring.
  Pikuri::Tool::Search::Engines.resolve(**config.search.to_h)
rescue Shared::Config::Error, ArgumentError => e
  warn "config error: #{e.message}"
  exit 2
end

sandbox_enabled = config.sandbox
confirm_enabled = config.confirm

# Skill catalog: project root + Dir.home as search bases (project beats
# global). Catalog roots are folded into the workspace's readable set so
# the skill tool's sidecar +read+ flow works.
bundle_bases = [project_root, Dir.home]
skill_catalog = Pikuri::Skill::Catalog::Bundled.new(search_bases: bundle_bases)

# Slash commands: the *human*-invoked half of the same surface, scanned from
# .pikuri/commands / .claude/commands under those same bases. Never advertised
# to the model, so they cost nothing in the system prompt; App turns each into
# a palette entry. Their roots ride in readable: (never writable:) so the model
# can read a file a command body points at.
command_registry = Pikuri::Command::Registry.new(search_bases: bundle_bases)

# The private-data declaration, sole input to the trifecta's private leg (see
# Code::PrivacyStore). A question and not a --private flag because a forgotten
# flag fails silent, and silent over a repo full of secrets is the outcome the
# detector exists to prevent. Nothing is gated on the answer: it changes what
# /trifecta says, never what the agent may do.
#
# Gated on a TTY only, deliberately NOT on confirm_enabled the way the git
# prompt below is: skipping that one fails safe (nothing gets auto-approved)
# while skipping this one fails silent, so --yolo would otherwise take the
# quiet reading over exactly the repo that most wants the loud one.
privacy_store = Code::PrivacyStore.new
private_answer = privacy_store.answer(project_root)
if private_answer.nil? && $stdin.tty?
  private_answer = Pikuri::Workspace::Confirmer::Terminal.new.confirm?(
    request: Pikuri::Workspace::Confirmer::Request.new(
      question: 'Does this project hold anything you would mind leaking ' \
                '(credentials, client work, unpublished code)?',
      detail: "#{project_root}\n\nAsked once per project. This sets one line of the " \
              '/trifecta report; it blocks nothing either way. Say yes and the report ' \
              'will tell you whenever this agent simultaneously holds private data, ' \
              'attacker-authored content, and a way to send bytes out.'
    )
  )
  privacy_store.record!(project_root, private: private_answer)
end
private_repo = private_answer || false
# Logged (not echoed into the conversation pane) once App has rewired
# Pikuri.log_io to the log dialog, alongside the trust notice below.
privacy_notice =
  case private_answer
  when true then 'Project declared private: /trifecta counts the private leg.'
  when false then 'Project declared public: /trifecta counts no private leg.'
  else 'Project privacy undeclared (no TTY to ask): assuming public, so /trifecta counts no private leg.'
  end

# Workspace: project_root is the writable ceiling, the bind root, the
# relative-path base. temp: true mints an ephemeral writable scratch dir.
# private: is the declaration above — read by the file tools' trifecta legs
# only, never by any access check. --yolo swaps in AllowAll (everything but the
# credential denylist).
filesystem = if yolo
               warn '--readable/--writable ignored under --yolo (filesystem is ALLOW_ALL).' \
                 unless extra_readable.empty? && extra_writable.empty?
               Pikuri::Workspace::Filesystem::AllowAll.new(
                 project_root:      project_root,
                 temp:              true,
                 alias_tmp_to_temp: sandbox_enabled,
                 private:           private_repo
               )
             else
               Pikuri::Workspace::Filesystem.new(
                 project_root:      project_root,
                 readable:          Pikuri::Code::ToolchainPaths.readable +
                                    skill_catalog.roots +
                                    command_registry.roots +
                                    extra_readable,
                 writable:          extra_writable,
                 temp:              true,
                 alias_tmp_to_temp: sandbox_enabled,
                 private:           private_repo
               )
             end

# Bubblewrap sandbox wraps every Bash subprocess. Probes `bwrap` at
# construction and raises if it isn't installed / the kernel lacks
# user-namespace support — fail-loud. Boot-time, before the screen is up,
# so the raise prints a backtrace to a normal terminal. Built here (not in
# Code::App) so this security-critical layer sits next to the filesystem it
# wraps, in the boot script the auditor reads. Disable with --no-sandbox /
# --yolo.
sandbox = if sandbox_enabled
            Pikuri::Code::Bash::Sandbox::Bubblewrap.new(
              filesystem: filesystem
            )
          else
            Pikuri::Code::Bash::Sandbox::NONE
          end

# Git-config trust gate. trusted_repo flips PassiveCommandDetector's allow_git:
# (wired inside Code::App#default_build_agent) so a trusted repo also
# auto-approves read-only git (status/diff/log/show/…). Sound ONLY with the
# user's affirmation: even a bare `git diff` executes whatever the repo's
# .git/config / .gitattributes direct (textconv, fsmonitor), and the sandbox's
# shared network could exfiltrate. Trust is per-path, persisted in TrustStore
# so we ask at most once per project. Gates, cheapest first:
#   - confirm_enabled: under --no-confirm/--yolo the confirmer is AUTO_APPROVE,
#     so allow_git is moot AND we must not persist a grant the user didn't make.
#   - .git exists: git repos only (.exist?, not .directory? — linked worktrees
#     and submodules carry a .git *file*).
#   - already trusted: honored even under piped stdin; no prompt needed.
#   - else prompt, but only on an interactive TTY. Reuses Confirmer::Terminal
#     (sanitized puts/gets straight to the terminal — NOT the Shared::Log::BufferingIO),
#     the same primitive upstream bin/pikuri-code uses; we add persistence.
# This must run before Tuile::Screen.new (a prompt is invisible once the
# alternate screen buffer is up) and stay OUT of App (which builds the agent
# and may re-run under a test override — re-prompting/re-persisting there would
# be a bug; App only reads the captured boolean).
trust_store = Code::TrustStore.new
trusted_repo =
  confirm_enabled &&
  filesystem.project_root.join('.git').exist? &&
  (trust_store.trusted?(filesystem.project_root) ||
   ($stdin.tty? &&
    begin
      granted = Pikuri::Workspace::Confirmer::Terminal.new.confirm?(
        request: Pikuri::Workspace::Confirmer::Request.new(
          question: "Trust this directory's git config? Read-only git " \
                    '(status/diff/log/show/…) will then run WITHOUT confirmation.',
          detail: "#{filesystem.project_root}\n\nSay yes ONLY if you control this repo's " \
                  '.git/config and committed .gitattributes: a hostile one can make even ' \
                  '`git diff` execute arbitrary code on every read-only git call — and with ' \
                  "the sandbox's network shared, exfiltrate. Default is no."
        )
      )
      trust_store.trust!(filesystem.project_root) if granted
      granted
    end))
# Logged after App.new rewires Pikuri.log_io to the log dialog (with the safety
# block below), never echoed into the conversation pane.
trust_notice =
  if trusted_repo
    'Trusted repo: read-only git (status/diff/log/show/…) auto-approved.'
  elsif confirm_enabled && filesystem.project_root.join('.git').exist?
    'Untrusted repo: every git command will confirm.'
  end

# Build the system prompt: static base + optional project context +
# footer. AGENTS.md wins over CLAUDE.md when both exist. Assembled here (not
# in Code::App) because it reads AGENTS.md/CLAUDE.md off disk and reflects the
# sandbox / writable-paths / yolo posture — all bin-local boot decisions.
system_prompt = Pikuri.prompts(:'coding-system-prompt', :'agent-loop')
md_path = ['AGENTS.md', 'CLAUDE.md'].map { |f| filesystem.project_root.join(f) }.find(&:file?)
system_prompt += "\n\n# Project Context\n\n#{File.read(md_path)}" if md_path
system_prompt += "\n\nToday's date is: #{Time.now.strftime('%Y-%m-%d')}"
system_prompt += "\nProject root: #{filesystem.project_root}"
system_prompt += "\nAdditional writable paths: #{extra_writable.join(', ')}" unless yolo || extra_writable.empty?
system_prompt += if sandbox_enabled
                   "\nScratch space: /tmp — persistent across all bash and tool calls; " \
                     'use for downloads, clones, unpacks. Cleared on exit.'
                 else
                   "\nScratch space: #{filesystem.temp} — persistent across tool calls, " \
                     'cleared on exit. Prefer it over /tmp for downloads, clones, unpacks ' \
                     "(keeps the host's /tmp clean)."
                 end

Tuile::Screen.new
# Install the app's theme pair (built-in accents + pikuri-tui's own
# tool/notice/error/thinking/detail tokens) durably, so OS light/dark
# flips re-pick the legible variant instead of falling back to the
# stock Tuile theme.
Tuile::Screen.instance.theme_def = Shared::AppTheme::THEME_DEF

# Hand off: App owns the whole agent object graph — from config it derives the
# model list, builds the MCP registry, wires the six file/shell tools + the
# task/skill/sub-agent extensions + the confirmer/plan-mode/diff surface, and
# constructs the streaming Pikuri::Agent on the bin-assembled system prompt +
# the passed workspace/sandbox/trust. Tuile::Screen.new has NOT yet entered
# raw mode / the alternate buffer (that is run_event_loop's job), so a raise
# during App.new — e.g. Mcp::Extension's boot-time verify, or a transport
# probe — still reaches a normal terminal; the begin/ensure tears the screen
# down on any escape, construction OR loop, which is why Code::App#run no
# longer closes it itself. The boot diagnostics sit inside the begin so they
# land in the log dialog (App.new has rewired Pikuri.log_io to it by then),
# never in the conversation pane (AGENTS.md).
begin
  app = Code::App.new(
    config: config,
    filesystem: filesystem,
    sandbox: sandbox,
    skill_catalog: skill_catalog,
    command_registry: command_registry,
    system_prompt: system_prompt,
    trusted_repo: trusted_repo
  )

  # Safety-reductions are logged at warn so they stand out among the info noise.
  main_log.warn(chdir_notice) if chdir_notice
  main_log.info("Working in #{app.project_root}")
  main_log.info("Loaded project context from #{md_path}") if md_path
  unless skill_catalog.empty?
    names = skill_catalog.list.map(&:name).sort.join(', ')
    main_log.info("Loaded #{skill_catalog.list.size} skill(s): #{names}")
  end
  unless command_registry.empty?
    names = command_registry.list.map { |cmd| "/#{cmd.name}#{cmd.refused? ? ' (unavailable)' : ''}" }
    main_log.info("Loaded #{command_registry.list.size} command(s): #{names.sort.join(', ')}")
  end
  main_log.info(trust_notice) if trust_notice
  main_log.info(privacy_notice)
  safety = []
  safety << 'Sandbox: DISABLED.' unless sandbox_enabled
  safety << 'Confirmer: AUTO-APPROVE.' unless confirm_enabled
  safety << 'Filesystem: ALLOW_ALL (credential denylist only).' if yolo
  unless safety.empty?
    safety << 'Use only with an outer sandbox (docker / dev-container) or in a throwaway environment.'
    main_log.warn(safety.join(' '))
  end

  app.run
ensure
  Tuile::Screen.close
end
