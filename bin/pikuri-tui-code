#!/usr/bin/env ruby
# frozen_string_literal: true

# Entry point for the Tuile coding TUI built on Pikuri::Agent — the
# in-repo coding agent. Same shape as bin/pikuri-tui-chat, but wired with
# the six file/shell tools, a project-rooted workspace, the bubblewrap
# sandbox, and a Tuile modal confirmer instead of the stdin one. The
# pikuri-side wiring is ported from pikuri's own bin/pikuri-code demo;
# everything Tuile is PikuriTui::Code::App's job.
#
# Pin Bundler to this project's Gemfile so locked dependency versions win
# and the script works when invoked via a symlink (e.g.
# ~/.local/bin/pikuri-tui-code) from any working directory. `__dir__`
# resolves through symlinks, so this points at the real checkout.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)

# Activate :default + :code — the coding shell needs the heavier pikuri
# gems (workspace/code/tasks/skills/mcp/subagents) that the chat shell
# does not. The explicit +Bundler.setup+ form (not +require
# 'bundler/setup'+, which activates every group) keeps the :test group
# off this process's load path.
require 'bundler'
Bundler.setup(:default, :code)
require 'optparse'

# pikuri-tui has no published gemspec yet — wired only as a path
# dependency from this Gemfile — so its +lib/+ is not on Bundler's load
# path. Adding it here lets +require 'pikuri_tui'+ resolve through
# Zeitwerk. The :code gems are required BEFORE pikuri_tui so its loader
# sees the :code runtime and eager-loads the PikuriTui::Code subtree (see
# lib/pikuri_tui.rb).
$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'pikuri-core'
require 'pikuri-pdf'
require 'pikuri-workspace'
require 'pikuri-code'
require 'pikuri-tasks'
require 'pikuri-skills'
require 'pikuri-mcp'
require 'pikuri-subagents'
require 'pikuri_tui'

# CLI overrides start nil ("flag not given") so PikuriTui::Config can tell
# an explicit flag from an absent one. The sandbox/confirm flags only ever
# force false (there is no --sandbox / --confirm); config sets the baseline.
# Built-in defaults live in PikuriTui::Config, shown in --help.
yolo = false
extra_readable = []
extra_writable = []
cli_sandbox = nil
cli_confirm = nil
cli_server  = nil
cli_model   = nil

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: pikuri-tui-code [options]'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--no-sandbox', 'Disable the bubblewrap sandbox around bash commands.') { cli_sandbox = false }
  # Expanded eagerly (the handler runs at parse!, before the chdir to the
  # discovered project root below) so relative paths and ~ resolve
  # against where the user launched, not where the project lives.
  opts.on('--readable PATH', 'Additional read-only directory (repeatable).') do |v|
    extra_readable << File.expand_path(v)
  end
  opts.on('--writable PATH', 'Additional read+write directory (repeatable).') do |v|
    extra_writable << File.expand_path(v)
  end
  opts.on('--no-confirm', 'Auto-approve every confirmation (skip the y/n popup for writes + bash).') { cli_confirm = false }
  opts.on('--yolo', 'Combines --no-sandbox + --no-confirm + opens the filesystem ' \
                    '(credential denylist only). Use only inside a container.') do
    cli_sandbox = false
    cli_confirm = false
    yolo = true
  end
  opts.on('--server URL', "LLM server base URL (default: #{PikuriTui::Config::DEFAULT_SERVER})") { |v| cli_server = v }
  opts.on('--model NAME', "Model identifier (default: #{PikuriTui::Config::DEFAULT_MODEL})") { |v| cli_model = v }
  opts.on('-h', '--help', 'Print this help and exit') do
    puts opts
    exit
  end
end

begin
  parser.parse!
rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
  warn e.message
  warn parser
  exit 2
end

# Fail fast with a readable message — Filesystem.new realpath's its
# readable:/writable: entries and a missing one raises a bare
# Errno::ENOENT much later, mid-construction. This is boot-time, before
# the screen is up, so a plain warn + exit is correct.
(extra_readable + extra_writable).each do |path|
  next if File.directory?(path)

  warn "no such directory: #{path}"
  exit 2
end

# Climb from the launch directory to the project root (a VCS marker:
# .git / .hg / .svn), and chdir the whole process to it so the file
# tools, Bash, Grep, Glob all operate against one anchor — see
# Pikuri::Workspace::ProjectRoot. Falls back to the launch dir.
launch_cwd   = Pathname.new(Dir.pwd)
project_root = Pikuri::Workspace::ProjectRoot.find(cwd: launch_cwd) || launch_cwd
chdir_notice = ("Changing working directory to project root: #{project_root}" if Dir.pwd != project_root.to_s)
Dir.chdir(project_root.to_s) if chdir_notice

# Load the layered config (XDG search path only — there is no project-local
# layer, so a secret-bearing config can never sit inside the repo the agent
# reads). CLI flags overlay it; the sandbox/confirm flags force false. No
# --api-key flag: a key must never travel on the command line. Boot-time,
# before the screen is up, so a bad file is a plain warn + exit rather than a
# torn-down TUI.
begin
  config = PikuriTui::Config.load(
    overrides: { server: cli_server, model: cli_model, sandbox: cli_sandbox, confirm: cli_confirm }
  )
rescue PikuriTui::Config::Error => e
  warn "config error: #{e.message}"
  exit 2
end

sandbox_enabled = config.sandbox
confirm_enabled = config.confirm
# The first connection is the one both shells use for now (the TUI will
# switch between PikuriTui::Config#llms by name later).
llm = config.primary_llm

# Skill catalog: project root + Dir.home as search bases (project beats
# global). Catalog roots are folded into the workspace's readable set so
# the skill tool's sidecar +read+ flow works.
skill_catalog = Pikuri::Skill::Catalog::Bundled.new(
  search_bases: [project_root, Dir.home]
)

# Workspace: project_root is the writable ceiling, the bind root, the
# relative-path base. temp: true mints an ephemeral writable scratch dir.
# --yolo swaps in AllowAll (everything but the credential denylist).
workspace = if yolo
              warn '--readable/--writable ignored under --yolo (filesystem is ALLOW_ALL).' \
                unless extra_readable.empty? && extra_writable.empty?
              Pikuri::Workspace::Filesystem::AllowAll.new(
                project_root:      project_root,
                temp:              true,
                alias_tmp_to_temp: sandbox_enabled
              )
            else
              Pikuri::Workspace::Filesystem.new(
                project_root:      project_root,
                readable:          Pikuri::Code::ToolchainPaths.readable +
                                   skill_catalog.roots +
                                   extra_readable,
                writable:          extra_writable,
                temp:              true,
                alias_tmp_to_temp: sandbox_enabled
              )
            end

# Bubblewrap sandbox wraps every Bash subprocess. Probes `bwrap` at
# construction and raises if it isn't installed / the kernel lacks
# user-namespace support — fail-loud. Boot-time, before the screen is up,
# so the raise prints a backtrace to a normal terminal. Disable with
# --no-sandbox / --yolo.
sandbox = if sandbox_enabled
            Pikuri::Code::Bash::Sandbox::Bubblewrap.new(
              workspace:         workspace
            )
          else
            Pikuri::Code::Bash::Sandbox::NONE
          end

# Build the system prompt: static base + optional project context +
# footer. AGENTS.md wins over CLAUDE.md when both exist.
system_prompt = Pikuri.prompt(:'coding-system-prompt')
md_path = ['AGENTS.md', 'CLAUDE.md'].map { |f| workspace.project_root.join(f) }.find(&:file?)
system_prompt += "\n\n# Project Context\n\n#{File.read(md_path)}" if md_path
system_prompt += "\n\nCurrent date: #{Time.now.strftime('%Y-%m-%d')}"
system_prompt += "\nProject root: #{workspace.project_root}"
unless yolo || extra_writable.empty?
  system_prompt += "\nAdditional writable paths: #{extra_writable.join(', ')}"
end
system_prompt += if sandbox_enabled
                   "\nScratch space: /tmp — persistent across all bash and tool calls; " \
                     'use for downloads, clones, unpacks. Cleared on exit.'
                 else
                   "\nScratch space: #{workspace.temp} — persistent across tool calls, " \
                     'cleared on exit. Prefer it over /tmp for downloads, clones, unpacks ' \
                     "(keeps the host's /tmp clean)."
                 end

# Build a Pikuri::Agent::ChatTransport from one config connection. The
# api_base / api_key travel *on the transport* (not just RubyLLM's global
# config) so the Ctrl+P picker can switch the live agent to a model on a
# different server — pikuri maps them onto a per-chat RubyLLM::Context.
# The key is read straight from the config file — never from the
# environment, which the sandboxed bash tool and every stdio MCP server
# would inherit — and a connection that omits it falls back to
# "not-needed" (fine for a local llama.cpp).
def transport_for(llm)
  key = llm.api_key
  key = 'not-needed' if key.nil? || key.strip.empty?
  Pikuri::Agent::ChatTransport.new(
    model: llm.model,
    provider: :openai,
    assume_model_exists: true,
    api_base: "#{llm.server.chomp('/')}/v1",
    api_key: key
  )
end

# All configured connections become picker entries (ModelChoice); the
# first is the boot model. The transport carries its own connection, so
# the context-window probe and a Ctrl+P switch both target the right
# server.
models = config.llms.map { |c| PikuriTui::ModelChoice.new(name: c.name, transport: transport_for(c)) }

Pikuri::Extractors::PDF.register

# Still set the global config: it supplies RubyLLM's default model and the
# fallback connection for any code path that builds a chat without an
# explicit per-transport base.
RubyLLM.configure do |c|
  c.openai_api_base = "#{llm.server.chomp('/')}/v1"
  c.openai_api_key  = models.first.transport.api_key
end

cancel_flag = Pikuri::Agent::Control::Cancellable.new

# Mid-loop input channel: PikuriTui::Code::App injects messages submitted
# while a turn is in flight; the agent drains the queue at every
# after_tool_result boundary, and App delivers any leftovers as a fresh
# turn when the loop ends.
interloper = Pikuri::Agent::Control::Interloper.new

# MCP servers available to the assistant, declared in [[code.mcp]]. Empty
# by default — the coding shell behaves identically with no MCP wiring
# until a config entry is added. (Empty registry ⇒ Mcp::Extension's
# boot-time synthesize/verify LLM calls are no-ops, so Agent construction
# stays offline.) The translation from PikuriTui::Config's Pikuri-free
# McpServer value objects into Registry entries lives here, in the wiring
# layer where Pikuri::* references are allowed (see Config's class header).
mcp_entries = config.mcp.map do |m|
  if m.stdio?
    Pikuri::Mcp::Registry::StdioEntry.new(id: m.id, command: m.command, env: m.env)
  else
    Pikuri::Mcp::Registry::HttpEntry.new(id: m.id, url: m.url, headers: m.headers)
  end
end
mcp_registry = Pikuri::Mcp::Registry.new(entries: mcp_entries)

Tuile::Screen.new
# Install the app's theme pair (built-in accents + pikuri-tui's own
# tool/notice/error/thinking/detail tokens) durably, so OS light/dark
# flips re-pick the legible variant instead of falling back to the
# stock Tuile theme.
Tuile::Screen.instance.theme_def = PikuriTui::AppTheme::THEME_DEF

# Constructed up front so both the App (for the footer's status line) and
# the Agent's ListenerList see the same TokenLog instance.
token_log = Pikuri::Agent::Listener::TokenLog.new

# Per-tool diff formatters for the conversation pane: the edit / write
# ToolCall renders as a before/after diff (the write side reads the
# existing file through the same workspace the Write tool uses) instead of
# an argument dump, and the paired ToolResult is suppressed on success /
# surfaced on error. See PikuriTui::Code::TuileListener#tool_formatters.
tool_formatters = {
  'edit'  => PikuriTui::Code::EditFormatter.new,
  'write' => PikuriTui::Code::WriteFormatter.new(workspace: workspace)
}

app = PikuriTui::Code::App.new(
  token_log: token_log,
  project_root: workspace.project_root,
  tool_formatters: tool_formatters,
  models: models
) do |listener, confirmer_popup, task_listener, model_listener|
  # The Tuile modal confirmer for writes + bash, unless confirmations are
  # disabled (--no-confirm / --yolo), in which case approve everything.
  confirmer = confirm_enabled ? confirmer_popup : Pikuri::Workspace::Confirmer::AUTO_APPROVE

  # Coalesce streaming delta chunks at 15 fps before they reach the
  # Markdown-rendering TuileListener (see bin/pikuri-tui-chat for the
  # rationale). flush_pending_on_non_delta: false because the bookend
  # Assistant / Thinking events re-render the authoritative final content.
  rate_limited_listener = Pikuri::Agent::Listener::RateLimited.new(
    listener,
    fps: 15,
    flush_pending_on_non_delta: false
  )

  Pikuri::Agent.new(
    transport: models.first.transport,
    system_prompt: system_prompt,
    # Default :raise policy, deliberately NOT :synthesize — a coding turn
    # ends in a changed working tree, not an answer. On exhaustion the
    # turn stops; the chat history survives and "continue" just works.
    step_limit: Pikuri::Agent::Control::StepLimit.new(max: 40),
    cancellable: cancel_flag,
    interloper: interloper,
    streaming: true
  ) do |c|
    c.add_listener rate_limited_listener
    c.add_listener token_log
    # Renders the Pikuri::Tasks::Extension list into the sidebar task
    # pane. Not rate-limited — task mutations are rare and each snapshot
    # is authoritative.
    c.add_listener task_listener
    # Keeps the footer's model name in step with Ctrl+P switches.
    c.add_listener model_listener
    # File/shell tools first (declaration order biases some models toward
    # earlier tools); calculator last as auxiliary. Network tools go on
    # the sub-agent-only pool so untrusted web content lands in a child
    # context with no file read/write/bash to hijack — see pikuri's
    # SECURITY.md "capability boundaries via sub-agents".
    c.add_tool Pikuri::Workspace::Read.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Grep.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Glob.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Edit.new(workspace: workspace)
    c.add_tool Pikuri::Workspace::Write.new(workspace: workspace, confirmer: confirmer)
    c.add_tool Pikuri::Code::Bash.new(workspace: workspace, confirmer: confirmer, sandbox: sandbox)
    c.add_tool Pikuri::Tool::CALCULATOR
    c.add_sub_agent_tool Pikuri::Tool::WebSearch.build(brave_key: config.search.brave_key,
                                                       exa_key: config.search.exa_key)
    c.add_sub_agent_tool Pikuri::Tool::WEB_SCRAPE
    c.add_sub_agent_tool Pikuri::Tool::FETCH
    c.add_sub_agent_tool Pikuri::Code::GitClone.new(workspace: workspace)
    c.add_extension Pikuri::Skill::Extension.new(catalog: skill_catalog)
    c.add_extension Pikuri::Tasks::Extension.new
    c.add_extension Pikuri::Mcp::Extension.new(
      registry: mcp_registry,
      synthesize_descriptions: true,
      verify_mcp_servers: true
    )
    # Privilege-separated read-only sub-agents: FILE_MINER (read/grep/glob)
    # for code/fs lookups, RESEARCHER (web_search/scrape/fetch) for
    # external docs, GIT_REPO_RESEARCHER for cloning + mining other repos.
    c.add_extension Pikuri::SubAgent::Extension.new(
      personas: [
        Pikuri::SubAgent::FILE_MINER,
        Pikuri::SubAgent::RESEARCHER,
        Pikuri::Code::GIT_REPO_RESEARCHER
      ]
    )
  end
end

# Boot diagnostics into the LogWindow (App.new has wired Tuile.logger to
# it by now). The conversation pane is not a log sink (AGENTS.md), so
# project-root / skill / safety notices go to the diagnostic pane the
# user opens with Ctrl+L. Safety-reductions are logged at warn so they
# stand out among the info noise.
Tuile.logger.warn(chdir_notice) if chdir_notice
Tuile.logger.info("Working in #{workspace.project_root}")
Tuile.logger.info("Loaded project context from #{md_path}") if md_path
unless skill_catalog.empty?
  names = skill_catalog.list.map(&:name).sort.join(', ')
  Tuile.logger.info("Loaded #{skill_catalog.list.size} skill(s): #{names}")
end
# Config-load advisories (e.g. a config file holding a literal api_key with
# loose permissions).
config.warnings.each { |w| Tuile.logger.warn(w) }
safety = []
safety << 'Sandbox: DISABLED.' unless sandbox_enabled
safety << 'Confirmer: AUTO-APPROVE.' unless confirm_enabled
safety << 'Filesystem: ALLOW_ALL (credential denylist only).' if yolo
unless safety.empty?
  safety << 'Use only with an outer sandbox (docker / dev-container) or in a throwaway environment.'
  Tuile.logger.warn(safety.join(' '))
end

app.run
